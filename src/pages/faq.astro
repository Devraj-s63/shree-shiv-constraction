---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';

const faqs = [
  {
    id: 'tmt-price',
    category: 'Price of TMT Sariya',
    question: 'What is the current price of TMT sariya per ton or quintal in Bhilwara?',
    answer: 'TMT sariya prices in Bhilwara fluctuate daily based on raw material ingot indices and factory rolling rates. Call us directly at 8278643303 or WhatsApp your required bar diameters to receive today’s live, transparent per-quintal and per-ton quotation with computerized weighbridge billing and GST invoice.',
  },
  {
    id: 'delivery-areas',
    category: 'Delivery & Logistics',
    question: 'Do you deliver TMT bars and building materials directly to construction sites in Bhilwara?',
    answer: 'Yes, we provide site delivery across Bhilwara city and surrounding areas including Suwana, Mandal, Sanganer, and Hamirgarh. We arrange prompt mini-truck or tractor-trolley transport straight from our 200 Feet Road yard to your construction plot, ensuring safe offloading right at your site.',
  },
  {
    id: 'delivery-timing',
    category: 'Delivery & Logistics',
    question: 'How quickly can an order of TMT sariya be delivered after placing it?',
    answer: 'Same-day delivery is available for standard in-stock bar diameters and regular quantities placed before noon. For full commercial truckloads or specialized rebar schedules, dispatch typically completes within 24 hours from our Bhilwara yard, backed by real-time driver coordination and computerized weighbridge slips.',
  },
  {
    id: 'brands-stocked',
    category: 'Brands & Quality',
    question: 'Which brands and grades of TMT sariya do you sell at your Bhilwara yard?',
    answer: 'We are an authorized stockist of genuine Kay2 Xenox TMT bars along with primary structural steel sariya in Fe 550D and Fe 500 grades. Every bar comes with authentic manufacturer roll marks and test certificates, guaranteeing high ductility, earthquake safety, and superior corrosion resistance.',
  },
  {
    id: 'genuine-brand-check',
    category: 'Brands & Quality',
    question: 'How can I verify that the TMT steel supplied is 100% genuine and not secondary rerolled?',
    answer: 'Every genuine TMT bar features embossed manufacturer roll marks, grade stamps (Fe 550D), and heat numbers directly on the steel surface. Along with delivery, Shree Shiv Construction provides manufacturer mill test certificates and an official GST invoice from our Bhilwara yard, proving verified mill origin and tensile strength.',
  },
  {
    id: 'bulk-orders',
    category: 'Bulk Orders & Commercial',
    question: 'Do you offer discounted pricing on bulk orders for commercial projects or apartments?',
    answer: 'Yes, discounted wholesale rates are provided for multi-ton bulk orders, civil contractors, apartment builders, and factory foundations. We handle bulk logistics with dedicated flatbed trailers and transparent per-metric-ton billing directly from our Bhilwara yard. Contact our desk at 8278643303 to negotiate project-specific volume schedules.',
  },
  {
    id: 'small-orders',
    category: 'Retail & Residential',
    question: 'Can I purchase small bundle quantities for an individual residential house?',
    answer: 'Yes, individual home builders can buy custom retail quantities starting from single bundles or specific quintal weights. We regularly fulfill residential home orders across 8mm, 10mm, 12mm, and 16mm sizes, providing annealed binding wire and precision concrete cover blocks together in a convenient consolidated delivery.',
  },
  {
    id: 'yard-location',
    category: 'Location & Yard',
    question: 'Where is your yard located in Bhilwara, and can I inspect the material before buying?',
    answer: 'Our yard is located on 200 Feet Road, Near Sharda Evergreen, Bhilwara 311001, Rajasthan. Customers and contractors are always welcome to visit during operating hours to inspect bar physical condition, review stock gauges, observe computerized weighbridge operations, and verify our authorized Kay2 Xenox inventory in person.',
  },
  {
    id: 'payment-modes',
    category: 'Payment & Billing',
    question: 'What payment methods do you accept for retail and commercial steel purchases?',
    answer: 'We accept RTGS, NEFT, IMPS bank transfers, UPI payments, and cheque clearance alongside direct bank deposit. All sales are documented through legitimate computerized weighment slips and standard GST tax invoices under our registered entity GSTIN: 08FFXPB0515IZ5, ensuring complete commercial and accounting transparency.',
  },
  {
    id: 'accessories-bundle',
    category: 'Accessories & Supplies',
    question: 'Can I purchase binding wire and cover blocks along with my TMT sariya order?',
    answer: 'Yes, we stock high-tensile annealed binding wire (18 and 20 gauge) and precast high-density concrete cover blocks (20mm to 75mm) at our yard. You can bundle all reinforcement accessories together with your steel order into a single delivery truck, saving transport costs and site delays.',
  },
];

// Google Rich Results Compliant FAQPage Schema JSON-LD
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};
---

<Base
  title="TMT Sariya in Bhilwara FAQs | Prices, Kay2 Xenox & Delivery Questions"
  description="Answers to top questions regarding TMT sariya in Bhilwara, daily per-quintal rates, site delivery, authorized Kay2 Xenox dealership, and bulk order discounts."
  canonicalPath="/faq"
  faqSchema={faqPageSchema}
>
  <!-- Single H1 Page Header -->
  <header class="bg-canvasMuted text-white hairline-b py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-2 h-2 bg-safety-amber inline-block"></span>
          <span class="micro-label text-steel-gray">
            Buyer Knowledge Base &bull; Bhilwara
          </span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-white leading-tight mb-4">
          TMT Sariya FAQs in Bhilwara
        </h1>
        <p class="font-body text-sm sm:text-base text-steel-gray-light leading-relaxed">
          Direct answers to the most common questions asked by homeowners, civil contractors, and commercial developers purchasing reinforcement steel in Bhilwara.
        </p>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <!-- Quick Topic Badges -->
    <div class="flex flex-wrap gap-2.5 mb-12">
      <Badge variant="amber">Price of TMT Sariya</Badge>
      <Badge variant="steel">Bhilwara Site Delivery</Badge>
      <Badge variant="neutral">Kay2 Xenox Authenticity</Badge>
      <Badge variant="steel">Bulk Contractor Orders</Badge>
      <Badge variant="neutral">200 Feet Rd Location</Badge>
      <Badge variant="amber">Payment &amp; GST Invoicing</Badge>
    </div>

    <!-- 10 Questions Accordions / Structured Blocks -->
    <div class="space-y-6">
      {faqs.map((faq, index) => (
        <article
          id={faq.id}
          class="hairline-all bg-canvasMuted transition-colors hover:border-safety-amber/50 p-6 md:p-8 relative"
        >
          <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
            <span class="font-mono text-xs font-bold text-safety-amber tracking-widest">
              QUESTION {index < 9 ? `0${index + 1}` : index + 1} // {faq.category}
            </span>
            <span class="font-mono text-[10px] text-steel-gray uppercase">
              Bhilwara Yard Standard
            </span>
          </div>

          <h2 class="font-display text-lg sm:text-xl md:text-2xl font-black uppercase tracking-tight text-white mb-4">
            {faq.question}
          </h2>

          <div class="bg-canvasSubtle border-l-2 border-safety-amber p-4 md:p-5 font-body text-sm sm:text-base text-steel-gray-light leading-relaxed">
            <p>{faq.answer}</p>
          </div>

          <div class="mt-5 pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs">
            <span class="font-mono text-steel-gray text-[11px]">
              Need more clarification on this?
            </span>
            <div class="flex items-center gap-3">
              <a
                href={`https://wa.me/918278643303?text=${encodeURIComponent(`Inquiry regarding: ${faq.question}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display font-bold uppercase tracking-wider text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1.5"
                aria-label="Ask our desk on WhatsApp about this question"
              >
                <span>Ask on WhatsApp</span>
                <span>&rarr;</span>
              </a>
              <span class="text-white/20">|</span>
              <a
                href="tel:+918278643303"
                class="font-display font-bold uppercase tracking-wider text-white hover:text-safety-amber"
                aria-label="Call yard desk directly at +91 8278643303"
              >
                Call Desk
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Contact Callout -->
    <div class="mt-16 hairline-all bg-canvasMuted text-white p-8 md:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="font-display text-xl sm:text-2xl font-black uppercase tracking-tight text-white">
          Have a project schedule or specific estimate?
        </h3>
        <p class="font-body text-sm text-steel-gray-light mt-1 max-w-xl">
          Call or WhatsApp us your bar bending schedule (BBS) or material requirements for a custom rate quote.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <Button
          variant="whatsapp"
          href="https://wa.me/918278643303"
          target="_blank"
          ariaLabel="Send project requirements to sales on WhatsApp"
        >
          WhatsApp: +91 8278643303
        </Button>
        <Button
          variant="call-outline"
          href="tel:+918278643303"
          ariaLabel="Call sales desk at +91 8278643303 for a custom estimate"
        >
          Call: +91 8278643303
        </Button>
      </div>
    </div>
  </main>
</Base>
