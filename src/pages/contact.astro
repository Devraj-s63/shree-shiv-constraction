---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';

const openingHours = [
  { days: 'Monday – Saturday', hours: '8:00 AM – 8:00 PM', status: 'Regular Yard & Dispatch Hours' },
  { days: 'Sunday', hours: 'Emergency Dispatch / By Prior Appointment', status: 'On-Call Truck Loading' },
];

const contactLines = [
  {
    type: 'Primary Sales & Rates',
    phone: '+91 8278643303',
    href: 'tel:+918278643303',
    label: '+91 8278643303',
    subtext: 'Daily TMT rates, truckload orders, invoice inquiries',
  },
  {
    type: 'Alternate & Yard Support',
    phone: '+91 9602812764',
    href: 'tel:+919602812764',
    label: '+91 9602812764',
    subtext: 'Logistics tracking, driver coordination, yard loading',
  },
];
---

<Base
  title="Contact Building Material Supplier Bhilwara | Kay2 Xenox Dealer Yard"
  description="Contact Shree Shiv Construction & Steel on 200 Feet Road, Bhilwara. Leading building material supplier and authorized Kay2 Xenox dealer. Request a callback or call 8278643303."
  canonicalPath="/contact"
>
  <!-- Single H1 Page Header in Warm Cream -->
  <header class="bg-cream-warm text-charcoal border-b border-cream-border py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="inline-block px-2.5 py-1 bg-eucalyptus text-cream micro-label font-bold border border-eucalyptus">
            Yard Inquiries &bull; Direct Desk
          </span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-charcoal leading-tight mb-4">
          Contact Kay2 Xenox Dealer in Bhilwara
        </h1>
        <p class="font-body text-sm sm:text-base text-charcoal-muted leading-relaxed">
          Get in touch with our sales and dispatch team for live steel rates, bundle quotations, computerized weighbridge slips, and site delivery scheduling.
        </p>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <!-- Quick Contact Cards -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-16">
      {contactLines.map((line, idx) => (
        <div class="md:col-span-6 border border-cream-border bg-cream-card p-6 md:p-8 flex flex-col justify-between hover:border-camel transition-colors">
          <div>
            <div class="flex justify-between items-center border-b border-cream-border pb-3 mb-4">
              <span class="font-mono text-xs font-bold text-camel tracking-widest">
                LINE 0{idx + 1}
              </span>
              <Badge variant="eucalyptus">{line.type}</Badge>
            </div>
            <a
              href={line.href}
              class="font-display text-2xl md:text-3xl font-black text-charcoal hover:text-camel transition-colors block mb-2"
              aria-label={`Call ${line.type} directly at ${line.label}`}
            >
              {line.label}
            </a>
            <p class="font-body text-xs text-charcoal-muted leading-relaxed mb-6">
              {line.subtext}
            </p>
          </div>
          <div>
            <Button
              variant="call-outline"
              href={line.href}
              class="w-full text-xs"
              ariaLabel={`Call ${line.type} at ${line.label}`}
            >
              Call {line.phone}
            </Button>
          </div>
        </div>
      ))}
    </div>

    <!-- Request a Callback Form Section (Asymmetric Grid) -->
    <section class="border border-cream-border bg-cream-card p-8 md:p-12 mb-16 relative" id="callback-section">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Form Header & Guidance (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          <Badge variant="eucalyptus">Instant Yard Dispatch Response</Badge>
          <h2 class="font-display text-2xl sm:text-3xl font-black uppercase tracking-tight text-charcoal">
            Request a Callback
          </h2>
          <p class="font-body text-sm text-charcoal-muted leading-relaxed">
            Fill out your details below to start a verified WhatsApp callback request directly with our Bhilwara sales desk (<strong class="text-charcoal">+91 8278643303</strong>).
          </p>
          <div class="border-t border-cream-border pt-4 space-y-2 text-xs font-mono text-charcoal-muted">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-camel inline-block"></span>
              <span>10-digit Indian mobile verification</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-camel inline-block"></span>
              <span>Direct prefilled WhatsApp format</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-camel inline-block"></span>
              <span>Zero third-party telemetry data sharing</span>
            </div>
          </div>

          <!-- Note on Rate Limiting & Spam Protection -->
          <div class="mt-6 p-4 bg-cream-warm border border-cream-border text-[11px] font-mono text-charcoal-muted leading-normal">
            <span class="text-charcoal font-bold uppercase block mb-1">Notice on Fair Use:</span>
            Submissions are verified and rate-limited to 1 request every 30 seconds per browser session to prevent automated spam abuse.
          </div>
        </div>

        <!-- Form Fields & Validation (7 cols) -->
        <div class="lg:col-span-7 bg-cream-warm/50 border border-cream-border p-6 md:p-8">
          <form id="callback-form" novalidate class="space-y-6">
            <!-- Honeypot Field for anti-bot spam protection (hidden from humans) -->
            <div class="hidden" aria-hidden="true">
              <label for="company_fax">Leave this field blank</label>
              <input type="text" id="company_fax" name="company_fax" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Name Field -->
            <div>
              <label for="cb-name" class="font-display text-xs uppercase tracking-wider font-bold text-charcoal block mb-1.5">
                Full Name <span class="text-camel">*</span>
              </label>
              <input
                type="text"
                id="cb-name"
                name="name"
                placeholder="e.g. Ramesh Sharma"
                required
                class="w-full bg-cream-card border border-cream-border px-4 py-3 text-sm text-charcoal placeholder-charcoal-muted/60 focus:border-camel focus:outline-none focus:ring-1 focus:ring-camel transition-colors"
              />
              <span id="name-error" class="hidden text-xs font-mono text-rose-600 mt-1 block"></span>
            </div>

            <!-- 10-Digit Phone Field -->
            <div>
              <label for="cb-phone" class="font-display text-xs uppercase tracking-wider font-bold text-charcoal block mb-1.5">
                10-Digit Mobile Number <span class="text-camel">*</span>
              </label>
              <div class="relative flex">
                <span class="inline-flex items-center px-3.5 bg-cream-warm text-charcoal text-xs font-mono font-bold border border-r-0 border-cream-border select-none">
                  +91
                </span>
                <input
                  type="tel"
                  id="cb-phone"
                  name="phone"
                  maxlength="10"
                  placeholder="9876543210"
                  required
                  class="w-full bg-cream-card border border-cream-border px-4 py-3 text-sm font-mono text-charcoal placeholder-charcoal-muted/60 focus:border-camel focus:outline-none focus:ring-1 focus:ring-camel transition-colors"
                />
              </div>
              <span id="phone-error" class="hidden text-xs font-mono text-rose-600 mt-1 block"></span>
            </div>

            <!-- Material Requirement / Message Field -->
            <div>
              <label for="cb-message" class="font-display text-xs uppercase tracking-wider font-bold text-charcoal block mb-1.5">
                Material Requirement / Message <span class="text-camel">*</span>
              </label>
              <textarea
                id="cb-message"
                name="message"
                rows="3"
                placeholder="e.g. Need price for 12mm &amp; 16mm Kay2 Xenox TMT bars (approx 2 tons) + binding wire for house in Bhilwara."
                required
                class="w-full bg-cream-card border border-cream-border px-4 py-3 text-sm text-charcoal placeholder-charcoal-muted/60 focus:border-camel focus:outline-none focus:ring-1 focus:ring-camel transition-colors"
              ></textarea>
              <span id="message-error" class="hidden text-xs font-mono text-rose-600 mt-1 block"></span>
            </div>

            <!-- Form Status / Rate-limit alert -->
            <div id="form-status" class="hidden p-3 font-mono text-xs border"></div>

            <!-- Submit Button (Eucalyptus fill with cream text) -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full inline-flex items-center justify-center font-display uppercase tracking-wider text-xs md:text-sm font-bold px-6 py-4 bg-eucalyptus text-cream hover:bg-eucalyptus-dark transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-eucalyptus"
            >
              <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.16-.175.348-.217.464-.217l.333.006c.107.005.249-.041.389.296.145.348.494 1.202.537 1.29.044.087.073.188.015.304-.058.116-.087.189-.174.29-.087.102-.183.227-.261.305-.088.087-.179.182-.077.357.101.174.45 1.055 1.291 1.803.626.557 1.155.73 1.32.812.165.082.261.07.36-.044.098-.114.421-.49.534-.658.113-.169.227-.142.381-.085.155.057.982.463 1.15.547.168.084.281.127.322.197.042.07.042.408-.102.813z"/>
              </svg>
              <span>Submit &amp; Open WhatsApp Callback</span>
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- Location & Timings Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      <div class="lg:col-span-5 space-y-8">
        <div class="border border-cream-border bg-cream-card p-6 md:p-8">
          <!-- Real Shop Front Photo -->
          <div class="mb-6 overflow-hidden border border-cream-border bg-white p-2 shadow-sm group">
            <div class="relative aspect-[16/10] overflow-hidden bg-cream-warm">
              <img
                src="/images/shop-front.webp"
                srcset="/images/shop-front-600w.webp 600w, /images/shop-front-1000w.webp 1000w, /images/shop-front.webp 1400w"
                sizes="(max-width: 1024px) 100vw, 40vw"
                alt="Shree Shiv Construction & Steel shop front, 200 Feet Road, Bhilwara"
                width="800"
                height="500"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              />
              <div class="absolute top-2 left-2 bg-charcoal text-cream px-2.5 py-0.5 font-mono text-[10px] tracking-widest uppercase font-bold">
                200 Feet Road Storefront
              </div>
            </div>
          </div>

          <SectionHeading
            eyebrow="Physical Location"
            title="Yard &amp; Depot"
            subtitle="Strategically located on 200 Feet Road with wide trailer access and convenient approach from all parts of Bhilwara."
          />

          <address class="not-italic font-body text-charcoal-muted text-sm md:text-base leading-relaxed space-y-1 mb-6">
            <p class="font-bold text-charcoal">Shree Shiv Construction &amp; Steel</p>
            <p>200 Feet Road, Near Sharda Evergreen,</p>
            <p>Bhilwara &ndash; 311001, Rajasthan, India</p>
          </address>

          <div class="space-y-2 font-mono text-xs text-charcoal-muted border-t border-cream-border pt-4">
            <div class="flex justify-between">
              <span>GSTIN:</span>
              <strong class="text-charcoal">08FFXPB0515IZ5</strong>
            </div>
            <div class="flex justify-between">
              <span>Instagram:</span>
              <a href="https://instagram.com/shreeshivconstructionsteel" target="_blank" rel="noopener noreferrer" class="text-camel font-semibold hover:underline">
                @shreeshivconstructionsteel
              </a>
            </div>
          </div>
        </div>

        <div class="border border-cream-border bg-cream-card p-6 md:p-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 bg-eucalyptus inline-block"></span>
            <h3 class="font-display text-xs font-bold uppercase tracking-widest text-charcoal">
              Depot & Yard Operating Hours
            </h3>
          </div>

          <div class="space-y-4">
            {openingHours.map((schedule) => (
              <div class="border-b border-cream-border pb-3">
                <div class="flex justify-between items-baseline mb-1">
                  <span class="font-display text-sm font-bold uppercase text-charcoal">
                    {schedule.days}
                  </span>
                  <span class="font-mono text-xs font-semibold text-camel">
                    {schedule.hours}
                  </span>
                </div>
                <span class="font-body text-xs text-charcoal-muted">
                  {schedule.status}
                </span>
              </div>
            ))}
          </div>

          <p class="font-body text-[11px] text-charcoal-muted mt-4">
            * Note: For bulk site shipments, tractor-trolley loading can be pre-scheduled outside standard yard hours by speaking to our dispatcher.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 border border-cream-border bg-cream-card flex flex-col min-h-[500px]">
        <div class="bg-cream-warm text-charcoal px-4 py-2.5 text-xs font-mono flex items-center justify-between border-b border-cream-border">
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-camel fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            SHREE SHIV CONSTRUCTION &amp; STEEL &bull; 25.3622326, 74.602833
          </span>
          <a
            href="https://maps.app.goo.gl/2RhqprUiib4YRsQ77"
            target="_blank"
            rel="noopener noreferrer"
            class="text-camel hover:underline uppercase text-[10px] tracking-wider font-bold"
          >
            Google Maps &rarr;
          </a>
        </div>

        <!-- Full color map with zero grayscale -->
        <iframe
          title="SHREE SHIV CONSTRUCTION &amp; STEEL Location Map"
          class="w-full flex-grow border-0 transition-opacity duration-200 min-h-[460px]"
          src="https://maps.google.com/maps?q=25.3622326,74.602833&z=17&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </main>

  <!-- Client-side Callback Form Validation & Honeypot Protection -->
  <script>
    const form = document.getElementById('callback-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('cb-name') as HTMLInputElement | null;
    const phoneInput = document.getElementById('cb-phone') as HTMLInputElement | null;
    const messageInput = document.getElementById('cb-message') as HTMLTextAreaElement | null;
    const honeypot = document.getElementById('company_fax') as HTMLInputElement | null;

    const nameError = document.getElementById('name-error');
    const phoneError = document.getElementById('phone-error');
    const messageError = document.getElementById('message-error');
    const formStatus = document.getElementById('form-status');

    let lastSubmissionTime = 0;
    const RATE_LIMIT_MS = 30000; // 30 seconds

    function validatePhone(phone: string): boolean {
      const indianPhoneRegex = /^[6-9]\d{9}$/;
      return indianPhoneRegex.test(phone.trim());
    }

    if (form && nameInput && phoneInput && messageInput) {
      phoneInput.addEventListener('input', () => {
        phoneInput.value = phoneInput.value.replace(/\D/g, '');
        if (phoneError) phoneError.classList.add('hidden');
      });

      nameInput.addEventListener('input', () => {
        if (nameError) nameError.classList.add('hidden');
      });

      messageInput.addEventListener('input', () => {
        if (messageError) messageError.classList.add('hidden');
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // 1. Honeypot check
        if (honeypot && honeypot.value.trim() !== '') {
          return;
        }

        // 2. Rate limit check
        const now = Date.now();
        if (now - lastSubmissionTime < RATE_LIMIT_MS) {
          const remainingSec = Math.ceil((RATE_LIMIT_MS - (now - lastSubmissionTime)) / 1000);
          if (formStatus) {
            formStatus.className = 'p-3 font-mono text-xs border border-camel bg-cream-warm text-charcoal block';
            formStatus.textContent = `Rate limit active: Please wait ${remainingSec} seconds before submitting another request.`;
          }
          return;
        }

        // 3. Validation checks
        let isValid = true;
        const nameVal = nameInput.value.trim();
        const phoneVal = phoneInput.value.trim();
        const messageVal = messageInput.value.trim();

        if (!nameVal) {
          if (nameError) {
            nameError.textContent = 'Please enter your full name.';
            nameError.classList.remove('hidden');
          }
          isValid = false;
        }

        if (!phoneVal) {
          if (phoneError) {
            phoneError.textContent = 'Please enter your 10-digit mobile number.';
            phoneError.classList.remove('hidden');
          }
          isValid = false;
        } else if (!validatePhone(phoneVal)) {
          if (phoneError) {
            phoneError.textContent = 'Please enter a valid 10-digit Indian phone number starting with 6, 7, 8, or 9.';
            phoneError.classList.remove('hidden');
          }
          isValid = false;
        }

        if (!messageVal) {
          if (messageError) {
            messageError.textContent = 'Please specify your material requirement or message.';
            messageError.classList.remove('hidden');
          }
          isValid = false;
        }

        if (!isValid) return;

        lastSubmissionTime = now;

        const prefilledText = [
          `*CALLBACK REQUEST — Shree Shiv Construction & Steel*`,
          `*Name:* ${nameVal}`,
          `*Phone:* +91 ${phoneVal}`,
          `*Requirement:* ${messageVal}`,
          `*Source:* Website Contact Form (Bhilwara)`
        ].join('\n');

        const whatsappUrl = `https://wa.me/918278643303?text=${encodeURIComponent(prefilledText)}`;

        if (formStatus) {
          formStatus.className = 'p-3 font-mono text-xs border border-eucalyptus bg-eucalyptus/10 text-eucalyptus-dark block';
          formStatus.textContent = 'Opening WhatsApp with your prefilled callback details...';
        }

        window.open(whatsappUrl, '_blank');
      });
    }
  </script>
</Base>
