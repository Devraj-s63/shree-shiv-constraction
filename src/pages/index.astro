---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout>
  <main class="min-h-screen border-b border-steelGray/20 p-8 md:p-16">
    <header class="border-b border-steelBlue/30 pb-6 mb-12">
      <div class="text-xs uppercase tracking-widest text-steelGray font-semibold mb-2">
        Bhilwara, Rajasthan
      </div>
      <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight text-steelBlue">
        Shree Shiv Construction &amp; Steel
      </h1>
      <p class="mt-2 text-steelGray text-sm">
        मजबूती की सही पहचान &bull; Building a Stronger Tomorrow
      </p>
    </header>

    <section class="max-w-2xl">
      <p class="text-base text-steelBlue leading-relaxed">
        Project scaffold initialized with Astro, Tailwind CSS, and strict TypeScript.
      </p>
    </section>
  </main>
</BaseLayout>
