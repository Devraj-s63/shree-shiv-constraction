---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout>
  <main class="min-h-screen border-b border-steel-gray/20 p-8 md:p-16">
    <header class="border-b border-steel-blue/30 pb-6 mb-12">
      <div class="text-xs uppercase tracking-widest text-steel-gray font-semibold mb-2">
        Bhilwara, Rajasthan
      </div>
      <h1 class="font-display text-3xl md:text-5xl font-black uppercase tracking-tight text-steel-blue">
        Shree Shiv Construction &amp; Steel
      </h1>
      <p class="mt-2 text-steel-gray text-sm">
        मजबूती की सही पहचान &bull; Building a Stronger Tomorrow
      </p>
    </header>

    <section class="max-w-2xl">
      <div class="inline-block bg-steel-blue text-canvas px-4 py-2 text-xs font-bold uppercase tracking-wider mb-4">
        Design System Ready
      </div>
      <p class="font-body text-base text-steel-blue leading-relaxed">
        Tailwind design system configured with <span class="font-semibold text-steel-blue">steel-blue (#0F2A43)</span>, <span class="font-semibold text-steel-gray">steel-gray</span>, and <span class="font-semibold text-safety-amber">safety-amber</span> accents. Display typography is set to <span class="font-display font-bold">Archivo</span> and body text to <span class="font-body font-medium">Inter</span>.
      </p>
    </section>
  </main>
</BaseLayout>
