---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProductsGrid from '../components/ProductsGrid.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import StatsBand from '../components/StatsBand.astro';
import FaqTeaser from '../components/FaqTeaser.astro';
import LocationSection from '../components/LocationSection.astro';
---

<Base
  title="TMT Sariya in Bhilwara | Shree Shiv Construction & Steel | Kay2 Xenox Dealer"
  description="Buy genuine TMT sariya in Bhilwara from Shree Shiv Construction & Steel. Authorized Kay2 Xenox dealer and leading building material supplier in Bhilwara. Fe 550D stock, binding wire & cover blocks. Call 8278643303."
  canonicalPath="/"
>
  <!-- Full-width Dark Steel-Blue Hero (Contains single H1) -->
  <Hero />

  <!-- Trust Strip: GST Registered • Kay2 Xenox TMT • Bhilwara -->
  <TrustStrip />

  <!-- Core Content Sections -->
  <main class="max-w-7xl mx-auto px-6 md:px-8">
    <!-- Products Grid (5 Cards: Kay2 Xenox TMT Bars, TMT Sariya, Binding Wire, Cover Blocks, Building Materials) -->
    <ProductsGrid />

    <!-- Why Choose Us (4 USPs: High Strength, Long Life, Residential & Commercial, Fair Price + Best Service) -->
    <WhyChooseUs />
  </main>

  <!-- Animated Stats Band with Count-Up Numbers -->
  <StatsBand />

  <!-- Additional Sections: FAQ Teaser & Physical Location -->
  <main class="max-w-7xl mx-auto px-6 md:px-8">
    <!-- FAQ Teaser with Accordions and Link to /faq -->
    <FaqTeaser />

    <!-- Location Section with Address Text + Embedded Google Map -->
    <LocationSection />
  </main>
</Base>
