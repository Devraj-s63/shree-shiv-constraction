---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Base>
  <main class="max-w-7xl mx-auto px-6 md:px-8 py-12 md:py-20">
    <SectionHeading
      eyebrow="Direct Yard &bull; Bhilwara, Rajasthan"
      title="Shree Shiv Construction & Steel"
      subtitle="Authorized stockist of Kay2 Xenox TMT bars, Fe 550D Sariya, binding wire, and precision concrete cover blocks."
    />

    <!-- Badges -->
    <div class="flex flex-wrap gap-3 mb-10">
      <Badge variant="amber">Fe 550D Certified</Badge>
      <Badge variant="steel">Kay2 Xenox Stockist</Badge>
      <Badge variant="neutral">GST: 08FFXPB0515IZ5</Badge>
      <Badge variant="success">Daily Yard Dispatch</Badge>
    </div>

    <!-- Hero Actions -->
    <div class="flex flex-wrap items-center gap-4 mb-16">
      <Button variant="primary" href="#contact">Request Quotation</Button>
      <Button variant="whatsapp" href="https://wa.me/918278643303" target="_blank">
        <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.16-.175.348-.217.464-.217l.333.006c.107.005.249-.041.389.296.145.348.494 1.202.537 1.29.044.087.073.188.015.304-.058.116-.087.189-.174.29-.087.102-.183.227-.261.305-.088.087-.179.182-.077.357.101.174.45 1.055 1.291 1.803.626.557 1.155.73 1.32.812.165.082.261.07.36-.044.098-.114.421-.49.534-.658.113-.169.227-.142.381-.085.155.057.982.463 1.15.547.168.084.281.127.322.197.042.07.042.408-.102.813z"/>
        </svg>
        WhatsApp Order
      </Button>
      <Button variant="call-outline" href="tel:8278643303">Call 8278643303</Button>
      <Button variant="secondary" href="tel:9602812764">Call 9602812764</Button>
    </div>

    <!-- Asymmetric Editorial Layout -->
    <div id="products" class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <Card class="md:col-span-8">
        <span class="text-xs font-display font-bold uppercase tracking-wider text-safety-amber mb-2 block">
          Flagship Product
        </span>
        <h3 class="font-display text-2xl md:text-3xl font-black uppercase tracking-tight text-steel-blue mb-4">
          Kay2 Xenox TMT Steel Bars
        </h3>
        <p class="font-body text-steel-gray text-base leading-relaxed mb-6">
          Advanced Fe 550D technology delivering superior bendability, corrosion resistance, and earthquake resilience. Sourced directly for builders, civil contractors, and home builders in Rajasthan.
        </p>
        <div class="border-t border-steel-gray/20 pt-4 flex flex-wrap gap-4 text-xs font-mono text-steel-gray">
          <span>8mm</span>
          <span>&bull;</span>
          <span>10mm</span>
          <span>&bull;</span>
          <span>12mm</span>
          <span>&bull;</span>
          <span>16mm</span>
          <span>&bull;</span>
          <span>20mm</span>
          <span>&bull;</span>
          <span>25mm</span>
          <span>&bull;</span>
          <span>32mm</span>
        </div>
      </Card>

      <Card variant="canvas" class="md:col-span-4 flex flex-col justify-between">
        <div>
          <span class="text-xs font-display font-bold uppercase tracking-wider text-steel-gray mb-2 block">
            Yard Specs
          </span>
          <h3 class="font-display text-xl font-bold uppercase tracking-tight text-steel-blue mb-3">
            Building Supplies
          </h3>
          <p class="font-body text-steel-gray text-sm leading-relaxed">
            Annealed binding wire coils, high-density concrete cover blocks (for beams, slabs, footings), and foundational hardware.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-steel-gray/20">
          <a href="tel:8278643303" class="font-display text-xs font-bold uppercase text-steel-blue hover:text-safety-amber tracking-wider">
            Inquire for Bundle Pricing &rarr;
          </a>
        </div>
      </Card>
    </div>
  </main>
</Base>
