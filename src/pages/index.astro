---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Base>
  <!-- Full-width Dark Steel-Blue Hero -->
  <Hero />

  <!-- Core Content Sections -->
  <main class="max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <!-- Products Anchor Section -->
    <section id="products" class="mb-20">
      <SectionHeading
        eyebrow="Reinforcement &amp; Structural Steel"
        title="Direct Yard Inventory"
        subtitle="Stocked and dispatched daily from 200 Feet Road, Bhilwara. Transparent pricing on retail and commercial bulk orders."
      />

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <Card class="md:col-span-7">
          <Badge variant="amber" class="mb-3">Flagship Product</Badge>
          <h3 class="font-display text-2xl md:text-3xl font-black uppercase tracking-tight text-steel-blue mb-3">
            Kay2 Xenox TMT Steel Bars
          </h3>
          <p class="font-body text-steel-gray text-base leading-relaxed mb-6">
            Engineered with specialized rib geometry for superior bond strength with concrete. High thermal resistance and verified seismic endurance for all residential houses and commercial frames.
          </p>
          <div class="border-t border-steel-gray/20 pt-4 flex flex-wrap gap-4 text-xs font-mono text-steel-gray">
            <span>8mm</span>
            <span>&bull;</span>
            <span>10mm</span>
            <span>&bull;</span>
            <span>12mm</span>
            <span>&bull;</span>
            <span>16mm</span>
            <span>&bull;</span>
            <span>20mm</span>
            <span>&bull;</span>
            <span>25mm</span>
            <span>&bull;</span>
            <span>32mm</span>
          </div>
        </Card>

        <Card variant="canvas" class="md:col-span-5 flex flex-col justify-between">
          <div>
            <Badge variant="steel" class="mb-3">Structural Accessories</Badge>
            <h3 class="font-display text-xl md:text-2xl font-black uppercase tracking-tight text-steel-blue mb-3">
              Binding Wire &amp; Cover Blocks
            </h3>
            <p class="font-body text-steel-gray text-sm leading-relaxed mb-4">
              Annealed pliable binding wire for rapid rebar tying. High-strength precision concrete cover blocks ensuring code-compliant rebar encasement.
            </p>
          </div>
          <div class="border-t border-steel-gray/20 pt-4">
            <a href="https://wa.me/918278643303?text=Inquiry%20for%20TMT%20and%20Binding%20Wire" target="_blank" class="font-display text-xs font-bold uppercase tracking-wider text-steel-blue hover:text-safety-amber inline-flex items-center gap-2">
              <span>WhatsApp Direct Inquiry</span>
              <span>&rarr;</span>
            </a>
          </div>
        </Card>
      </div>
    </section>

    <!-- Value Propositions (Asymmetric 2-column layout, not 3 cards) -->
    <section class="border-t border-steel-gray/20 pt-16 mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow="Why Contractors Choose Us"
            title="Engineered For Structural Durability"
            subtitle="Supplying proven steel standards to individual house builders, civil contractors, and commercial developers across Bhilwara."
          />
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="border border-steel-gray/30 p-6 bg-canvas">
            <h4 class="font-display text-base font-black uppercase text-steel-blue mb-2">High Strength Fe 550D</h4>
            <p class="font-body text-xs text-steel-gray leading-relaxed">
              Superior load capacity and stress redistribution during seismic events and environmental wear.
            </p>
          </div>
          <div class="border border-steel-gray/30 p-6 bg-canvas">
            <h4 class="font-display text-base font-black uppercase text-steel-blue mb-2">Long Operational Life</h4>
            <p class="font-body text-xs text-steel-gray leading-relaxed">
              Corrosion resistant manufacturing extends the structural lifespan of reinforced foundations.
            </p>
          </div>
          <div class="border border-steel-gray/30 p-6 bg-canvas">
            <h4 class="font-display text-base font-black uppercase text-steel-blue mb-2">Residential &amp; Commercial</h4>
            <p class="font-body text-xs text-steel-gray leading-relaxed">
              Equipped to fulfill small vehicle pickups or full flatbed trailer deliveries on-demand.
            </p>
          </div>
          <div class="border border-steel-gray/30 p-6 bg-canvas">
            <h4 class="font-display text-base font-black uppercase text-steel-blue mb-2">Fair Price &amp; Fast Dispatch</h4>
            <p class="font-body text-xs text-steel-gray leading-relaxed">
              Direct yard pricing without intermediary markups, backed by dependable local logistics.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
