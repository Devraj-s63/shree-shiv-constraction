---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';

const products = [
  {
    id: 'kay2-xenox',
    badge: 'Authorized Stockist',
    badgeVariant: 'amber' as const,
    name: 'Kay2 Xenox TMT Bars',
    subtitle: 'High Ductility Fe 550D Reinforcement Steel',
    overview: 'Kay2 Xenox represents advanced thermo-mechanical bar engineering with specialized rib design. Engineered specifically for high seismic zone compliance, offering exceptional bendability, earthquake protection, and thermal resistance.',
    features: [
      'Certified Fe 550D and Fe 500 grade manufacturing compliance (IS 1786)',
      'Specialized cross-rib geometry delivering up to 200% higher bonding grip with surrounding concrete',
      'High uniform elongation prevents sudden brittle snapping under severe seismic vibrations',
      'Superior corrosion resistance protects against internal chemical oxidation and concrete spalling',
      'Available across full standard diameters: 8mm, 10mm, 12mm, 16mm, 20mm, 25mm, and 32mm',
      'Supplied in 12-meter straight lengths or folded factory bundles with original manufacturer roll marks',
    ],
    whatsappMsg: 'Hello Shree Shiv Construction, I would like to check today’s rate for Kay2 Xenox TMT Bars.',
    // Custom inline SVG: Rebar Section Icon
    iconSvg: `<svg class="w-6 h-6 fill-current text-safety-amber" viewBox="0 0 24 24"><path d="M4 2h4v20H4V2zm12 0h4v20h-4V2zM9 5h6v2H9V5zm0 5h6v2H9v-2zm0 5h6v2H9v-2zm0 5h6v2H9v-2z"/></svg>`,
  },
  {
    id: 'tmt-sariya',
    badge: 'Structural Sariya',
    badgeVariant: 'steel' as const,
    name: 'TMT Sariya (Full Range)',
    subtitle: 'Primary Civil & Structural Reinforcement',
    overview: 'Complete yard stock of primary structural steel sariya for individual residential house construction, multi-story structural columns, beams, lintels, and heavy foundation rafts.',
    features: [
      'Comprehensive gauge inventory stocked ex-yard: 8mm, 10mm, 12mm, 16mm, 20mm, 25mm, 32mm',
      'Strict rolling tolerance and consistent linear weight according to Indian Standard codes',
      'High thermal stability retaining structural strength during high temperature exposure',
      'Flexible procurement: available in custom bundle quantities for home builders or multi-ton truckloads for projects',
      'Prompt computerized weighbridge yard dispatch with transparent weight verification slips',
    ],
    whatsappMsg: 'Hello Shree Shiv Construction, I would like to check today’s rate for TMT Sariya.',
    // Custom inline SVG: Steel Beams Icon
    iconSvg: `<svg class="w-6 h-6 fill-current text-safety-amber" viewBox="0 0 24 24"><path d="M3 4h18v3H3V4zm0 6h18v3H3v-3zm0 6h18v4H3v-4z"/></svg>`,
  },
  {
    id: 'binding-wire',
    badge: 'Reinforcement Fixing',
    badgeVariant: 'neutral' as const,
    name: 'Binding Wire',
    subtitle: 'High Tensile Annealed Industrial Coils',
    overview: 'Manufactured from premium low-carbon steel and thermal annealing processes to deliver supreme pliability for rapid bar bending and cage tying on construction sites.',
    features: [
      'Soft annealed treatment allows effortless manual tying and knotting with standard tying hooks',
      'Consistent tensile strength eliminates accidental wire breakage during aggressive tensioning',
      'Available in 18-gauge and 20-gauge standards suited for light mesh and heavy structural rebar ties',
      'Packaged in clean, easy-to-handle rolls and 25kg / 50kg protective bundle coils',
      'Rust-resistant packaging ensuring maximum workability at the job site',
    ],
    whatsappMsg: 'Hello Shree Shiv Construction, I would like to check today’s rate for Binding Wire.',
    // Custom inline SVG: Wire Spool Icon
    iconSvg: `<svg class="w-6 h-6 fill-current text-safety-amber" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-13c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 7c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>`,
  },
  {
    id: 'cover-blocks',
    badge: 'Precision Spacers',
    badgeVariant: 'steel' as const,
    name: 'Cover Blocks',
    subtitle: 'High-Density Precast Concrete Spacers',
    overview: 'Precision-manufactured concrete cover blocks designed to maintain mandatory structural spacing between reinforcement bars and formwork panels during heavy concrete pouring.',
    features: [
      'High-density concrete composition matching structural concrete strength (M30/M40 grade)',
      'Prevents rebar displacement, shuttering leaks, and premature steel oxidation caused by air/moisture exposure',
      'Available in standard cover depths: 20mm, 25mm, 40mm, 50mm, and 75mm',
      'Dedicated profiles: slab spacers, beam bottom pads, column ring spacers, and heavy footing blocks',
      'Includes embedded tie wires on selected variants for secure fastening to rebar cages',
    ],
    whatsappMsg: 'Hello Shree Shiv Construction, I would like to check today’s rate for Cover Blocks.',
    // Custom inline SVG: Concrete Block Icon
    iconSvg: `<svg class="w-6 h-6 fill-current text-safety-amber" viewBox="0 0 24 24"><path d="M21 16.5l-9 5.2-9-5.2V7.5l9-5.2 9 5.2v9zM12 4.1L4.8 8.3 12 12.4l7.2-4.1L12 4.1zm-8 5.6v7.2l7 4v-7.2l-7-4zm16 7.2v-7.2l-7 4v7.2l7-4z"/></svg>`,
  },
  {
    id: 'building-materials',
    badge: 'Site Essentials',
    badgeVariant: 'neutral' as const,
    name: 'Building Materials',
    subtitle: 'Civil Construction Reinforcement Supplies',
    overview: 'Reliable site-delivery inventory of supplementary building materials and civil construction reinforcement essentials for residential builders, commercial developers, and industrial projects.',
    features: [
      'Structural accessories, dowel bars, reinforcement meshes, and site reinforcement hardware',
      'Immediate yard loading facilities with direct access for heavy commercial vehicles',
      'Competitive transparent pricing for consolidated mixed-material construction orders',
      'Complete invoicing backed by official GST compliance (GSTIN: 08FFXPB0515IZ5)',
      'Dedicated logistics support for jobsites across Bhilwara district and neighboring regions',
    ],
    whatsappMsg: 'Hello Shree Shiv Construction, I would like to check today’s rate for Building Materials.',
    // Custom inline SVG: Building Frame Icon
    iconSvg: `<svg class="w-6 h-6 fill-current text-safety-amber" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h4v4H7V7zm6 0h4v4h-4V7zm-6 6h4v4H7v-4zm6 0h4v4h-4v-4z"/></svg>`,
  },
];
---

<Base
  title="Products & Specifications | Shree Shiv Construction & Steel, Bhilwara"
  description="Explore detailed specifications for Kay2 Xenox TMT bars, TMT Sariya, binding wire, cover blocks, and building materials. Get instant price on WhatsApp via 918278643303."
>
  <!-- Page Header -->
  <header class="bg-steel-blue-dark text-canvas border-b-2 border-safety-amber py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-2 h-2 bg-safety-amber inline-block"></span>
          <span class="font-display text-xs uppercase tracking-widest text-canvas/70 font-bold">
            Bhilwara Yard Inventory
          </span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-canvas leading-tight mb-4">
          Reinforcement Steel &amp; Products
        </h1>
        <p class="font-body text-sm sm:text-base text-canvas/80 leading-relaxed">
          Detailed technical features and specifications for our primary product lines. Inquire directly on WhatsApp for live per-ton and per-bundle rates with instant yard dispatch.
        </p>
      </div>
    </div>
  </header>

  <!-- Detailed Product Sections List -->
  <main class="max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <div class="space-y-16 md:space-y-24">
      {products.map((item, index) => (
        <section
          id={item.id}
          class="border border-steel-gray/30 bg-canvas p-8 md:p-12 relative scroll-mt-28 hover:border-steel-blue transition-colors"
        >
          <!-- Section Header: Identifier & Badge -->
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-steel-gray/20 pb-6 mb-8">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-steel-blue flex items-center justify-center shrink-0">
                <span set:html={item.iconSvg} />
              </div>
              <div>
                <span class="font-mono text-xs font-bold text-safety-amber tracking-widest block">
                  PRODUCT 0{index + 1}
                </span>
                <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-steel-blue mt-0.5">
                  {item.name}
                </h2>
              </div>
            </div>

            <Badge variant={item.badgeVariant}>{item.badge}</Badge>
          </div>

          <!-- Editorial Grid: Overview + Features + WhatsApp Button -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            <!-- Left Column: Overview & CTAs (5 cols) -->
            <div class="lg:col-span-5 flex flex-col justify-between h-full">
              <div>
                <h3 class="font-display text-base font-bold uppercase tracking-wider text-steel-blue mb-3">
                  {item.subtitle}
                </h3>
                <p class="font-body text-sm md:text-base text-steel-gray leading-relaxed mb-8">
                  {item.overview}
                </p>
              </div>

              <!-- Action Area: WhatsApp CTA linking to wa.me/918278643303 -->
              <div class="pt-6 border-t border-steel-gray/20 space-y-3">
                <Button
                  variant="whatsapp"
                  href={`https://wa.me/918278643303?text=${encodeURIComponent(item.whatsappMsg)}`}
                  target="_blank"
                  class="w-full text-xs md:text-sm py-3.5"
                  ariaLabel={`Get price on WhatsApp for ${item.name}`}
                >
                  <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.16-.175.348-.217.464-.217l.333.006c.107.005.249-.041.389.296.145.348.494 1.202.537 1.29.044.087.073.188.015.304-.058.116-.087.189-.174.29-.087.102-.183.227-.261.305-.088.087-.179.182-.077.357.101.174.45 1.055 1.291 1.803.626.557 1.155.73 1.32.812.165.082.261.07.36-.044.098-.114.421-.49.534-.658.113-.169.227-.142.381-.085.155.057.982.463 1.15.547.168.084.281.127.322.197.042.07.042.408-.102.813z"/>
                  </svg>
                  Get price on WhatsApp
                </Button>

                <Button
                  variant="call-outline"
                  href="tel:8278643303"
                  class="w-full text-xs py-3"
                >
                  Direct Call: 8278643303
                </Button>
              </div>
            </div>

            <!-- Right Column: Features List (7 cols) -->
            <div class="lg:col-span-7 bg-canvasMuted border border-steel-gray/20 p-6 md:p-8">
              <div class="flex items-center justify-between border-b border-steel-gray/20 pb-3 mb-6">
                <h4 class="font-display text-xs font-bold uppercase tracking-wider text-steel-blue">
                  Verified Technical Features &amp; Stock Standards
                </h4>
                <span class="font-mono text-[10px] text-steel-gray">Yard Verified</span>
              </div>

              <ul class="space-y-4">
                {item.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <span class="w-2 h-2 bg-safety-amber inline-block shrink-0 mt-1.5"></span>
                    <span class="font-body text-xs sm:text-sm text-steel-blue leading-relaxed font-medium">
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-8 pt-4 border-t border-steel-gray/20 flex flex-wrap justify-between items-center text-[11px] font-mono text-steel-gray gap-2">
                <span>Location: 200 Feet Road, Bhilwara</span>
                <span class="text-steel-blue font-semibold">Immediate Loading Ready</span>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>
</Base>
