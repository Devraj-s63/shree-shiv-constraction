---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';

const productList = [
  {
    id: 'kay2-xenox',
    name: 'Kay2 Xenox TMT Bars',
    category: 'Authorized Distributor Stock',
    grade: 'Fe 550D / Fe 500',
    description: 'Advanced technology TMT bars manufactured with unique rib pattern providing 200% higher bond strength with concrete. High thermal resistance, superior ductility, and proven seismic resistance.',
    specs: [
      { label: 'Available Sizes', value: '8mm, 10mm, 12mm, 16mm, 20mm, 25mm, 32mm' },
      { label: 'Standard Length', value: '12 Meters / Bend & Straight Bundles' },
      { label: 'Compliance', value: 'IS 1786 Certified Fe 550D' },
      { label: 'Key Feature', value: 'High Ductility & Anti-Corrosive Ribs' },
    ],
  },
  {
    id: 'tmt-sariya',
    name: 'TMT Sariya (Full Range)',
    category: 'Primary Reinforcement Steel',
    grade: 'Structural Grade Reinforcement',
    description: 'Complete stock of primary structural steel bars for residential foundations, columns, beams, and commercial slab reinforcement. Clean mill finish with minimal rolling tolerance.',
    specs: [
      { label: 'Gauge Inventory', value: '8mm to 32mm Available Ex-Stock' },
      { label: 'Supply Modes', value: 'Retail Bundles & Full Commercial Truckloads' },
      { label: 'Weighment', value: 'Standard Computerized Weighbridge Yard Dispatch' },
      { label: 'Applications', value: 'Lintels, Footings, Slabs, Retaining Structures' },
    ],
  },
  {
    id: 'binding-wire',
    name: 'Annealed Binding Wire',
    category: 'Reinforcement Fixing Supply',
    grade: 'High Tensile Annealed GI / Black',
    description: 'Soft annealed industrial binding wire designed for tying reinforcement rebar meshes with high speed. Flexible and bend-tolerant without premature snapping during knot tensioning.',
    specs: [
      { label: 'Wire Gauge', value: '18 Gauge & 20 Gauge Standard' },
      { label: 'Packaging', value: 'Rolls & 25kg / 50kg Bundles' },
      { label: 'Finish', value: 'Rust Preventive Treated / Annealed Pliable' },
      { label: 'Usage', value: 'Rebar Cage Tying, Mesh Securing' },
    ],
  },
  {
    id: 'cover-blocks',
    name: 'Precision Concrete Cover Blocks',
    category: 'Structural Concrete Spacers',
    grade: 'M30 / M40 High Density Concrete',
    description: 'Precast engineered concrete cover blocks ensuring precise clearance between reinforcement bars and formwork. Essential to prevent moisture ingress, rebar oxidation, and spalling.',
    specs: [
      { label: 'Cover Sizes', value: '20mm, 25mm, 40mm, 50mm, 75mm' },
      { label: 'Types', value: 'Slab Spacers, Beam Bottoms, Column Spacers, Footing Pads' },
      { label: 'Composition', value: 'High-Density Cementitious Mix with Wire Fasteners' },
      { label: 'Advantage', value: 'Uniform Concrete Bonding without Separation' },
    ],
  },
  {
    id: 'building-materials',
    name: 'Structural Building Materials',
    category: 'Site Reinforcement Essentials',
    grade: 'Commercial Construction Grade',
    description: 'Supplemental reinforcement accessories and structural supplies for residential contractors, commercial builders, and industrial foundation contractors across Bhilwara.',
    specs: [
      { label: 'Product Range', value: 'Anchor Accessories, Dowel Bars, Mesh Supplies' },
      { label: 'Service', value: 'Prompt Yard Loading & Jobsite Vehicle Logistics' },
      { label: 'Invoicing', value: 'Official GST Invoice Included' },
      { label: 'Yard Support', value: 'Technical Guidance on Bar Bending Schedule Needs' },
    ],
  },
];
---

<Base
  title="Products & Specifications | Shree Shiv Construction & Steel, Bhilwara"
  description="Explore our full inventory of Kay2 Xenox TMT bars, Fe 550D Sariya, binding wire, concrete cover blocks, and building materials in Bhilwara. Call 8278643303."
>
  <main class="max-w-7xl mx-auto px-6 md:px-8 py-12 md:py-20">
    <SectionHeading
      eyebrow="Material Catalog &bull; Bhilwara Yard"
      title="Reinforcement Steel &amp; Building Supplies"
      subtitle="Complete technical specifications for our direct-stock product catalog. All materials stored, tested, and dispatched directly from 200 Feet Road, Bhilwara."
    />

    <div class="space-y-12">
      {productList.map((product) => (
        <article id={product.id} class="border border-steel-gray/30 bg-canvas p-8 md:p-10 relative">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-steel-gray/20 pb-4 mb-6">
            <div>
              <span class="text-xs font-display font-bold uppercase tracking-widest text-safety-amber block">
                {product.category}
              </span>
              <h2 class="text-2xl md:text-3xl font-display font-black uppercase text-steel-blue mt-1">
                {product.name}
              </h2>
            </div>
            <Badge variant="steel">{product.grade}</Badge>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="lg:col-span-6">
              <p class="font-body text-sm md:text-base text-steel-gray leading-relaxed mb-6">
                {product.description}
              </p>

              <div class="flex flex-wrap items-center gap-3">
                <Button
                  variant="whatsapp"
                  href={`https://wa.me/918278643303?text=Inquiry%20for%20${encodeURIComponent(product.name)}`}
                  target="_blank"
                  class="text-xs"
                >
                  WhatsApp Quote
                </Button>
                <Button variant="call-outline" href="tel:8278643303" class="text-xs">
                  Call for Price
                </Button>
              </div>
            </div>

            <div class="lg:col-span-6 bg-canvasMuted border border-steel-gray/20 p-6">
              <h3 class="font-display text-xs font-bold uppercase tracking-wider text-steel-blue mb-4">
                Technical Specifications &amp; Stock Details
              </h3>
              <dl class="space-y-3 font-mono text-xs">
                {product.specs.map((spec) => (
                  <div class="flex flex-col sm:flex-row sm:justify-between border-b border-steel-gray/10 pb-2">
                    <dt class="text-steel-gray font-body font-semibold">{spec.label}:</dt>
                    <dd class="text-steel-blue sm:text-right font-medium">{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Base>
