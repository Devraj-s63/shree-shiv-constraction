---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
---

<Base
  title="404 — Page Not Found | Shree Shiv Construction & Steel, Bhilwara"
  description="The requested page could not be found. Return to Shree Shiv Construction & Steel homepage or explore our TMT steel products catalog."
  canonicalPath="/404"
>
  <main class="min-h-[70vh] flex items-center justify-center py-20 px-6 md:px-8">
    <div class="max-w-2xl w-full hairline-all bg-canvasMuted p-8 md:p-14 text-center relative">
      <!-- Badge & Error Code -->
      <div class="inline-flex items-center gap-2 mb-4">
        <Badge variant="amber">Error 404 // Dimension Not Found</Badge>
      </div>

      <h1 class="font-display text-6xl sm:text-7xl md:text-8xl font-black uppercase tracking-tight text-white leading-none mb-4">
        404
      </h1>

      <h2 class="font-display text-xl sm:text-2xl font-black uppercase tracking-tight text-safety-amber mb-4">
        Structural Reference Missing
      </h2>

      <p class="font-body text-sm sm:text-base text-steel-gray-light leading-relaxed max-w-md mx-auto mb-8">
        The link or specification page you were looking for does not exist or may have been relocated in our inventory ledger.
      </p>

      <!-- Industrial Navigation Backlinks (Home and Products) -->
      <div class="flex flex-wrap items-center justify-center gap-4 border-t border-white/10 pt-8">
        <Button variant="primary" href="/" class="text-xs md:text-sm px-6 py-3.5">
          Return to Home
        </Button>
        <Button variant="call-outline" href="/products" class="text-xs md:text-sm px-6 py-3.5">
          Explore Products Catalog
        </Button>
      </div>

      <!-- Quick Yard Assistance -->
      <div class="mt-8 pt-4 border-t border-white/10 text-xs font-mono text-steel-gray">
        Need assistance? Call our Bhilwara yard directly: <a href="tel:8278643303" class="text-white font-bold hover:text-safety-amber">+91 8278643303</a>
      </div>
    </div>
  </main>
</Base>
