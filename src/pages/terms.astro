---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Badge from '../components/Badge.astro';

// Editable business details placeholders
const businessMeta = {
  name: 'Shree Shiv Construction & Steel',
  proprietor: 'Chandraprakash Bairwa',
  address: '200 Feet Road, Near Sharda Evergreen, Bhilwara 311001, Rajasthan, India',
  phone1: '+91 8278643303',
  phone2: '+91 9602812764',
  gstin: '08FFXPB0515IZ5',
  lastUpdated: 'October 2026',
};
---

<Base
  title="Terms & Conditions | Shree Shiv Construction & Steel, Bhilwara"
  description="Terms and conditions for material inquiries, yard weighment, pricing, and site delivery with Shree Shiv Construction & Steel in Bhilwara, Rajasthan."
  canonicalPath="/terms"
>
  <header class="bg-canvasMuted text-white hairline-b py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <Badge variant="amber" class="mb-3">Commercial Terms</Badge>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-white leading-tight mb-2">
          Terms &amp; Conditions
        </h1>
        <p class="font-mono text-xs text-steel-gray">
          Last Updated: {businessMeta.lastUpdated} &bull; Jurisdiction: Bhilwara Courts Only
        </p>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <div class="hairline-all bg-canvasMuted p-8 md:p-12 space-y-10 font-body text-sm md:text-base text-steel-gray-light leading-relaxed">
      <!-- Section 1 -->
      <section>
        <h2 class="font-display text-lg md:text-xl font-bold uppercase tracking-tight text-white mb-3 pb-2 hairline-b">
          1. Informational Catalog Purpose
        </h2>
        <p>
          This website serves as an informational digital catalog for <strong class="text-white font-semibold">{businessMeta.name}</strong>. Material specifications, brand descriptions (e.g. Kay2 Xenox TMT), standard gauge dimensions (8mm to 32mm), and service overviews are presented to assist homeowners, engineers, and civil contractors in evaluating structural supply options.
        </p>
        <p class="mt-2">
          No commercial binding contract is finalized solely by viewing this website. Final sales agreements are concluded through formal quotation, offline confirmation, and authorized yard invoicing.
        </p>
      </section>

      <!-- Section 2 -->
      <section>
        <h2 class="font-display text-lg md:text-xl font-bold uppercase tracking-tight text-steel-blue mb-3 pb-2 border-b border-steel-gray/20">
          2. Rate Quotes &amp; Market Price Fluctuation
        </h2>
        <p>
          Steel prices (TMT Sariya) are subject to continuous daily fluctuation based on raw ingot indices, factory mill rolling revisions, and regional freight costs. Quotations provided over phone calls or WhatsApp messages are valid strictly for the day or specific agreed time window indicated by our sales desk.
        </p>
      </section>

      <!-- Section 3 -->
      <section>
        <h2 class="font-display text-lg md:text-xl font-bold uppercase tracking-tight text-steel-blue mb-3 pb-2 border-b border-steel-gray/20">
          3. Weighment, Inspection &amp; Billing
        </h2>
        <ul class="list-disc list-inside space-y-2 mt-2 pl-2">
          <li><strong>Computerized Weighbridge:</strong> All full truckloads and bulk consignments are weighed on verified electronic weighbridges. Billing is derived directly from verified tare and gross weighment slips.</li>
          <li><strong>Yard Material Inspection:</strong> Buyers or their assigned site representatives are encouraged to inspect bar markings, physical condition, bundle tags, and diameter gauges at our 200 Feet Road yard prior to transit loading.</li>
          <li><strong>Invoicing:</strong> Every transaction is accompanied by an official GST tax invoice reflecting GSTIN: {businessMeta.gstin}.</li>
        </ul>
      </section>

      <!-- Section 4 -->
      <section>
        <h2 class="font-display text-lg md:text-xl font-bold uppercase tracking-tight text-steel-blue mb-3 pb-2 border-b border-steel-gray/20">
          4. Transportation &amp; Jobsite Delivery
        </h2>
        <p>
          Where jobsite delivery is requested across Bhilwara or neighboring areas, buyers must ensure safe and accessible road clearance for transport vehicles (tractor-trolley or flatbed trucks). Offloading arrangements at the destination plot remain the responsibility of the purchaser unless explicitly negotiated otherwise with our dispatch coordinator.
        </p>
      </section>

      <!-- Section 5 -->
      <section>
        <h2 class="font-display text-lg md:text-xl font-bold uppercase tracking-tight text-steel-blue mb-3 pb-2 border-b border-steel-gray/20">
          5. Payment Terms (No Online Gateway)
        </h2>
        <p>
          <strong class="text-steel-blue font-semibold">We do not accept payments directly through this website.</strong> Permitted payment channels include direct RTGS, NEFT, IMPS bank transfers to our designated business current account, standard verified UPI, certified cheques, or cash payments settled at our yard counter upon material loading.
        </p>
      </section>

      <!-- Section 6 -->
      <section>
        <h2 class="font-display text-lg md:text-xl font-bold uppercase tracking-tight text-steel-blue mb-3 pb-2 border-b border-steel-gray/20">
          6. Jurisdiction &amp; Dispute Resolution
        </h2>
        <p>
          Any disputes, legal inquiries, or contractual claims arising out of material supply or commercial transactions with Shree Shiv Construction &amp; Steel shall be subject exclusively to the competent judicial courts situated in <strong class="text-steel-blue font-semibold">Bhilwara, Rajasthan, India</strong>.
        </p>
      </section>

      <!-- Section 7: Entity Contact Card -->
      <section class="bg-canvasMuted border border-steel-gray/20 p-6">
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-steel-blue mb-3">
          7. Operating Office &amp; Correspondence
        </h2>
        <address class="not-italic font-mono text-xs text-steel-blue space-y-1">
          <p><strong>{businessMeta.name}</strong></p>
          <p>Proprietor: {businessMeta.proprietor}</p>
          <p>Address: {businessMeta.address}</p>
          <p>Contact Desk: {businessMeta.phone1} / {businessMeta.phone2}</p>
          <p>GSTIN: {businessMeta.gstin}</p>
        </address>
      </section>
    </div>
  </main>
</Base>
