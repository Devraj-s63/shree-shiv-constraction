---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shree Shiv Construction & Steel | Bhilwara",
  description = "Authorized stockist of Kay2 Xenox TMT bars, Fe 550D Sariya, binding wire, and structural building materials in Bhilwara, Rajasthan."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400..900;1,400..900&family=Public+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-steelBlue min-h-screen selection:bg-safetyAmber selection:text-white">
    <slot />
  </body>
</html>
