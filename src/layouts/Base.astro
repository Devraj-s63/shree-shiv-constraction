---
import Button from '../components/Button.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  faqSchema?: Record<string, any>;
}

const siteUrl = 'https://shreeshivconstruction.com';

const {
  title = "TMT Sariya in Bhilwara | Shree Shiv Construction & Steel | Kay2 Xenox Dealer",
  description = "Leading TMT sariya in Bhilwara and building material supplier. Authorized Kay2 Xenox dealer in Bhilwara stocking Fe 550D bars, binding wire & cover blocks. Call 8278643303.",
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/og-preview.webp',
  ogType = 'website',
  faqSchema,
} = Astro.props;

// Canonical URL derivation
const canonicalUrl = new URL(canonicalPath, siteUrl).href.replace(/\/$/, '') || siteUrl;
const fullOgImageUrl = new URL(ogImage, siteUrl).href;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: 'About', href: '/about' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];

// Google Rich Results Compliant HardwareStore Schema
const hardwareStoreSchema = {
  "@context": "https://schema.org",
  "@type": "HardwareStore",
  "@id": "https://shreeshivconstruction.com/#store",
  "name": "Shree Shiv Construction & Steel",
  "alternateName": "Shree Shiv Construction",
  "description": "Authorized stockist of Kay2 Xenox TMT bars, Fe 550D reinforcement steel sariya, binding wire, and building materials in Bhilwara, Rajasthan.",
  "url": "https://shreeshivconstruction.com",
  "image": fullOgImageUrl,
  "logo": "https://shreeshivconstruction.com/favicon.svg",
  "telephone": "+91-8278643303",
  "priceRange": "₹₹",
  "currenciesAccepted": "INR",
  "paymentAccepted": "Cash, Credit Card, Bank Transfer, UPI, Cheque",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "200 Feet Road, Near Sharda Evergreen",
    "addressLocality": "Bhilwara",
    "addressRegion": "Rajasthan",
    "postalCode": "311001",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 25.3463,
    "longitude": 74.6364
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],
      "opens": "09:00",
      "closes": "20:00"
    }
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91-8278643303",
      "contactType": "sales",
      "areaServed": "IN",
      "availableLanguage": ["en", "hi"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+91-9602812764",
      "contactType": "customer service",
      "areaServed": "IN",
      "availableLanguage": ["en", "hi"]
    }
  ],
  "sameAs": [
    "https://instagram.com/shreeshivconstructionsteel"
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="TMT sariya in Bhilwara, building material supplier Bhilwara, Kay2 Xenox dealer Bhilwara, TMT bar price Bhilwara, Fe 550D sariya, binding wire Bhilwara, concrete cover blocks Bhilwara" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Shree Shiv Construction & Steel" />
    <meta name="geo.region" content="IN-RJ" />
    <meta name="geo.placename" content="Bhilwara" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content="Shree Shiv Construction & Steel" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImageUrl} />

    <!-- Google Fonts Preconnect & High-Performance Asynchronous Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Google Rich Results Verified: HardwareStore Schema (Present on every page) -->
    <script type="application/ld+json" set:html={JSON.stringify(hardwareStoreSchema)} />

    <!-- Optional FAQPage Schema (when provided) -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-canvas text-steel-blue font-body min-h-screen flex flex-col selection:bg-safety-amber selection:text-white">
    <!-- Top Utility Announcement Bar -->
    <aside class="bg-steel-blue-dark text-canvas/80 text-[11px] font-display uppercase tracking-wider py-1.5 px-4 md:px-8 border-b border-steel-blue">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-safety-amber inline-block"></span>
          <span>Bhilwara, Rajasthan &bull; GSTIN: 08FFXPB0515IZ5</span>
        </div>
        <div class="hidden sm:flex items-center gap-4 text-canvas/70">
          <span>मजबूती की सही पहचान</span>
          <span class="text-steel-gray/60">|</span>
          <a href="tel:8278643303" class="hover:text-canvas transition-colors">Direct Desk: 8278643303</a>
        </div>
      </div>
    </aside>

    <!-- Sticky Industrial Navbar with Smooth Height Shrink Transition -->
    <header class="sticky top-0 z-40 bg-canvas/95 border-b border-steel-gray/30 transition-all duration-200">
      <div id="main-navbar-container" class="max-w-7xl mx-auto px-4 md:px-8 h-20 transition-all duration-200 flex items-center justify-between gap-4">
        <!-- Logo / Brand Identity -->
        <a href="/" class="flex flex-col group focus:outline-none" aria-label="Shree Shiv Construction and Steel Home">
          <span class="font-display font-black text-lg md:text-xl tracking-tight text-steel-blue uppercase leading-none">
            Shree Shiv
          </span>
          <span class="font-display font-bold text-[10px] md:text-xs tracking-widest text-safety-amber uppercase mt-1">
            Construction &amp; Steel
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-8" aria-label="Main Navigation">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="font-display text-xs uppercase tracking-wider font-bold text-steel-gray hover:text-steel-blue border-b-2 border-transparent hover:border-safety-amber py-2 transition-colors duration-150"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Navbar Actions (Call & WhatsApp Buttons) -->
        <div class="flex items-center gap-2 md:gap-3">
          <Button
            variant="call-outline"
            href="tel:8278643303"
            class="hidden sm:inline-flex py-2 px-3 md:px-4 text-[11px] md:text-xs"
            ariaLabel="Call Shree Shiv Construction directly"
          >
            <svg class="w-3.5 h-3.5 mr-1.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            Call
          </Button>

          <Button
            variant="whatsapp"
            href="https://wa.me/918278643303"
            target="_blank"
            class="py-2 px-3 md:px-4 text-[11px] md:text-xs"
            ariaLabel="Chat on WhatsApp with Shree Shiv Construction"
          >
            <svg class="w-3.5 h-3.5 mr-1.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.16-.175.348-.217.464-.217l.333.006c.107.005.249-.041.389.296.145.348.494 1.202.537 1.29.044.087.073.188.015.304-.058.116-.087.189-.174.29-.087.102-.183.227-.261.305-.088.087-.179.182-.077.357.101.174.45 1.055 1.291 1.803.626.557 1.155.73 1.32.812.165.082.261.07.36-.044.098-.114.421-.49.534-.658.113-.169.227-.142.381-.085.155.057.982.463 1.15.547.168.084.281.127.322.197.042.07.042.408-.102.813z"/>
            </svg>
            WhatsApp
          </Button>

          <!-- Mobile Menu Toggle Button -->
          <button
            id="mobile-nav-toggle"
            type="button"
            class="lg:hidden p-2 text-steel-blue border border-steel-gray/30 hover:border-steel-blue focus:outline-none"
            aria-label="Toggle mobile menu"
          >
            <svg id="hamburger-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
            </svg>
            <svg id="close-icon" class="w-5 h-5 fill-current hidden" viewBox="0 0 24 24">
              <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div id="mobile-nav-menu" class="hidden lg:hidden border-t border-steel-gray/20 bg-canvas px-4 py-4 space-y-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block font-display text-sm uppercase tracking-wider font-bold text-steel-gray hover:text-steel-blue py-2 border-b border-steel-gray/10"
          >
            {link.label}
          </a>
        ))}
        <div class="pt-2 flex flex-col gap-2">
          <Button variant="call-outline" href="tel:8278643303" class="w-full text-xs">
            Call Primary: 8278643303
          </Button>
          <Button variant="secondary" href="tel:9602812764" class="w-full text-xs">
            Call Alternate: 9602812764
          </Button>
        </div>
      </div>
    </header>

    <!-- Page Body Slot -->
    <div class="flex-grow">
      <slot />
    </div>

    <!-- Industrial Editorial Footer -->
    <footer class="bg-steel-blue text-canvas border-t-2 border-safety-amber mt-20">
      <div class="max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">
          <!-- Column 1: Identity & Official Tagline (5 cols) -->
          <div class="md:col-span-5">
            <span class="font-display text-xl md:text-2xl font-black uppercase tracking-tight text-canvas block">
              Shree Shiv Construction &amp; Steel
            </span>
            <p class="font-display text-xs uppercase tracking-widest text-safety-amber font-bold mt-1">
              मजबूती की सही पहचान &bull; Building a Stronger Tomorrow
            </p>
            <p class="font-body text-sm text-canvas/70 mt-4 leading-relaxed max-w-md">
              Authorized Kay2 Xenox dealer and primary building material supplier in Bhilwara. Stocking Fe 550D TMT sariya, annealed binding wire, and precision concrete cover blocks for residential and commercial construction across Rajasthan.
            </p>
            <div class="mt-6 inline-block border border-canvas/20 px-3 py-1.5 text-xs font-mono text-canvas/80">
              GSTIN: <strong class="text-canvas font-semibold">08FFXPB0515IZ5</strong>
            </div>
          </div>

          <!-- Column 2: Physical Address & Office (4 cols) -->
          <div class="md:col-span-4">
            <h3 class="font-display text-xs uppercase tracking-widest font-bold text-safety-amber mb-4">
              Registered Location &amp; Yard
            </h3>
            <address class="not-italic text-sm text-canvas/80 leading-relaxed font-body">
              <strong class="text-canvas block mb-1">Shree Shiv Construction &amp; Steel</strong>
              200 Feet Road, Near Sharda Evergreen,<br />
              Bhilwara 311001, Rajasthan, India
            </address>

            <div class="mt-6 space-y-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="text-canvas/50 text-xs uppercase font-display tracking-wider">Phone 1:</span>
                <a href="tel:8278643303" class="text-canvas hover:text-safety-amber font-semibold transition-colors">
                  +91 8278643303
                </a>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-canvas/50 text-xs uppercase font-display tracking-wider">Phone 2:</span>
                <a href="tel:9602812764" class="text-canvas hover:text-safety-amber font-semibold transition-colors">
                  +91 9602812764
                </a>
              </div>
            </div>
          </div>

          <!-- Column 3: Quick Navigation & Social (3 cols) -->
          <div class="md:col-span-3">
            <h3 class="font-display text-xs uppercase tracking-widest font-bold text-safety-amber mb-4">
              Connect &amp; Social
            </h3>
            <ul class="space-y-2.5 text-xs uppercase tracking-wider font-display font-semibold mb-6">
              <li>
                <a
                  href="https://instagram.com/shreeshivconstructionsteel"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-canvas/80 hover:text-safety-amber transition-colors flex items-center gap-2"
                  aria-label="Follow Shree Shiv Construction on Instagram"
                >
                  <svg class="w-4 h-4 fill-current text-safety-amber" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                  <span>@shreeshivconstructionsteel</span>
                </a>
              </li>
              <li>
                <a href="https://wa.me/918278643303" target="_blank" rel="noopener noreferrer" class="text-canvas/80 hover:text-safety-amber transition-colors flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-emerald-400 inline-block"></span>
                  <span>Direct WhatsApp Line</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Bottom Legal / Copyright Bar -->
        <div class="border-t border-canvas/15 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-canvas/60">
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <p>
              &copy; {new Date().getFullYear()} Shree Shiv Construction &amp; Steel. All rights reserved.
            </p>
            <div class="flex items-center gap-2">
              <span class="hidden sm:inline">&bull;</span>
              <a href="/privacy-policy" class="hover:text-canvas transition-colors underline">Privacy Policy</a>
              <span>&bull;</span>
              <a href="/terms" class="hover:text-canvas transition-colors underline">Terms &amp; Conditions</a>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <span>Bhilwara, Rajasthan</span>
            <span>&bull;</span>
            <span>GSTIN: 08FFXPB0515IZ5</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Minimal Cookie Consent Banner with Consent-Gated GA4 Loader -->
    <CookieConsent />

    <!-- Client-side Animation & Nav Controller -->
    <script>
      import { initAnimations } from '../scripts/animations';

      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const mobileNav = document.getElementById('mobile-nav-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (toggleBtn && mobileNav && hamburgerIcon && closeIcon) {
        toggleBtn.addEventListener('click', () => {
          const isExpanded = !mobileNav.classList.contains('hidden');
          if (isExpanded) {
            mobileNav.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          } else {
            mobileNav.classList.remove('hidden');
            hamburgerIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnimations);
      } else {
        initAnimations();
      }
    </script>
  </body>
</html>
