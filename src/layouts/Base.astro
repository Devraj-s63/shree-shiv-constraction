---
import CookieConsent from '../components/CookieConsent.astro';
import BlueprintBackground from '../components/BlueprintBackground.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  faqSchema?: Record<string, any>;
}

const siteUrl = 'https://shree-shiv-constraction.vercel.app';

const {
  title = "TMT Sariya in Bhilwara | Shree Shiv Construction & Steel | Kay2 Xenox Dealer",
  description = "Leading TMT sariya in Bhilwara and building material supplier. Authorized Kay2 Xenox dealer in Bhilwara stocking Fe 550D bars, binding wire & cover blocks. Call 8278643303.",
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/og-preview.webp',
  ogType = 'website',
  faqSchema,
} = Astro.props;

// Canonical URL derivation
const canonicalUrl = new URL(canonicalPath, siteUrl).href.replace(/\/$/, '') || siteUrl;
const fullOgImageUrl = new URL(ogImage, siteUrl).href;

const navLinks = [
  { label: 'PRODUCTS', href: '/products' },
  { label: 'ABOUT', href: '/about' },
  { label: 'FAQ', href: '/faq' },
  { label: 'CONTACT', href: '/contact' },
];

// Current path normalization for active-page nav state
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isLinkActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(target + '/');
};

// Google Rich Results Compliant HardwareStore Schema
const hardwareStoreSchema = {
  "@context": "https://schema.org",
  "@type": "HardwareStore",
  "@id": "https://shree-shiv-constraction.vercel.app/#store",
  "name": "Shree Shiv Construction & Steel",
  "alternateName": "Shree Shiv Construction",
  "description": "Authorized stockist of Kay2 Xenox TMT bars, Fe 550D reinforcement steel sariya, binding wire, and building materials in Bhilwara, Rajasthan.",
  "url": "https://shree-shiv-constraction.vercel.app",
  "image": fullOgImageUrl,
  "logo": "https://shree-shiv-constraction.vercel.app/favicon.svg",
  "telephone": "+91-8278643303",
  "priceRange": "₹₹",
  "currenciesAccepted": "INR",
  "paymentAccepted": "Cash, Credit Card, Bank Transfer, UPI, Cheque",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "200 Feet Road, Near Sharda Evergreen",
    "addressLocality": "Bhilwara",
    "addressRegion": "Rajasthan",
    "postalCode": "311001",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 25.3622326,
    "longitude": 74.602833
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],
      "opens": "08:00",
      "closes": "20:00"
    }
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91-8278643303",
      "contactType": "sales",
      "areaServed": "IN",
      "availableLanguage": ["en", "hi"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+91-9602812764",
      "contactType": "customer service",
      "areaServed": "IN",
      "availableLanguage": ["en", "hi"]
    }
  ],
  "sameAs": [
    "https://instagram.com/shreeshivconstructionsteel"
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="TMT sariya in Bhilwara, building material supplier Bhilwara, Kay2 Xenox dealer Bhilwara, TMT bar price Bhilwara, Fe 550D sariya, binding wire Bhilwara, concrete cover blocks Bhilwara" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Shree Shiv Construction & Steel" />
    <meta name="geo.region" content="IN-RJ" />
    <meta name="geo.placename" content="Bhilwara" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content="Shree Shiv Construction & Steel" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImageUrl} />

    <!-- Google Fonts Preconnect & High-Performance Asynchronous Loading: Fraunces + Rozha One + Public Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Public+Sans:wght@300;400;500;600;700&family=Rozha+One&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Public+Sans:wght@300;400;500;600;700&family=Rozha+One&display=swap"
      />
    </noscript>

    <!-- Google Rich Results Verified: HardwareStore Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(hardwareStoreSchema)} />

    <!-- Optional FAQPage Schema (when provided) -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-cream text-charcoal font-body min-h-screen flex flex-col relative selection:bg-camel selection:text-charcoal">
    
    <!-- Background Technical Blueprint Etchings Concentrated at Edges -->
    <BlueprintBackground />

    <!-- Floating Borderless Nav: SHREE SHIV wordmark left; small-caps links with tiny hollow circles; GET A QUOTE pill button -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-cream/80 backdrop-blur-md transition-all duration-300">
      <div id="main-navbar-container" class="max-w-7xl mx-auto px-6 md:px-10 h-20 sm:h-24 flex items-center justify-between gap-4">
        
        <!-- Left: Wordmark in Fraunces Serif -->
        <a href="/" class="group focus:outline-none" aria-label="Shree Shiv Construction and Steel Home">
          <span class="font-serif font-black text-xl sm:text-2xl tracking-[0.18em] text-charcoal uppercase leading-none group-hover:text-camel transition-colors">
            SHREE SHIV
          </span>
        </a>

        <!-- Center: Links in small caps with tiny hollow-circle markers -->
        <nav class="hidden md:flex items-center gap-7 lg:gap-10" aria-label="Main Navigation">
          {navLinks.map((link) => {
            const active = isLinkActive(link.href);
            return (
              <a
                href={link.href}
                class={`group flex items-center font-mono text-[11px] uppercase tracking-[0.25em] transition-colors py-2 ${
                  active ? 'text-charcoal font-bold' : 'text-charcoal-muted hover:text-charcoal'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                <!-- Tiny hollow-circle marker -->
                <span class={`w-1.5 h-1.5 rounded-full border mr-2 transition-colors ${
                  active ? 'border-camel bg-camel' : 'border-charcoal/40 group-hover:border-camel'
                }`}></span>
                <span>{link.label}</span>
              </a>
            );
          })}
        </nav>

        <!-- Right: Outlined Pill Button for "GET A QUOTE" & Mobile Menu Toggle -->
        <div class="flex items-center gap-3">
          <a
            href="tel:+918278643303"
            class="hidden sm:inline-flex rounded-full border border-camel text-charcoal px-5 py-2 font-mono text-[11px] uppercase tracking-[0.2em] font-bold hover:bg-camel hover:text-charcoal transition-all active:scale-95"
            aria-label="Get a direct quote at +91 8278643303"
          >
            GET A QUOTE
          </a>

          <!-- Mobile Menu Toggle Button -->
          <button
            id="mobile-nav-toggle"
            type="button"
            class="md:hidden p-2 text-charcoal border border-cream-border rounded-full hover:border-camel focus:outline-none"
            aria-label="Toggle mobile menu"
          >
            <svg id="hamburger-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
            </svg>
            <svg id="close-icon" class="w-5 h-5 fill-current hidden" viewBox="0 0 24 24">
              <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div id="mobile-nav-menu" class="hidden md:hidden border-t border-cream-border bg-cream/95 backdrop-blur-md px-6 py-5 space-y-3">
        {navLinks.map((link) => {
          const active = isLinkActive(link.href);
          return (
            <a
              href={link.href}
              class={`flex items-center font-mono text-xs uppercase tracking-[0.22em] py-2 transition-colors ${
                active ? 'text-charcoal font-bold' : 'text-charcoal-muted hover:text-charcoal'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              <span class={`w-1.5 h-1.5 rounded-full border mr-2.5 ${active ? 'border-camel bg-camel' : 'border-charcoal/40'}`}></span>
              {link.label}
            </a>
          );
        })}
        <div class="pt-3 border-t border-cream-border">
          <a
            href="tel:+918278643303"
            class="block text-center rounded-full border border-camel text-charcoal py-2.5 font-mono text-xs uppercase tracking-[0.2em] font-bold hover:bg-camel hover:text-charcoal"
          >
            GET A QUOTE: +91 8278643303
          </a>
        </div>
      </div>
    </header>

    <!-- Page Body Slot -->
    <div class="flex-grow relative z-10 pt-20 sm:pt-24">
      <slot />
    </div>

    <!-- Persistent Bottom-Left WhatsApp Chip with Unread Counter -->
    <a
      href="https://wa.me/918278643303?text=Namaste%2C%20I%20am%20inquiring%20about%20TMT%20steel%20rates%20in%20Bhilwara"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 left-6 z-40 rounded-full bg-cream-card/95 backdrop-blur-md border border-cream-border pl-2.5 pr-4 py-2 shadow-lg flex items-center gap-2.5 hover:border-camel hover:scale-105 active:scale-95 transition-all group"
      aria-label="Chat directly on WhatsApp with Shree Shiv Construction sales desk"
      title="Direct WhatsApp Rate Desk"
    >
      <!-- Unread Counter Badge -->
      <span class="w-5 h-5 rounded-full bg-camel text-charcoal text-[10px] font-mono font-bold flex items-center justify-center shrink-0">
        1
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.18em] font-bold text-charcoal group-hover:text-camel transition-colors">
        WhatsApp Rates
      </span>
    </a>

    <!-- Cookie Consent as a Rounded Pill Bottom-Center -->
    <CookieConsent />

    <!-- Refined Editorial Footer Strip -->
    <footer class="relative z-10 border-t border-cream-border bg-cream py-14 md:py-20 text-charcoal mt-24">
      <div class="max-w-7xl mx-auto px-6 md:px-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 items-start">
          
          <!-- Brand & Origin (5 cols) -->
          <div class="md:col-span-5 space-y-4">
            <span class="font-serif font-black text-xl uppercase tracking-[0.16em] block">
              SHREE SHIV
            </span>
            <p class="font-mono text-xs text-charcoal-muted tracking-widest uppercase">
              YARD NO. 01 &bull; 200 FEET ROAD &bull; BHILWARA 311001
            </p>
            <p class="font-body text-xs text-charcoal-muted max-w-sm leading-relaxed">
              Authorized Kay2 Xenox TMT Fe 550D distributor. Computerized weighbridge dispatch, factory test certificates, and immediate site logistics across Rajasthan.
            </p>
            <div class="font-mono text-[11px] text-charcoal space-y-1 pt-1">
              <div>GSTIN: <strong class="font-bold">08FFXPB0515IZ5</strong></div>
              <div>DIRECT DESK: <a href="tel:+918278643303" class="font-bold hover:text-camel transition-colors">+91 8278643303</a></div>
            </div>
          </div>

          <!-- Quick Navigation in Small Caps (4 cols) -->
          <div class="md:col-span-4 space-y-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-charcoal font-bold block mb-2">
              INDEX
            </span>
            <ul class="space-y-2 font-mono text-xs uppercase tracking-[0.2em] text-charcoal-muted">
              <li>
                <a href="/" class="hover:text-camel transition-colors flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-camel"></span>
                  <span>HOME</span>
                </a>
              </li>
              <li>
                <a href="/products" class="hover:text-camel transition-colors flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-camel"></span>
                  <span>SELECTED STOCK &bull; PRODUCTS</span>
                </a>
              </li>
              <li>
                <a href="/about" class="hover:text-camel transition-colors flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-camel"></span>
                  <span>ABOUT YARD OPERATIONS</span>
                </a>
              </li>
              <li>
                <a href="/faq" class="hover:text-camel transition-colors flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-camel"></span>
                  <span>FAQS &bull; TECHNICAL SPECIFICATIONS</span>
                </a>
              </li>
              <li>
                <a href="/contact" class="hover:text-camel transition-colors flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-camel"></span>
                  <span>CONTACT &bull; DEPOT LOCATION</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Operating Hours & Status (3 cols) -->
          <div class="md:col-span-3 space-y-3 font-mono text-xs">
            <span class="text-[10px] uppercase tracking-[0.25em] text-charcoal font-bold block mb-2">
              DEPOT SCHEDULE
            </span>
            <div class="border-l-2 border-camel pl-3 space-y-1">
              <span class="text-charcoal font-bold block">MON &ndash; SAT</span>
              <span class="text-charcoal-muted">8:00 AM &ndash; 8:00 PM</span>
            </div>
            <p class="text-[11px] text-charcoal-muted pt-2 leading-relaxed">
              Crane loading for trailers, pickups, and tractors. Verified weighbridge receipt with every dispatch.
            </p>
          </div>

        </div>

        <!-- Hairline Bottom Legal Row -->
        <div class="border-t border-cream-border mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 font-mono text-[11px] text-charcoal-muted">
          <p>&copy; {new Date().getFullYear()} SHREE SHIV CONSTRUCTION &amp; STEEL.</p>
          <div class="flex items-center gap-4">
            <a href="/privacy-policy" class="hover:text-charcoal transition-colors">PRIVACY</a>
            <span>&bull;</span>
            <a href="/terms" class="hover:text-charcoal transition-colors">TERMS</a>
            <span>&bull;</span>
            <span>BHILWARA, RAJASTHAN</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Theatrical Interaction Scripts -->
    <script>
      import { initAnimations } from '../scripts/animations';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initAnimations());
      } else {
        initAnimations();
      }

      // Mobile navbar toggle logic
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const mobileMenu = document.getElementById('mobile-nav-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
        toggleBtn.addEventListener('click', () => {
          const isExpanded = !mobileMenu.classList.contains('hidden');
          if (isExpanded) {
            mobileMenu.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
          } else {
            mobileMenu.classList.remove('hidden');
            hamburgerIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
            toggleBtn.setAttribute('aria-expanded', 'true');
          }
        });
      }
    </script>
  </body>
</html>
