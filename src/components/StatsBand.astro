---
const stats = [
  {
    target: 5,
    suffix: '+',
    label: 'Product Categories',
    subtext: 'Kay2 TMT, Sariya, Wire, Blocks, Materials',
  },
  {
    target: 2,
    suffix: '',
    label: 'Direct Phone Lines',
    subtext: '8278643303 & 9602812764 Active',
  },
  {
    target: 100,
    suffix: '%',
    label: 'Genuine Brands',
    subtext: 'Authentic mill-certified steel only',
  },
  {
    target: 550,
    suffix: 'D',
    label: 'Fe Grade Standard',
    subtext: 'Seismic ductility reinforcement stock',
  },
];
---

<section class="bg-canvasMuted text-white hairline-y py-20 md:py-28 relative overflow-hidden motion-reveal-section" id="stats-band">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 divide-y sm:divide-y-0 lg:divide-x divide-white/10">
      {stats.map((stat, index) => (
        <div class={`flex flex-col justify-between pt-8 sm:pt-0 ${index > 0 ? 'lg:pl-10' : ''}`}>
          <div>
            <div class="flex items-baseline gap-1 mb-3">
              <span
                class="font-display text-[clamp(2.5rem,5vw,4.5rem)] font-black text-safety-amber tracking-tighter motion-counter"
                data-target={stat.target}
              >
                0
              </span>
              <span class="font-display text-3xl sm:text-4xl font-black text-safety-amber">
                {stat.suffix}
              </span>
            </div>
            <h3 class="micro-label text-white mb-2">
              {stat.label}
            </h3>
          </div>
          <p class="font-body text-xs text-steel-gray mt-2 leading-relaxed">
            {stat.subtext}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
