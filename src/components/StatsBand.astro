---
const stats = [
  {
    target: 5,
    suffix: '+',
    label: 'Product Categories',
    subtext: 'Kay2 TMT, Sariya, Wire, Blocks, Materials',
  },
  {
    target: 2,
    suffix: '',
    label: 'Direct Phone Lines',
    subtext: '8278643303 & 9602812764 Active',
  },
  {
    target: 100,
    suffix: '%',
    label: 'Genuine Brands',
    subtext: 'Authentic mill-certified steel only',
  },
  {
    target: 550,
    suffix: 'D',
    label: 'Fe Grade Standard',
    subtext: 'Seismic ductility reinforcement stock',
  },
];
---

<section class="bg-charcoal text-cream border-y border-camel/40 py-20 md:py-28 relative overflow-hidden select-none" id="stats-band">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 divide-y sm:divide-y-0 lg:divide-x divide-cream-border/20">
      {stats.map((stat, index) => (
        <div class={`flex flex-col justify-between pt-8 sm:pt-0 ${index > 0 ? 'lg:pl-10' : ''}`}>
          <div>
            <div class="flex items-baseline gap-1 mb-3">
              <span
                class="font-display text-[clamp(2.5rem,5vw,4.5rem)] font-black text-camel tracking-tighter motion-counter"
                data-target={stat.target}
              >
                {stat.target}
              </span>
              <span class="font-display text-3xl sm:text-4xl font-black text-camel">
                {stat.suffix}
              </span>
            </div>
            <h3 class="font-mono text-xs uppercase tracking-widest text-cream font-bold mb-2">
              {stat.label}
            </h3>
          </div>
          <p class="font-body text-xs text-cream/70 mt-2 leading-relaxed">
            {stat.subtext}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
