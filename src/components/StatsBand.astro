---
const stats = [
  {
    target: 5,
    suffix: '+',
    label: 'Product Categories',
    subtext: 'Kay2 TMT, Sariya, Wire, Blocks, Materials',
  },
  {
    target: 2,
    suffix: '',
    label: 'Direct Phone Lines',
    subtext: '8278643303 & 9602812764 Active',
  },
  {
    target: 100,
    suffix: '%',
    label: 'Genuine Brands',
    subtext: 'Authentic mill-certified steel only',
  },
  {
    target: 550,
    suffix: 'D',
    label: 'Fe Grade Standard',
    subtext: 'Seismic ductility reinforcement stock',
  },
];
---

<section class="bg-steel-blue-dark text-canvas border-y-2 border-safety-amber py-14 md:py-20 relative overflow-hidden motion-reveal-section" id="stats-band">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 divide-y sm:divide-y-0 lg:divide-x divide-steel-gray/30">
      {stats.map((stat, index) => (
        <div class={`flex flex-col justify-between pt-6 sm:pt-0 ${index > 0 ? 'lg:pl-8' : ''}`}>
          <div>
            <div class="flex items-baseline gap-1 mb-2">
              <span
                class="font-display text-4xl sm:text-5xl lg:text-6xl font-black text-safety-amber tracking-tight motion-counter"
                data-target={stat.target}
              >
                0
              </span>
              <span class="font-display text-3xl sm:text-4xl lg:text-5xl font-black text-safety-amber">
                {stat.suffix}
              </span>
            </div>
            <h3 class="font-display text-sm md:text-base font-bold uppercase tracking-wider text-canvas mb-1">
              {stat.label}
            </h3>
          </div>
          <p class="font-body text-xs text-canvas/60 mt-2">
            {stat.subtext}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
