---
interface Props {
  variant?: 'default' | 'warm' | 'outline' | 'steel' | 'canvas';
  class?: string;
  id?: string;
}

const {
  variant = 'default',
  class: className = '',
  id,
} = Astro.props;

const baseStyles = 'border p-6 md:p-8 transition-colors duration-150 relative text-charcoal';

const variantStyles: Record<string, string> = {
  // Pure white card with 1px #E7DDCB border
  default: 'bg-cream-card border-cream-border hover:border-camel',
  // Warm cream card with 1px #E7DDCB border
  warm: 'bg-cream-warm border-cream-border hover:border-camel',
  canvas: 'bg-cream-warm border-cream-border hover:border-camel',
  steel: 'bg-cream-card border-cream-border hover:border-camel',
  outline: 'bg-transparent border-cream-border hover:border-camel',
};

const computedClass = `${baseStyles} ${variantStyles[variant] || variantStyles.default} ${className}`;
---

<div class={computedClass} id={id}>
  <slot />
</div>
