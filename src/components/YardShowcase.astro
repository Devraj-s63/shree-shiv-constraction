---
// YardShowcase.astro - Editorial asymmetric photographic showcase of genuine yard & store operations
---

<section class="py-24 md:py-36 hairline-b bg-canvas relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-8 relative z-10">
    
    <!-- Editorial Section Header: Asymmetric left-aligned with industrial spec numbering -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-16 md:mb-20">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 bg-safety-amber inline-block"></span>
          <span class="micro-label text-steel-gray">
            Physical Yard &bull; Direct Operations
          </span>
        </div>
        <h2 class="font-display text-[clamp(2.5rem,6vw,5rem)] font-black uppercase tracking-tight text-white leading-[1.02]">
          Heavy Stock Yard &amp; <br />
          <span class="text-steel-gray">Bhilwara Retail Depot</span>
        </h2>
      </div>

      <div class="lg:col-span-4 lg:text-right font-mono text-xs text-steel-gray">
        <p class="font-bold text-white uppercase tracking-wider">200 Feet Road, Near Sharda Evergreen</p>
        <p class="text-steel-gray/80 mt-1">Bhilwara &bull; Daily Yard Loading &bull; Crane Assisted</p>
      </div>
    </div>

    <!-- Asymmetric Editorial Photography Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Primary Feature: Real Stock Yard Photography (7 cols) -->
      <div class="lg:col-span-7 hairline-all bg-canvasMuted relative overflow-hidden group flex flex-col justify-between">
        <div class="relative overflow-hidden aspect-[16/10] sm:aspect-[16/9] w-full">
          <img
            src="/images/steel-yard-stock.webp"
            alt="Shree Shiv Construction industrial steel yard stock with stacked TMT sariya bundles and overhead crane"
            width="1400"
            height="788"
            loading="lazy"
            class="parallax-img w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03] filter contrast-[1.05]"
          />
          <!-- Industrial corner badge -->
          <div class="absolute top-4 left-4 bg-canvas/90 hairline-all px-3 py-1.5 text-white backdrop-blur-sm">
            <span class="w-2 h-2 bg-safety-amber inline-block mr-1.5"></span>
            <span class="micro-label text-white">Physical Heavy Stock &bull; Bhilwara</span>
          </div>
        </div>

        <div class="p-8 md:p-10 bg-canvasSubtle text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4 hairline-t">
          <div>
            <h3 class="font-display text-xl md:text-2xl font-bold uppercase tracking-tight text-white">
              Overhead Gantry &amp; Trailer Weighbridge
            </h3>
            <p class="font-body text-xs md:text-sm text-steel-gray mt-2 max-w-md">
              Organized bulk rebars stacked on concrete sleepers. Quick loading for commercial trailers, tractors, and pickups.
            </p>
          </div>
          <span class="micro-label text-safety-amber whitespace-nowrap bg-canvas px-3.5 py-2 hairline-all">
            50T CAPACITY
          </span>
        </div>
      </div>

      <!-- Secondary Feature: Storefront & Loading Depot (5 cols) -->
      <div class="lg:col-span-5 hairline-all bg-canvasMuted flex flex-col justify-between">
        <div class="relative overflow-hidden aspect-[4/3] w-full">
          <img
            src="/images/shop-front-depot.webp"
            alt="Shree Shiv Construction and Steel storefront depot in Bhilwara with steel rods and cement bags"
            width="1200"
            height="900"
            loading="lazy"
            class="parallax-img w-full h-full object-cover filter contrast-[1.03]"
          />
          <div class="absolute top-4 left-4 bg-canvas/90 hairline-all px-3 py-1.5 text-white backdrop-blur-sm">
            <span class="micro-label text-white">Depot Counter &bull; Retail Dispatch</span>
          </div>
        </div>

        <div class="p-8 md:p-10 flex flex-col justify-between flex-grow">
          <div>
            <span class="micro-label text-safety-amber block mb-2">
              ESTABLISHED IN RAJASTHAN
            </span>
            <h3 class="font-display text-2xl font-black uppercase tracking-tight text-white mb-3">
              Walk-in Store &amp; Order Desk
            </h3>
            <p class="font-body text-xs md:text-sm text-steel-gray leading-relaxed mb-6">
              Contractors, homebuilders, and fabricators can inspect mill certificates, verify physical rod ribbing, and collect immediate dispatch slips.
            </p>
          </div>

          <!-- Quick Yard Facts with Hairline Divider -->
          <div class="hairline-t pt-6 space-y-3 font-mono text-xs text-white">
            <div class="flex justify-between">
              <span class="text-steel-gray">Dispatch Days:</span>
              <span class="font-bold">Monday &ndash; Saturday</span>
            </div>
            <div class="flex justify-between">
              <span class="text-steel-gray">Computerized Billing:</span>
              <span class="font-bold text-safety-amber">Instant GST Invoice</span>
            </div>
            <div class="flex justify-between">
              <span class="text-steel-gray">Location Anchor:</span>
              <span>Near Sharda Evergreen</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
