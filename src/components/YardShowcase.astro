---
// YardShowcase.astro - Editorial photographic showcase of genuine yard & store operations
---

<section class="py-24 md:py-32 border-b border-cream-border bg-cream relative overflow-hidden snap-section-opener">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    
    <!-- Bold Oversized Section Opener -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-16 md:mb-20">
      <div class="lg:col-span-8">
        <div class="snap-label flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-camel inline-block"></span>
          <span class="inline-block px-2.5 py-1 bg-eucalyptus text-cream font-mono text-[10px] tracking-[0.25em] uppercase font-bold border border-eucalyptus">
            Physical Yard // Direct Operations
          </span>
        </div>
        <h2 class="snap-title font-display text-[clamp(2.5rem,5.5vw,5rem)] font-black uppercase tracking-tight text-charcoal leading-[0.94]">
          Heavy Stock Yard &amp; <br />
          <span class="text-charcoal-muted">Bhilwara Retail Depot</span>
        </h2>
      </div>

      <div class="lg:col-span-4 lg:text-right font-mono text-xs text-charcoal-muted snap-item">
        <p class="font-bold text-charcoal uppercase tracking-wider">200 Feet Road, Near Sharda Evergreen</p>
        <p class="mt-1">Bhilwara &bull; Daily Yard Loading &bull; Crane Assisted</p>
      </div>
    </div>

    <!-- Asymmetric Editorial Photography Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch snap-item">
      
      <!-- Primary Feature: Real Stock Yard Photography (7 cols) -->
      <div class="lg:col-span-7 border border-cream-border bg-cream-card relative overflow-hidden flex flex-col justify-between">
        <div class="relative overflow-hidden aspect-[16/10] sm:aspect-[16/9] w-full bg-cream-warm">
          <img
            src="/images/yard-stock-clean.jpg"
            alt="Shree Shiv Construction industrial steel yard stock with neatly stacked Fe 550D TMT sariya bundles"
            width="1400"
            height="788"
            loading="lazy"
            class="w-full h-full object-cover"
          />
          <div class="absolute top-4 left-4 bg-charcoal text-cream px-3 py-1 font-mono text-[10px] tracking-widest uppercase font-bold">
            <span class="w-1.5 h-1.5 bg-camel inline-block mr-1.5"></span>
            Physical Heavy Stock // Bhilwara
          </div>
        </div>

        <div class="p-8 md:p-10 bg-cream-warm/50 text-charcoal flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-cream-border">
          <div>
            <h3 class="font-display text-xl md:text-2xl font-bold uppercase tracking-tight text-charcoal">
              Organized Stacks &amp; Fast Trailer Dispatch
            </h3>
            <p class="font-body text-xs md:text-sm text-charcoal-muted mt-2 max-w-md">
              Cleanly sorted rebar bundles on concrete sleepers. Quick loading for commercial trailers, tractors, and pickups.
            </p>
          </div>
          <span class="font-mono text-xs text-charcoal font-bold whitespace-nowrap bg-cream-card px-3.5 py-2 border border-cream-border uppercase tracking-widest">
            50T CAPACITY
          </span>
        </div>
      </div>

      <!-- Secondary Feature: Storefront & Loading Depot (5 cols) -->
      <div class="lg:col-span-5 border border-cream-border bg-cream-card flex flex-col justify-between">
        <div class="relative overflow-hidden aspect-[4/3] w-full bg-cream-warm">
          <img
            src="/images/shop-front-depot.webp"
            alt="Shree Shiv Construction and Steel storefront depot in Bhilwara with steel rods and building materials"
            width="1200"
            height="900"
            loading="lazy"
            class="w-full h-full object-cover"
          />
          <div class="absolute top-4 left-4 bg-charcoal text-cream px-3 py-1 font-mono text-[10px] tracking-widest uppercase font-bold">
            Depot Counter // Retail Dispatch
          </div>
        </div>

        <div class="p-8 md:p-10 flex flex-col justify-between flex-grow">
          <div>
            <span class="font-mono text-[10px] tracking-[0.25em] text-camel uppercase font-bold block mb-2">
              ESTABLISHED IN RAJASTHAN
            </span>
            <h3 class="font-display text-2xl font-black uppercase tracking-tight text-charcoal mb-3">
              Walk-in Store &amp; Order Desk
            </h3>
            <p class="font-body text-xs md:text-sm text-charcoal-muted leading-relaxed mb-6">
              Contractors, homebuilders, and fabricators can inspect mill certificates, verify physical rod ribbing, and collect immediate dispatch slips.
            </p>
          </div>

          <!-- Quick Yard Facts with Hairline Divider -->
          <div class="border-t border-cream-border pt-6 space-y-3 font-mono text-xs text-charcoal">
            <div class="flex justify-between">
              <span class="text-charcoal-muted">Dispatch Days:</span>
              <span class="font-bold">Monday &ndash; Saturday</span>
            </div>
            <div class="flex justify-between">
              <span class="text-charcoal-muted">Computerized Billing:</span>
              <span class="font-bold text-camel">Instant GST Invoice</span>
            </div>
            <div class="flex justify-between">
              <span class="text-charcoal-muted">Location Anchor:</span>
              <span>Near Sharda Evergreen</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
