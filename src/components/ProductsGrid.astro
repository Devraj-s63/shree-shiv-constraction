---
import SectionHeading from './SectionHeading.astro';

const products = [
  {
    title: 'Kay2 Xenox TMT Bars',
    description: 'High-ductility Fe 550D reinforcement steel with specialized cross-rib grip for seismic zones.',
    href: '/products#kay2-xenox',
    tag: 'Flagship Bar',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M4 2h4v20H4V2zm12 0h4v20h-4V2zM9 5h6v2H9V5zm0 5h6v2H9v-2zm0 5h6v2H9v-2zm0 5h6v2H9v-2z"/></svg>`,
    colSpan: 'md:col-span-7',
  },
  {
    title: 'TMT Sariya',
    description: 'Comprehensive gauge inventory from 8mm to 32mm for residential frames and commercial slabs.',
    href: '/products#tmt-sariya',
    tag: 'Full Gauge Stock',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M3 4h18v3H3V4zm0 6h18v3H3v-3zm0 6h18v4H3v-4z"/></svg>`,
    colSpan: 'md:col-span-5',
  },
  {
    title: 'Binding Wire',
    description: 'Pliable annealed industrial wire engineered for rapid tying with zero snapping under tension.',
    href: '/products#binding-wire',
    tag: 'Annealed Coils',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-13c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 7c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>`,
    colSpan: 'md:col-span-4',
  },
  {
    title: 'Cover Blocks',
    description: 'Precast high-density concrete spacers maintaining uniform code-compliant cover on slabs and beams.',
    href: '/products#cover-blocks',
    tag: 'Precision Spacers',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M21 16.5l-9 5.2-9-5.2V7.5l9-5.2 9 5.2v9zM12 4.1L4.8 8.3 12 12.4l7.2-4.1L12 4.1zm-8 5.6v7.2l7 4v-7.2l-7-4zm16 7.2v-7.2l-7 4v7.2l7-4z"/></svg>`,
    colSpan: 'md:col-span-4',
  },
  {
    title: 'Building Materials',
    description: 'Structural foundational supplies and reinforcement essentials directly supplied to project sites.',
    href: '/products#building-materials',
    tag: 'Site Essentials',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h4v4H7V7zm6 0h4v4h-4V7zm-6 6h4v4H7v-4zm6 0h4v4h-4v-4z"/></svg>`,
    colSpan: 'md:col-span-4',
  },
];
---

<section id="products-grid" class="py-24 md:py-36 hairline-b motion-reveal-section">
  <SectionHeading
    eyebrow="Reinforcement &amp; Structural Products"
    title="Core Inventory Breakdown"
    subtitle="Engineered steel and structural supplies ready for immediate yard dispatch across Bhilwara and surrounding regions."
  />

  <!-- Asymmetric Editorial Composition (7:5 and 4:4:4 split) -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 motion-stagger-grid">
    {products.map((item) => (
      <div class={`${item.colSpan} motion-stagger-item hairline-all bg-canvasMuted/50 hover:bg-canvasMuted p-8 md:p-10 flex flex-col justify-between transition-all duration-300 group relative`}>
        <div>
          <!-- Card Header: Icon & Micro-label Tag -->
          <div class="flex items-start justify-between gap-4 mb-8">
            <div class="w-12 h-12 bg-canvas text-white flex items-center justify-center shrink-0 hairline-all">
              <span class="text-safety-amber" set:html={item.iconSvg} />
            </div>
            <span class="micro-label px-3 py-1 bg-canvas hairline-all text-safety-amber">
              {item.tag}
            </span>
          </div>

          <!-- Product Title -->
          <h3 class="font-display text-2xl md:text-3xl font-black uppercase tracking-tight text-white mb-4 group-hover:text-safety-amber transition-colors">
            {item.title}
          </h3>

          <!-- One-line Description -->
          <p class="font-body text-sm md:text-base text-steel-gray leading-relaxed mb-8">
            {item.description}
          </p>
        </div>

        <!-- Direct Link to /products with hairline divider -->
        <div class="hairline-t pt-6 flex items-center justify-between">
          <a
            href={item.href}
            class="micro-label text-white hover:text-safety-amber inline-flex items-center gap-2 focus:outline-none focus:underline"
          >
            <span>View Specifications</span>
            <span class="text-safety-amber">&rarr;</span>
          </a>
          <span class="font-mono text-[10px] text-steel-gray/60 tracking-widest uppercase">READY IN YARD</span>
        </div>
      </div>
    ))}
  </div>
</section>
