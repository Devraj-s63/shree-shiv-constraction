---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';

const usps = [
  {
    number: '01',
    title: 'High Strength',
    label: 'Fe 550D Certified',
    description: 'High tensile ductility, seismic endurance, and superior load distribution ensuring structural safety under heavy loads.',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>`,
  },
  {
    number: '02',
    title: 'Long Service Life',
    label: 'Corrosion Resistant',
    description: 'Proper thermo-mechanical treatment prevents rust progression, protecting internal reinforcement steel for decades.',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>`,
  },
  {
    number: '03',
    title: 'Residential & Commercial',
    label: 'All Build Types',
    description: 'Sized and stocked for diverse structural needs, from personal house construction to commercial pillars and foundations.',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/></svg>`,
  },
  {
    number: '04',
    title: 'Fair Price + Honest Service',
    label: 'Computerized Weighment',
    description: 'Direct computerized weighbridge billing without hidden middleman fees, backed by swift yard loading and local truck transport.',
    iconSvg: `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>`,
  },
];
---

<section id="why-choose-us" class="bg-cream py-24 md:py-32 border-b border-cream-border snap-section-opener">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      <div class="lg:col-span-8">
        <SectionHeading
          eyebrow="Direct Yard Standards"
          title="Why Choose Shree Shiv"
          subtitle="Direct mill supply, honest computerized weighing, and fair mandi rates. When you buy steel from our 200 Feet Road yard, you get 100% genuine Kay2 Xenox sariya with a pukka GST bill."
        />
      </div>
      <div class="lg:col-span-4 flex flex-wrap lg:justify-end gap-3 self-center snap-item">
        <Button
          variant="whatsapp"
          href="https://wa.me/918278643303"
          target="_blank"
          class="px-6 py-3.5 font-mono text-xs uppercase tracking-wider font-bold"
          ariaLabel="Send requirements on WhatsApp for instant quote"
        >
          WhatsApp Us
        </Button>
        <Button
          variant="call-outline"
          href="tel:+918278643303"
          class="px-6 py-3.5 font-mono text-xs uppercase tracking-wider font-bold"
          ariaLabel="Call yard desk for direct truckload pricing at +91 8278643303"
        >
          Call +91 8278643303
        </Button>
      </div>
    </div>

    <!-- Editorial 4-Card Balanced Layout (Clean 2x2 Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {usps.map((usp) => (
        <div class="snap-item border border-cream-border bg-white hover:border-camel p-8 md:p-10 flex flex-col justify-between transition-colors duration-200 group relative">
          <div>
            <!-- Top Row: Number & Icon -->
            <div class="flex items-center justify-between border-b border-cream-border pb-6 mb-6">
              <span class="font-mono text-xs text-camel font-bold uppercase tracking-wider">
                {usp.number} // {usp.label}
              </span>
              <div class="w-10 h-10 bg-cream text-charcoal flex items-center justify-center shrink-0 border border-cream-border">
                <span class="text-camel" set:html={usp.iconSvg} />
              </div>
            </div>

            <!-- Title -->
            <h3 class="font-display text-2xl md:text-3xl font-black uppercase tracking-tight text-charcoal mb-4 group-hover:text-camel transition-colors">
              {usp.title}
            </h3>

            <!-- Description -->
            <p class="font-body text-sm md:text-base text-charcoal-muted leading-relaxed mb-6">
              {usp.description}
            </p>
          </div>

          <!-- Footnote Status -->
          <div class="pt-4 border-t border-cream-border flex items-center gap-2 text-[11px] font-mono text-charcoal-muted">
            <span class="w-1.5 h-1.5 bg-eucalyptus inline-block"></span>
            <span class="tracking-widest uppercase font-semibold">VERIFIED YARD STANDARD</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
