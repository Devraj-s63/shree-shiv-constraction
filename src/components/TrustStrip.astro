---
// TrustStrip component - Clean editorial strip highlighting core entity credentials
---

<section class="bg-cream-warm border-b border-cream-border py-6">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-center divide-y md:divide-y-0 md:divide-x divide-cream-border">
      <!-- Item 1: GST Registered -->
      <div class="flex items-center gap-4 pt-3 md:pt-0">
        <div class="w-10 h-10 bg-cream-card text-charcoal flex items-center justify-center shrink-0 border border-cream-border">
          <svg class="w-5 h-5 fill-current text-camel" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
          </svg>
        </div>
        <div>
          <span class="micro-label text-charcoal font-bold block">
            GST Registered Entity
          </span>
          <span class="font-mono text-xs text-charcoal-muted block mt-0.5">
            GSTIN: 08FFXPB0515IZ5
          </span>
        </div>
      </div>

      <!-- Item 2: Kay2 Xenox Authorized -->
      <div class="flex items-center gap-4 pt-4 md:pt-0 md:pl-8">
        <div class="w-10 h-10 bg-cream-card text-charcoal flex items-center justify-center shrink-0 border border-cream-border">
          <svg class="w-5 h-5 fill-current text-camel" viewBox="0 0 24 24">
            <path d="M4 3h16v2H4V3zm2 4h12v2H6V7zm-2 4h16v2H4v-2zm2 4h12v2H6v-2zm-2 4h16v2H4v-2z"/>
          </svg>
        </div>
        <div>
          <span class="micro-label text-charcoal font-bold block">
            Kay2 Xenox TMT
          </span>
          <span class="font-mono text-xs text-charcoal-muted block mt-0.5">
            Authorized Stockist Fe 550D
          </span>
        </div>
      </div>

      <!-- Item 3: Bhilwara Yard Location -->
      <div class="flex items-center gap-4 pt-4 md:pt-0 md:pl-8">
        <div class="w-10 h-10 bg-cream-card text-charcoal flex items-center justify-center shrink-0 border border-cream-border">
          <svg class="w-5 h-5 fill-current text-camel" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </div>
        <div>
          <span class="micro-label text-charcoal font-bold block">
            Bhilwara Yard
          </span>
          <span class="font-mono text-xs text-charcoal-muted block mt-0.5">
            200 Feet Rd, Sharda Evergreen
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
