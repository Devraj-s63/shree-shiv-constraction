---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';

const faqs = [
  {
    question: 'Are you an authorized stockist of Kay2 Xenox TMT bars in Bhilwara?',
    answer: 'Yes, Shree Shiv Construction & Steel is an authorized stockist supplying genuine, mill-certified Kay2 Xenox Fe 550D TMT bars with authentic test certificates and manufacturer roll marks.',
  },
  {
    question: 'What TMT bar sizes and grades do you stock at the yard?',
    answer: 'We stock primary reinforcement steel in sizes 8mm, 10mm, 12mm, 16mm, 20mm, 25mm, and 32mm in Fe 550D and Fe 500 grades, available in standard 12-meter lengths in straight or bend bundles.',
  },
  {
    question: 'Do you supply small residential orders or only large commercial consignments?',
    answer: 'We serve both. Individual home builders can purchase customized bundle quantities, and contractors can order full truckload consignments with computerized weighbridge receipts.',
  },
  {
    question: 'How do I place an order or check today’s steel rate?',
    answer: 'You can directly call our desk at 8278643303 or 9602812764, or send your required material list on WhatsApp for instant rate quotation and dispatch scheduling.',
  },
];
---

<section id="faq-teaser" class="py-24 md:py-36 hairline-b motion-reveal-section">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
    <div class="lg:col-span-8">
      <SectionHeading
        eyebrow="Help &amp; Clarifications"
        title="Frequently Asked Questions"
        subtitle="Common questions about purchasing TMT steel bars, binding wire, delivery logistics, and technical grades at our Bhilwara yard."
      />
    </div>
    <div class="lg:col-span-4 lg:text-right self-center">
      <Button variant="call-outline" href="/faq" class="micro-label px-6 py-3.5 !border-white/20 !text-white hover:!border-safety-amber hover:!text-safety-amber">
        View All Questions &rarr;
      </Button>
    </div>
  </div>

  <!-- 4 Accordions with hairline borders -->
  <div class="space-y-4 max-w-4xl">
    {faqs.map((faq, index) => (
      <details class="group hairline-all bg-canvasMuted transition-colors open:bg-canvasSubtle">
        <summary class="flex justify-between items-center p-6 sm:p-8 cursor-pointer select-none font-display font-bold uppercase tracking-tight text-white text-base md:text-lg list-none focus:outline-none focus:ring-1 focus:ring-safety-amber">
          <span class="flex items-center gap-4">
            <span class="micro-label text-safety-amber">0{index + 1}.</span>
            <span class="group-hover:text-safety-amber transition-colors">{faq.question}</span>
          </span>
          <span class="ml-4 w-7 h-7 bg-canvas text-white flex items-center justify-center shrink-0 hairline-all text-xs transition-transform duration-200 group-open:rotate-45">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
          </span>
        </summary>
        <div class="px-6 sm:px-8 pb-8 pt-2 font-body text-sm md:text-base text-steel-gray leading-relaxed hairline-t">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
