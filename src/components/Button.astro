---
interface Props {
  variant?: 'primary' | 'whatsapp' | 'call-outline' | 'secondary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  id,
  ariaLabel,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-display uppercase tracking-wider text-xs md:text-sm font-bold px-5 py-3 transition-colors duration-150 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-camel focus:ring-offset-2';

const variantStyles: Record<string, string> = {
  // Primary CTA: Camel fill with deep charcoal text (WCAG AA compliant 5.19:1)
  primary: 'bg-camel text-charcoal border border-camel hover:bg-camel-dark hover:border-camel-dark active:bg-camel-dark font-black',
  
  // WhatsApp CTA: Eucalyptus fill with cream text (WCAG AA compliant 6.9:1)
  whatsapp: 'bg-eucalyptus text-cream border border-eucalyptus hover:bg-eucalyptus-dark hover:border-eucalyptus-dark active:bg-eucalyptus-dark',
  
  // Call Outline: Clean border in charcoal/camel with high contrast
  'call-outline': 'bg-transparent text-charcoal border border-charcoal hover:bg-camel hover:border-camel hover:text-charcoal active:bg-camel-dark',
  
  // Secondary: Warm cream card with #E7DDCB border
  secondary: 'bg-cream-card text-charcoal border border-cream-border hover:border-camel hover:text-charcoal active:bg-cream-warm',
};

const computedClass = `${baseStyles} ${variantStyles[variant] || variantStyles.primary} ${className}`;
---

{
  href ? (
    <a
      href={href}
      class={computedClass}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      id={id}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={computedClass}
      id={id}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
