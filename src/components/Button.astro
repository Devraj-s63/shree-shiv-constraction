---
interface Props {
  variant?: 'primary' | 'whatsapp' | 'call-outline' | 'camel-outline' | 'outline' | 'secondary' | 'eucalyptus';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  id,
  ariaLabel,
} = Astro.props;

// Rounded pill design for luxury editorial feel
const baseStyles = 'inline-flex items-center justify-center rounded-full font-mono text-[11px] uppercase tracking-[0.2em] font-bold px-6 py-3 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-camel focus:ring-offset-2';

const variantStyles: Record<string, string> = {
  // Primary CTA: Camel fill with deep charcoal text
  primary: 'bg-camel text-charcoal border border-camel hover:bg-camel-dark hover:border-camel-dark active:bg-camel-dark font-black shadow-sm',
  
  // Camel Outline: Pill with camel border and charcoal text
  'camel-outline': 'bg-transparent text-charcoal border border-camel hover:bg-camel hover:text-charcoal active:bg-camel-dark',
  
  // WhatsApp CTA: Camel fill or outline as requested
  whatsapp: 'bg-camel text-charcoal border border-camel hover:bg-camel-dark hover:border-camel-dark active:bg-camel-dark font-black',
  
  // Call Outline: Charcoal/Camel hairline pill
  'call-outline': 'bg-transparent text-charcoal border border-camel hover:bg-camel hover:text-charcoal active:bg-camel-dark',
  
  // Generic Outline: Border charcoal/40
  outline: 'bg-transparent text-charcoal border border-charcoal/40 hover:border-camel hover:text-charcoal hover:bg-camel/10',
  
  // Secondary: Warm cream pill
  secondary: 'bg-cream-warm text-charcoal border border-cream-border hover:border-camel hover:text-charcoal',

  // Eucalyptus badge/pill
  eucalyptus: 'bg-eucalyptus text-cream border border-eucalyptus hover:bg-eucalyptus-dark',
};

const computedClass = `${baseStyles} ${variantStyles[variant] || variantStyles.primary} ${className}`;
---

{
  href ? (
    <a
      href={href}
      class={computedClass}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      id={id}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={computedClass}
      id={id}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
