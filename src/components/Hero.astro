---
import Button from './Button.astro';
---

<section id="hero-section" class="relative bg-steel-blue-dark text-canvas border-b-2 border-safety-amber overflow-hidden min-h-[640px] lg:min-h-[760px] flex items-center">
  <!-- Full-bleed Cinematic Video Container (Desktop & Tablet: >= 768px, respect reduced motion) -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <!-- Desktop Video: Muted, Autoplay, Loop, Playsinline, Preload metadata with Poster -->
    <video
      id="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-steel-poster.webp"
      class="hero-parallax-bg hidden md:motion-safe:block w-full h-[120%] -top-[10%] absolute object-cover object-center filter brightness-[0.75] contrast-[1.08] will-change-transform"
    >
      <source src="/videos/hero-steel.mp4" type="video/mp4" />
      <source src="/images/3D_animation_of_steel_rebar_20261006174601.mp4" type="video/mp4" />
    </video>

    <!-- Still Poster Fallback: Active for Mobile (< 768px) and prefers-reduced-motion -->
    <picture class="block md:motion-safe:hidden w-full h-full">
      <source srcset="/images/hero-steel-poster.webp" type="image/webp" />
      <img
        src="/images/hero-steel-poster.jpg"
        alt="Shree Shiv TMT steel stock yard"
        width="1920"
        height="1080"
        fetchpriority="high"
        class="w-full h-full object-cover object-center filter brightness-[0.72] contrast-[1.05]"
      />
    </picture>
  </div>

  <!-- Subtle Film-Grain Overlay Texture -->
  <div
    class="absolute inset-0 pointer-events-none z-[1] opacity-35 mix-blend-overlay bg-[url('/images/film-grain.svg')] [background-repeat:repeat]"
    aria-hidden="true"
  >
  </div>

  <!-- Directional Dark Gradient Scrim From the Left (Guarantees 100% WCAG Typography Readability) -->
  <div
    class="absolute inset-0 pointer-events-none z-[2] bg-gradient-to-r from-steel-blue-dark via-steel-blue-dark/95 md:via-steel-blue-dark/85 to-steel-blue-dark/35 lg:to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Top and Bottom Industrial Seam Shadow -->
  <div
    class="absolute inset-0 pointer-events-none z-[2] bg-gradient-to-b from-steel-blue-dark/70 via-transparent to-steel-blue-dark/90"
    aria-hidden="true"
  >
  </div>

  <!-- Hero Editorial Grid (Asymmetric Layout) -->
  <div class="relative max-w-7xl mx-auto px-6 md:px-8 py-16 md:py-24 lg:py-28 z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Oversized Editorial Hindi Typography & CTAs (7 cols) -->
      <div class="lg:col-span-7 motion-hero-entrance">
        <!-- Industrial Tag & Coordinates -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <div class="inline-flex items-center gap-2 bg-steel-blue px-3.5 py-1.5 border border-steel-gray/40">
            <span class="w-2.5 h-2.5 bg-safety-amber inline-block"></span>
            <span class="font-display text-[11px] md:text-xs uppercase tracking-widest text-canvas font-bold">
              Kay2 Xenox &bull; Bhilwara
            </span>
          </div>
          <span class="font-mono text-[11px] text-canvas/60 hidden sm:inline-block">
            200 FT RD &bull; EST. BHILWARA
          </span>
        </div>

        <!-- Oversized Hindi Main Headline with Split-Text Animation Target -->
        <h1
          id="hero-hindi-headline"
          class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[90px] font-black tracking-tighter text-canvas leading-[0.98] uppercase mb-6 drop-shadow-md overflow-hidden"
          aria-label="मजबूती की सही पहचान"
        >
          <span class="split-line block">
            <span class="split-char inline-block">म</span><span class="split-char inline-block">ज</span><span class="split-char inline-block">बू</span><span class="split-char inline-block">ती</span>
          </span>
          <span class="split-line block">
            <span class="split-char inline-block">की</span> <span class="split-char inline-block">स</span><span class="split-char inline-block">ही</span>
          </span>
          <span class="split-line block text-safety-amber drop-shadow-sm">
            <span class="split-char inline-block">प</span><span class="split-char inline-block">ह</span><span class="split-char inline-block">चा</span><span class="split-char inline-block">न</span>
          </span>
        </h1>

        <!-- English Subtitle & Industrial Descriptor -->
        <div class="border-l-2 border-safety-amber pl-4 sm:pl-6 mb-8 max-w-xl">
          <p class="font-body text-base sm:text-lg md:text-xl text-canvas/90 font-normal leading-relaxed">
            High-ductility Fe 550D TMT reinforcement steel, annealed binding wire, and structural building materials delivered direct from our Bhilwara yard.
          </p>
          <div class="font-mono text-xs text-safety-amber/90 mt-2 flex items-center gap-2">
            <span>&bull; Fe 550D Certified</span>
            <span>&bull; Ready Stock 8mm-32mm</span>
            <span>&bull; Mill Test Verified</span>
          </div>
        </div>

        <!-- Direct Action Bar -->
        <div class="flex flex-wrap items-center gap-4">
          <Button
            variant="call-outline"
            href="tel:8278643303"
            class="!text-canvas !border-canvas hover:!bg-canvas hover:!text-steel-blue px-7 py-4 text-xs md:text-sm font-bold tracking-wider uppercase"
            ariaLabel="Call Shree Shiv Construction directly"
          >
            <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            Direct Dispatch: 8278643303
          </Button>

          <Button
            variant="whatsapp"
            href="https://wa.me/918278643303?text=Namaste%2C%20I%20am%20inquiring%20about%20TMT%20Sariya%20prices%20in%20Bhilwara"
            target="_blank"
            class="px-7 py-4 text-xs md:text-sm font-bold tracking-wider uppercase"
            ariaLabel="Chat on WhatsApp with Shree Shiv Construction"
          >
            <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.16-.175.348-.217.464-.217l.333.006c.107.005.249-.041.389.296.145.348.494 1.202.537 1.29.044.087.073.188.015.304-.058.116-.087.189-.174.29-.087.102-.183.227-.261.305-.088.087-.179.182-.077.357.101.174.45 1.055 1.291 1.803.626.557 1.155.73 1.32.812.165.082.261.07.36-.044.098-.114.421-.49.534-.658.113-.169.227-.142.381-.085.155.057.982.463 1.15.547.168.084.281.127.322.197.042.07.042.408-.102.813z"/>
            </svg>
            WhatsApp Rate Sheet
          </Button>
        </div>
      </div>

      <!-- Right Column: Honest Yard Stock Panel (5 cols) -->
      <div class="lg:col-span-5 motion-hero-entrance">
        <div class="relative bg-steel-blue-dark/90 backdrop-blur-md border border-steel-gray/50 overflow-hidden">
          <!-- Corner Safety Amber Accent Notch -->
          <div class="absolute top-0 right-0 w-3 h-3 bg-safety-amber z-10"></div>

          <!-- Real Photo of Actual Steel Stock in Yard -->
          <div class="relative w-full aspect-[16/9] border-b border-steel-gray/40 overflow-hidden">
            <img
              src="/images/steel-yard-stock.webp"
              alt="Heavy TMT steel sariya bundles stacked in Shree Shiv Construction yard"
              width="640"
              height="360"
              loading="eager"
              class="w-full h-full object-cover filter contrast-[1.05]"
            />
            <div class="absolute bottom-2 left-2 bg-steel-blue-dark/90 border border-steel-gray/50 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-canvas backdrop-blur-sm">
              <span class="w-1.5 h-1.5 bg-safety-amber inline-block mr-1"></span>
              200 Ft Rd Yard &bull; Physical Stock
            </div>
          </div>

          <div class="p-5 md:p-6">
            <!-- Honest Header -->
            <div class="border-b border-steel-gray/30 pb-3 mb-4 flex justify-between items-center">
              <div>
                <h2 class="font-display text-sm uppercase tracking-wider text-canvas font-bold block">
                  Yard Steel Stock &amp; Gauges
                </h2>
                <span class="font-mono text-[10px] text-canvas/60">
                  AUTHORISED DEALER &bull; BHILWARA
                </span>
              </div>
              <span class="font-mono text-[11px] text-safety-amber font-bold">
                8mm &ndash; 32mm
              </span>
            </div>

            <!-- Listed Sizes Table -->
            <div class="space-y-2 font-mono text-xs mb-5">
              <div class="flex justify-between items-center border-b border-steel-gray/20 pb-1.5">
                <span class="text-canvas font-semibold font-body">TMT Sariya Sizes</span>
                <span class="text-canvas/90">8mm, 10mm, 12mm, 16mm, 20mm, 25mm, 32mm</span>
              </div>
              <div class="flex justify-between items-center border-b border-steel-gray/20 pb-1.5">
                <span class="text-canvas font-semibold font-body">Primary Brands</span>
                <span class="text-safety-amber font-mono">Kay2 Xenox Fe 550D &amp; ISI</span>
              </div>
              <div class="flex justify-between items-center border-b border-steel-gray/20 pb-1.5">
                <span class="text-canvas font-semibold font-body">Structural Wire</span>
                <span class="text-canvas/90">Annealed Binding Wire Coils</span>
              </div>
              <div class="flex justify-between items-center pb-1">
                <span class="text-canvas font-semibold font-body">Concrete Spacers</span>
                <span class="text-canvas/90">20mm, 25mm, 40mm, 50mm Cover Blocks</span>
              </div>
            </div>

            <!-- Clear Honest Notice: Steel market rates fluctuate daily in Mandi -->
            <div class="bg-steel-blue/70 border border-steel-gray/40 p-3.5 flex items-center justify-between gap-3">
              <div>
                <span class="font-display text-xs uppercase tracking-wider text-safety-amber font-bold block">
                  Call for today's rates
                </span>
                <span class="font-body text-[11px] text-canvas/70 block">
                  Market prices update daily &bull; Direct computerized weighbridge
                </span>
              </div>
              <a
                href="tel:8278643303"
                class="shrink-0 bg-safety-amber text-steel-blue-dark font-display text-xs font-black uppercase tracking-wider px-3.5 py-2 hover:bg-safety-amber-light transition-colors"
                aria-label="Call for today's TMT steel rates"
              >
                8278643303
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
