---
import Button from './Button.astro';
---

<section id="hero-section" class="relative min-h-[85vh] sm:min-h-[90vh] flex flex-col justify-center items-center px-6 md:px-10 py-16 sm:py-24 overflow-hidden select-none">
  
  <!-- Centered Single-Screen Statement Content -->
  <div class="max-w-5xl mx-auto text-center relative z-10 w-full">
    
    <!-- Tiny Tracked Kicker: Small Caps with Wide Tracking -->
    <div class="hero-theatrical-kicker flex items-center justify-center gap-2 mb-6 sm:mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-camel inline-block"></span>
      <span class="font-mono text-[11px] sm:text-xs uppercase tracking-[0.3em] text-charcoal-muted font-bold">
        SHREE SHIV &copy;2026 &mdash; BHILWARA
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-camel inline-block"></span>
    </div>

    <!-- Massive Hindi Serif Display Headline in Rozha One Stacked Over 3 Tight Lines -->
    <h1
      id="hero-hindi-headline"
      lang="hi"
      class="font-hindi text-[clamp(3.8rem,10vw,8.5rem)] font-normal text-charcoal leading-[0.88] uppercase select-none text-center"
      aria-label="मजबूती की सही पहचान"
    >
      <span class="block overflow-hidden py-1">
        <span class="inline-block hero-theatrical-line">मजबूती</span>
      </span>
      <span class="block overflow-hidden py-1">
        <span class="inline-block hero-theatrical-line">की सही</span>
      </span>
      <span class="block overflow-hidden py-1">
        <span class="inline-block hero-theatrical-line text-charcoal relative">
          पहचान
          <!-- Camel Underline Marker -->
          <span class="absolute -bottom-1.5 left-0 w-full h-[4px] md:h-[6px] bg-camel"></span>
        </span>
      </span>
    </h1>

    <!-- Short Sans Sub-Line in Public Sans -->
    <p class="hero-theatrical-sub font-body text-sm sm:text-base md:text-lg text-charcoal-muted max-w-xl mx-auto mt-8 md:mt-10 leading-relaxed font-normal">
      Authorized Kay2 Xenox TMT Fe 550D, annealed binding wire, and certified structural supplies. Dispatched daily from our 200 Feet Road yard.
    </p>

    <!-- Two Pill CTAs Side by Side: "CALL NOW" and "WHATSAPP RATES" -->
    <div class="hero-theatrical-cta flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mt-10 md:mt-12">
      <Button
        variant="primary"
        href="tel:+918278643303"
        class="w-full sm:w-auto px-9 py-4 text-xs font-mono uppercase tracking-[0.22em] font-black shadow-sm"
        ariaLabel="Call dispatch desk directly at +91 8278643303"
      >
        CALL NOW
      </Button>

      <Button
        variant="camel-outline"
        href="https://wa.me/918278643303?text=Namaste%2C%20I%20am%20inquiring%20about%20daily%20TMT%20steel%20rates%20in%20Bhilwara"
        target="_blank"
        class="w-full sm:w-auto px-9 py-4 text-xs font-mono uppercase tracking-[0.22em] font-bold"
        ariaLabel="Request daily TMT steel rate sheet on WhatsApp"
      >
        WHATSAPP RATES
      </Button>
    </div>

    <!-- Small-Caps Micro Blueprint Meta Footer -->
    <div class="hero-theatrical-meta mt-14 sm:mt-18 pt-6 border-t border-cream-border/60 max-w-2xl mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-[10px] tracking-[0.25em] uppercase text-charcoal-muted">
      <span>YARD NO. 01 &bull; 200 FT RD</span>
      <span>MILL CERTIFIED Fe 550D</span>
      <span>COMPUTERIZED KANTA</span>
      <span>PAKKA GST BILL</span>
    </div>

  </div>
</section>
