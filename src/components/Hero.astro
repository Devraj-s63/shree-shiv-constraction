---
import Button from './Button.astro';
---

<section id="hero-section" class="relative bg-cream text-charcoal border-b border-cream-border overflow-hidden py-16 md:py-24 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Oversized Condensed Display Type & Editorial CTAs (7 cols) -->
      <div class="lg:col-span-7 space-y-6 md:space-y-8">
        
        <!-- Tiny Mono Micro-Label Eyebrow -->
        <div class="hero-snap-support flex flex-wrap items-center gap-3">
          <span class="inline-block px-2.5 py-1 bg-eucalyptus text-cream font-mono text-[10px] tracking-[0.2em] uppercase font-bold">
            Authorised Kay2 Xenox Dealer
          </span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-charcoal-muted uppercase font-semibold">
            EST. BHILWARA // 200 FT ROAD DEPOT
          </span>
        </div>

        <!-- Massive Confident Hindi Display Type (Stacked in 3 tight lines, clamp up to 8rem) -->
        <h1
          id="hero-hindi-headline"
          lang="hi"
          class="font-display text-[clamp(3.4rem,8.5vw,8rem)] font-black tracking-tighter text-charcoal leading-[0.88] uppercase select-none"
          aria-label="मजबूती की सही पहचान"
        >
          <span class="block hero-snap-line">मजबूती</span>
          <span class="block hero-snap-line">की सही</span>
          <span class="block hero-snap-line text-charcoal">
            <span class="text-camel underline decoration-camel decoration-[6px] md:decoration-[10px] underline-offset-8">पहचान</span>
          </span>
        </h1>

        <!-- Bold Value Proposition & Specifications -->
        <div class="hero-snap-support border-l-2 border-camel pl-5 sm:pl-6 max-w-xl space-y-4">
          <p class="font-body text-base sm:text-lg text-charcoal-muted leading-relaxed">
            Direct mill supply of certified Kay2 Xenox Fe 550D TMT sariya, annealed binding wire, and high-strength concrete cover blocks from our 200 Feet Road yard in Bhilwara.
          </p>
          <div class="font-mono text-[11px] text-charcoal font-bold tracking-wider uppercase flex flex-wrap items-center gap-x-4 gap-y-1.5">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-camel"></span>
              Fe 550D Mill Certified
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-camel"></span>
              Ready Stock 8mm&ndash;32mm
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-camel"></span>
              Computerized Kanta Slip
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-camel"></span>
              Pakka GST Bill
            </span>
          </div>
        </div>

        <!-- Two Bold Decisive CTAs -->
        <div class="hero-snap-support flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-2">
          <Button
            variant="primary"
            href="tel:+918278643303"
            class="px-7 py-4 text-xs md:text-sm font-bold tracking-wider uppercase"
            ariaLabel="Call direct dispatch desk at +91 8278643303"
          >
            <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            Direct Dispatch: +91 8278643303
          </Button>

          <Button
            variant="whatsapp"
            href="https://wa.me/918278643303?text=Namaste%2C%20I%20am%20inquiring%20about%20TMT%20Sariya%20rates%20in%20Bhilwara"
            target="_blank"
            class="px-7 py-4 text-xs md:text-sm font-bold tracking-wider uppercase"
            ariaLabel="Request daily TMT rate sheet on WhatsApp"
          >
            <svg class="w-4 h-4 mr-2 inline-block fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.16-.175.348-.217.464-.217l.333.006c.107.005.249-.041.389.296.145.348.494 1.202.537 1.29.044.087.073.188.015.304-.058.116-.087.189-.174.29-.087.102-.183.227-.261.305-.088.087-.179.182-.077.357.101.174.45 1.055 1.291 1.803.626.557 1.155.73 1.32.812.165.082.261.07.36-.044.098-.114.421-.49.534-.658.113-.169.227-.142.381-.085.155.057.982.463 1.15.547.168.084.281.127.322.197.042.07.042.408-.102.813z"/>
            </svg>
            WhatsApp Rate Sheet
          </Button>
        </div>

      </div>

      <!-- Right Column: One Striking Framed Yard Visual (5 cols, Sharp Corners, 4:5 Aspect) -->
      <div class="lg:col-span-5 hero-snap-visual">
        <div class="border border-cream-border bg-white p-2.5 sm:p-3">
          
          <!-- Striking Framed 4:5 Photo of Bhilwara Yard & Depot -->
          <div class="relative aspect-[4/5] w-full overflow-hidden bg-cream-warm">
            <img
              src="/images/shop-front-depot.webp"
              alt="Shree Shiv Construction and Steel yard storefront depot on 200 Feet Road, Bhilwara"
              width="1000"
              height="1250"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
            
            <!-- Sharp Contrast Corner Badges -->
            <div class="absolute top-3 left-3 bg-charcoal text-cream px-3 py-1 font-mono text-[10px] tracking-widest uppercase font-bold">
              <span class="w-1.5 h-1.5 bg-camel inline-block mr-1.5"></span>
              200 FT RD DEPOT // BHILWARA
            </div>
            
            <div class="absolute bottom-3 left-3 right-3 bg-white/95 border border-cream-border p-3 font-mono text-[11px] text-charcoal">
              <div class="flex items-center justify-between font-bold">
                <span>PHYSICAL YARD INVENTORY</span>
                <span class="text-camel">READY DISPATCH</span>
              </div>
            </div>
          </div>

          <!-- Technical Specs Strip Under Image -->
          <div class="mt-2.5 p-4 bg-cream-warm/60 border border-cream-border space-y-2 font-mono text-xs">
            <div class="flex items-center justify-between">
              <span class="text-charcoal-muted uppercase text-[10px] tracking-wider">Yard Location:</span>
              <strong class="text-charcoal text-right text-[11px]">200 Feet Rd, Nr Sharda Evergreen</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-charcoal-muted uppercase text-[10px] tracking-wider">Depot Hours:</span>
              <span class="text-charcoal font-semibold text-[11px]">Mon&ndash;Sat: 8:00 AM &ndash; 8:00 PM</span>
            </div>
            <div class="flex items-center justify-between pt-1.5 border-t border-cream-border">
              <span class="text-charcoal-muted uppercase text-[10px] tracking-wider">Direct Desk:</span>
              <a href="tel:+918278643303" class="text-charcoal font-bold hover:text-camel transition-colors">
                +91 8278643303
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
