---
// Rebuilt Homepage Hero: Interactive Sneaker-Drop Product Stage
// Colors strictly: Wine Red #7F011F and Light Sand #F5EBD0
---

<section
  id="hero-section"
  class="relative w-full lg:h-screen lg:min-h-[640px] lg:max-h-[900px] pt-20 pb-6 lg:py-0 flex flex-col justify-center overflow-hidden select-none transition-colors duration-200"
  data-current-index="0"
  style="--hero-wine: #7F011F; --hero-sand: #F5EBD0; background-color: #F5EBD0; color: #7F011F;"
  aria-label="Interactive Product Stage"
>
  <!-- Fast Wipe Overlay Layer for Snappy Hardware-Accelerated Background Inversion -->
  <div
    id="hero-wipe-layer"
    class="pointer-events-none absolute inset-0 z-0"
    style="transform: translateX(100%); will-change: transform;"
    aria-hidden="true"
  ></div>

  <!-- Giant Background Word (Layer behind cutout: z-10) -->
  <div
    class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none select-none overflow-hidden"
    aria-hidden="true"
  >
    <div
      id="hero-giant-word"
      class="font-condensed font-black uppercase text-[clamp(4.2rem,18vw,17.5rem)] leading-[0.76] tracking-tighter text-center transition-colors duration-200"
      style="color: var(--hero-wine); opacity: 0.18; will-change: transform, opacity;"
    >
      STRONG
    </div>
  </div>

  <!-- Subtle Grit Specks Layer around Product Stage (z-15) -->
  <div
    id="hero-grit-specks"
    class="absolute inset-0 z-15 pointer-events-none select-none flex items-center justify-center opacity-25"
    aria-hidden="true"
  >
    <svg class="w-full h-full max-w-5xl max-h-[600px]" viewBox="0 0 1000 700" fill="currentColor">
      <circle cx="480" cy="220" r="1.5" />
      <circle cx="560" cy="190" r="1.2" />
      <circle cx="420" cy="380" r="1.8" />
      <circle cx="600" cy="340" r="1.4" />
      <circle cx="360" cy="310" r="1.1" />
      <circle cx="640" cy="270" r="1.6" />
      <circle cx="510" cy="150" r="1.3" />
      <circle cx="450" cy="450" r="1.4" />
      <circle cx="540" cy="470" r="1.5" />
      <circle cx="340" cy="240" r="1.2" />
      <circle cx="660" cy="410" r="1.7" />
      <circle cx="400" cy="170" r="1" />
      <circle cx="590" cy="160" r="1.4" />
      <circle cx="380" cy="410" r="1.3" />
      <circle cx="620" cy="210" r="1.2" />
      <circle cx="530" cy="290" r="1.6" />
      <circle cx="460" cy="260" r="1.1" />
      <circle cx="570" cy="390" r="1.4" />
      <circle cx="410" cy="490" r="1.5" />
      <circle cx="580" cy="480" r="1.2" />
      <circle cx="330" cy="370" r="1.4" />
      <circle cx="670" cy="320" r="1.3" />
    </svg>
  </div>

  <!-- Main Hero Layout Container (z-30) -->
  <div class="relative z-30 w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 h-full flex flex-col justify-center">
    
    <!-- DESKTOP / TABLET / MOBILE RESPONSIVE GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- LEFT COLUMN: Tagline, Dynamic Short Line & Dual CTAs (4 cols on desktop) -->
      <div class="lg:col-span-4 text-left flex flex-col justify-center order-1">
        
        <!-- Micro Deck Kicker -->
        <div class="flex items-center gap-2 mb-2 sm:mb-2.5">
          <span class="w-2 h-2 rounded-full inline-block" style="background-color: currentColor;"></span>
          <span class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.24em] font-bold opacity-80">
            PRODUCT STAGE &bull; BHILWARA
          </span>
        </div>

        <!-- Tagline: "मजबूती की सही पहचान" -->
        <h1
          lang="hi"
          class="font-hindi text-3xl sm:text-4xl lg:text-[2.75rem] font-bold leading-[1.08] select-none"
          style="color: inherit;"
          aria-label="मजबूती की सही पहचान"
        >
          मजबूती की सही पहचान
        </h1>

        <!-- One Short Line per Product (changes dynamically with product) -->
        <p
          id="hero-product-desc"
          class="font-body text-xs sm:text-sm lg:text-sm leading-relaxed mt-2.5 sm:mt-3 max-w-md font-medium"
          style="color: inherit;"
        >
          Primary billet Fe 550D reinforcement bar engineered for seismic & structural endurance.
        </p>

        <!-- Product Name Badge -->
        <div class="mt-3 sm:mt-4 inline-flex items-center gap-2">
          <span
            id="hero-product-name-badge"
            class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.18em] font-bold px-3 py-1 rounded-full border transition-colors duration-200"
            style="border-color: currentColor; color: inherit;"
          >
            Kay2 Xenox TMT Sariya
          </span>
        </div>

        <!-- CTAs: "Order on WhatsApp" and "See all products" -->
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 mt-4 sm:mt-5">
          <a
            id="hero-cta-whatsapp"
            href="https://wa.me/918278643303"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-pill-cta inline-flex items-center justify-center px-6 py-3 rounded-full font-mono text-xs uppercase tracking-[0.2em] font-black transition-transform duration-200 active:scale-95 text-center shadow-sm"
            style="background-color: var(--hero-wine); color: var(--hero-sand);"
            aria-label="Order on WhatsApp at +91 8278643303"
          >
            Order on WhatsApp
          </a>

          <a
            id="hero-cta-all"
            href="/products"
            class="hero-pill-outline inline-flex items-center justify-center px-6 py-3 rounded-full font-mono text-xs uppercase tracking-[0.2em] font-bold border transition-transform duration-200 active:scale-95 text-center"
            style="border-color: currentColor; color: inherit;"
            aria-label="See all products catalog"
          >
            See all products
          </a>
        </div>

        <!-- Micro Specification Note -->
        <div class="hidden sm:flex mt-4 pt-2.5 border-t font-mono text-[9px] sm:text-[10px] uppercase tracking-[0.2em] opacity-75 items-center gap-3" style="border-color: currentColor; color: inherit;">
          <span>DIRECT MILL ALLOTMENT</span>
          <span>&bull;</span>
          <span>WEIGHBRIDGE PAKKA BILL</span>
        </div>
      </div>

      <!-- CENTER STAGE: Giant Floating Product Cutout + Contact Shadow (5 cols on desktop) -->
      <div class="lg:col-span-5 relative flex items-center justify-center order-2 my-2 sm:my-3 lg:my-0">
        
        <!-- Center Stage Visual Frame -->
        <div class="relative w-full max-w-[320px] sm:max-w-[380px] lg:max-w-[440px] aspect-square flex items-center justify-center">
          
          <!-- Soft Contact Shadow Beneath Floating Product (Layer z-20) -->
          <div
            id="hero-contact-shadow"
            class="absolute bottom-[6%] sm:bottom-[8%] left-1/2 -translate-x-1/2 w-[65%] sm:w-[70%] h-7 sm:h-10 rounded-[50%] blur-xl pointer-events-none transition-opacity"
            style="background: radial-gradient(ellipse at center, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.15) 50%, transparent 75%); opacity: 0.6;"
            aria-hidden="true"
          ></div>

          <!-- Product Cutout Image (Layer z-25, floats above giant word) -->
          <div
            id="hero-product-wrap"
            class="relative z-25 w-full h-full flex items-center justify-center pointer-events-none"
            style="will-change: transform, opacity;"
          >
            <img
              id="hero-product-img"
              src="/images/cutout-tmt.png"
              alt="Kay2 Xenox TMT Sariya"
              width="600"
              height="600"
              fetchpriority="high"
              class="w-full h-full object-contain filter drop-shadow-2xl max-h-[280px] sm:max-h-[340px] lg:max-h-[410px]"
            />
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: Product Selector Dots & Variant Pills (3 cols on desktop) -->
      <div class="lg:col-span-3 text-left lg:text-right flex flex-col justify-center order-3 space-y-4 sm:space-y-5">
        
        <!-- Product Selector Dots with Labels -->
        <div>
          <div class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.24em] font-bold opacity-80 mb-2 text-left lg:text-right" style="color: inherit;">
            SELECT PRODUCT
          </div>

          <div
            id="hero-selector-group"
            class="flex flex-row lg:flex-col gap-2 overflow-x-auto pb-1 lg:pb-0"
            role="tablist"
            aria-label="Product Switcher"
          >
            <!-- 01: Kay2 Xenox TMT -->
            <button
              type="button"
              class="hero-selector-btn group flex items-center gap-2.5 lg:justify-end px-3 py-2 rounded-xl border text-left lg:text-right transition-all duration-200 cursor-pointer active:scale-98 whitespace-nowrap"
              data-product-index="0"
              role="tab"
              aria-selected="true"
              aria-label="Select Kay2 Xenox TMT Sariya"
              style="color: inherit;"
            >
              <span class="selector-dot w-2.5 h-2.5 rounded-full transition-transform duration-200 scale-125" style="background-color: currentColor;"></span>
              <span class="font-mono text-[11px] sm:text-xs uppercase tracking-wider font-bold">
                01 &mdash; Kay2 Xenox TMT
              </span>
            </button>

            <!-- 02: Binding Wire -->
            <button
              type="button"
              class="hero-selector-btn group flex items-center gap-2.5 lg:justify-end px-3 py-2 rounded-xl border text-left lg:text-right transition-all duration-200 cursor-pointer opacity-70 hover:opacity-100 active:scale-98 whitespace-nowrap"
              data-product-index="1"
              role="tab"
              aria-selected="false"
              aria-label="Select Binding Wire"
              style="color: inherit;"
            >
              <span class="selector-dot w-2.5 h-2.5 rounded-full transition-transform duration-200" style="background-color: currentColor;"></span>
              <span class="font-mono text-[11px] sm:text-xs uppercase tracking-wider font-bold">
                02 &mdash; Binding Wire
              </span>
            </button>

            <!-- 03: Cover Blocks -->
            <button
              type="button"
              class="hero-selector-btn group flex items-center gap-2.5 lg:justify-end px-3 py-2 rounded-xl border text-left lg:text-right transition-all duration-200 cursor-pointer opacity-70 hover:opacity-100 active:scale-98 whitespace-nowrap"
              data-product-index="2"
              role="tab"
              aria-selected="false"
              aria-label="Select Cover Blocks"
              style="color: inherit;"
            >
              <span class="selector-dot w-2.5 h-2.5 rounded-full transition-transform duration-200" style="background-color: currentColor;"></span>
              <span class="font-mono text-[11px] sm:text-xs uppercase tracking-wider font-bold">
                03 &mdash; Cover Blocks
              </span>
            </button>
          </div>
        </div>

        <!-- Variant Pills: For TMT show diameters 8, 10, 12, 16, 20, 25, 32 mm -->
        <div class="pt-2.5 border-t" style="border-color: currentColor; color: inherit;">
          <div class="font-mono text-[10px] sm:text-xs uppercase tracking-[0.24em] font-bold opacity-80 mb-2 text-left lg:text-right" style="color: inherit;">
            DIAMETERS &amp; SIZES
          </div>

          <div
            id="hero-variant-pills"
            class="flex flex-wrap gap-1.5 justify-start lg:justify-end"
            aria-label="Available product specifications"
          >
            <!-- Injected dynamically via client script -->
          </div>
        </div>

        <!-- Auto-advance status / timer indicator -->
        <div class="flex items-center gap-2 justify-start lg:justify-end font-mono text-[9px] uppercase tracking-[0.2em] opacity-75" style="color: inherit;">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: currentColor;"></span>
          <span id="hero-timer-status">AUTO-CYCLE: 5S ACTIVE</span>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* Sneaker stage strict typography and hardware acceleration */
  .font-condensed {
    font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  }

  #hero-section {
    contain: layout style;
  }

  #hero-section h1,
  #hero-section p,
  #hero-section span,
  #hero-section div,
  #hero-section button {
    color: inherit;
  }

  .hero-selector-btn {
    border-color: transparent;
  }

  .hero-selector-btn[aria-selected="true"] {
    border-color: currentColor;
    background-color: rgba(127, 1, 31, 0.08);
  }

  /* When theme inverts to Wine Red */
  #hero-section[data-theme="wine"] .hero-selector-btn[aria-selected="true"] {
    background-color: rgba(245, 235, 208, 0.12);
  }

  .variant-pill {
    transition: all 0.2s ease;
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Product Stage Definition
  // Colors strictly: Wine Red #7F011F and Light Sand #F5EBD0
  interface ProductStage {
    name: string;
    word: string;
    bgHex: string;
    fgHex: string;
    theme: 'sand' | 'wine';
    shortLine: string;
    imageSrc: string;
    imageAlt: string;
    variants: string[];
  }

  const products: ProductStage[] = [
    {
      name: 'Kay2 Xenox TMT Sariya',
      word: 'STRONG',
      bgHex: '#F5EBD0', // Light Sand
      fgHex: '#7F011F', // Wine Red
      theme: 'sand',
      shortLine: 'Primary billet Fe 550D reinforcement bar engineered for seismic & structural endurance.',
      imageSrc: '/images/cutout-tmt.png',
      imageAlt: 'Kay2 Xenox Fe 550D TMT Sariya Bar Cutout',
      variants: ['8 mm', '10 mm', '12 mm', '16 mm', '20 mm', '25 mm', '32 mm']
    },
    {
      name: 'Binding Wire',
      word: 'BIND',
      bgHex: '#7F011F', // Wine Red
      fgHex: '#F5EBD0', // Light Sand
      theme: 'wine',
      shortLine: 'Dead-soft annealed 18 & 20 gauge tie wire for rapid, zero-snap rebar tying.',
      imageSrc: '/images/cutout-wire.png',
      imageAlt: 'Annealed Steel Binding Wire Coil Cutout',
      variants: ['18 Gauge', '20 Gauge', '25 kg Bundle', '50 kg Bundle']
    },
    {
      name: 'Cover Blocks',
      word: 'SOLID',
      bgHex: '#F5EBD0', // Light Sand
      fgHex: '#7F011F', // Wine Red
      theme: 'sand',
      shortLine: 'High-density concrete spacers ensuring 100% specified cover depth and fire rating.',
      imageSrc: '/images/cutout-blocks.png',
      imageAlt: 'High Density Concrete Cover Blocks Spacers Cutout',
      variants: ['20 mm', '25 mm', '40 mm', '50 mm', '75 mm']
    }
  ];

  function initHeroStage() {
    const heroSection = document.getElementById('hero-section');
    if (!heroSection) return;

    const wipeLayer = document.getElementById('hero-wipe-layer');
    const giantWord = document.getElementById('hero-giant-word');
    const productWrap = document.getElementById('hero-product-wrap');
    const productImg = document.getElementById('hero-product-img') as HTMLImageElement | null;
    const productDesc = document.getElementById('hero-product-desc');
    const productNameBadge = document.getElementById('hero-product-name-badge');
    const whatsappBtn = document.getElementById('hero-cta-whatsapp');
    const allBtn = document.getElementById('hero-cta-all');
    const variantPillsWrap = document.getElementById('hero-variant-pills');
    const selectorButtons = Array.from(document.querySelectorAll('.hero-selector-btn')) as HTMLButtonElement[];
    const timerStatus = document.getElementById('hero-timer-status');

    let currentIndex = 0;
    let isTransitioning = false;
    let autoAdvanceTimer: any = null;
    let isPaused = false;
    let currentTimeline: gsap.core.Timeline | null = null;

    // Check user preference for motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Render variant pills
    function renderVariants(variants: string[], fgColor: string, bgColor: string) {
      if (!variantPillsWrap) return;
      variantPillsWrap.innerHTML = '';
      variants.forEach((v, idx) => {
        const pill = document.createElement('span');
        pill.className = 'variant-pill font-mono text-[10px] sm:text-[11px] font-bold px-2.5 py-1 rounded-full border tracking-wide transition-all select-none cursor-pointer';
        pill.style.borderColor = fgColor;
        pill.style.color = idx === 0 ? bgColor : fgColor;
        pill.style.backgroundColor = idx === 0 ? fgColor : 'transparent';
        pill.textContent = v;
        pill.addEventListener('click', () => {
          const allPills = variantPillsWrap.querySelectorAll('.variant-pill');
          allPills.forEach((p) => {
            const el = p as HTMLElement;
            el.style.color = fgColor;
            el.style.backgroundColor = 'transparent';
          });
          pill.style.color = bgColor;
          pill.style.backgroundColor = fgColor;
        });
        variantPillsWrap.appendChild(pill);
      });
    }

    // Apply color theme directly to section and elements
    function applyTheme(item: ProductStage, targetIndex: number) {
      currentIndex = targetIndex;
      heroSection.style.backgroundColor = item.bgHex;
      heroSection.style.color = item.fgHex;
      heroSection.setAttribute('data-theme', item.theme);
      heroSection.setAttribute('data-current-index', targetIndex.toString());

      // CTAs
      if (whatsappBtn) {
        whatsappBtn.style.backgroundColor = item.fgHex;
        whatsappBtn.style.color = item.bgHex;
      }
      if (allBtn) {
        allBtn.style.borderColor = item.fgHex;
        allBtn.style.color = item.fgHex;
      }

      // Giant word color
      if (giantWord) {
        giantWord.style.color = item.fgHex;
      }

      // Name badge
      if (productNameBadge) {
        productNameBadge.style.borderColor = item.fgHex;
        productNameBadge.textContent = item.name;
      }

      // Short line
      if (productDesc) {
        productDesc.textContent = item.shortLine;
      }

      // Selector buttons active states
      selectorButtons.forEach((btn, idx) => {
        const isSelected = idx === targetIndex;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.style.opacity = isSelected ? '1' : '0.65';
        const dot = btn.querySelector('.selector-dot') as HTMLElement | null;
        if (dot) {
          dot.style.transform = isSelected ? 'scale(1.3)' : 'scale(1)';
        }
      });

      // Variants
      renderVariants(item.variants, item.fgHex, item.bgHex);
    }

    // Immediate initial theme render
    applyTheme(products[0], 0);

    // Product Switch Function
    function goToProduct(nextIndex: number, direction: 'next' | 'prev' = 'next') {
      if (nextIndex === currentIndex) return;
      resetAutoAdvance();

      // Clean up any ongoing tween
      if (currentTimeline) {
        currentTimeline.kill();
        currentTimeline = null;
      }
      isTransitioning = true;

      const current = products[currentIndex];
      const next = products[nextIndex];
      const dirMult = direction === 'next' ? 1 : -1;

      // Reduced motion fallback: instant switch, no GSAP tweens
      if (prefersReducedMotion) {
        if (productImg) {
          productImg.src = next.imageSrc;
          productImg.alt = next.imageAlt;
        }
        if (giantWord) {
          giantWord.textContent = next.word;
        }
        applyTheme(next, nextIndex);
        isTransitioning = false;
        return;
      }

      // GSAP Snappy ~0.6s Sneaker Drop Animation
      const tl = gsap.timeline({
        onComplete: () => {
          isTransitioning = false;
          currentTimeline = null;
        }
      });
      currentTimeline = tl;

      // 1. Snappy hardware-accelerated slide wipe
      if (wipeLayer) {
        wipeLayer.style.backgroundColor = next.bgHex;
        tl.fromTo(
          wipeLayer,
          { xPercent: dirMult > 0 ? 100 : -100 },
          {
            xPercent: 0,
            duration: 0.30,
            ease: 'power2.inOut',
            onComplete: () => {
              applyTheme(next, nextIndex);
              gsap.set(wipeLayer, { xPercent: 100 });
            }
          },
          0
        );
      } else {
        applyTheme(next, nextIndex);
      }

      // 2. Old product flips/slides out with slight rotation
      if (productWrap && productImg) {
        tl.to(
          productWrap,
          {
            x: -75 * dirMult,
            rotation: -10 * dirMult,
            scale: 0.88,
            opacity: 0,
            duration: 0.22,
            ease: 'power2.in'
          },
          0
        );

        tl.add(() => {
          productImg.src = next.imageSrc;
          productImg.alt = next.imageAlt;
        }, 0.22);

        // 3. New product flips in with snappy rotation
        tl.fromTo(
          productWrap,
          {
            x: 75 * dirMult,
            rotation: 10 * dirMult,
            scale: 0.9,
            opacity: 0
          },
          {
            x: 0,
            rotation: 0,
            scale: 1,
            opacity: 1,
            duration: 0.38,
            ease: 'power3.out'
          },
          0.22
        );
      }

      // 4. Giant word slides horizontally
      if (giantWord) {
        tl.to(
          giantWord,
          {
            x: -110 * dirMult,
            opacity: 0,
            duration: 0.20,
            ease: 'power2.in'
          },
          0
        );

        tl.add(() => {
          giantWord.textContent = next.word;
        }, 0.20);

        tl.fromTo(
          giantWord,
          {
            x: 110 * dirMult,
            opacity: 0
          },
          {
            x: 0,
            opacity: 0.18,
            duration: 0.40,
            ease: 'power3.out'
          },
          0.20
        );
      }

      // 5. Short line & badge micro-transition
      if (productDesc && productNameBadge) {
        tl.to(
          [productDesc, productNameBadge],
          {
            y: -6,
            opacity: 0,
            duration: 0.16,
            ease: 'power2.in'
          },
          0
        );

        tl.fromTo(
          [productDesc, productNameBadge],
          {
            y: 8,
            opacity: 0
          },
          {
            y: 0,
            opacity: 1,
            duration: 0.34,
            ease: 'power3.out'
          },
          0.22
        );
      }
    }

    // Attach click handlers to selector buttons
    selectorButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const idx = parseInt(btn.getAttribute('data-product-index') || '0', 10);
        if (idx !== currentIndex) {
          const dir = idx > currentIndex ? 'next' : 'prev';
          goToProduct(idx, dir);
          resetAutoAdvance();
        }
      });
    });

    // Auto-advance every 5 seconds (disabled on reduced motion)
    function startAutoAdvance() {
      if (prefersReducedMotion) {
        if (timerStatus) timerStatus.textContent = 'REDUCED MOTION: STATIC';
        return;
      }
      stopAutoAdvance();
      autoAdvanceTimer = setInterval(() => {
        if (!isPaused) {
          const nextIndex = (currentIndex + 1) % products.length;
          goToProduct(nextIndex, 'next');
        }
      }, 5000);
    }

    function stopAutoAdvance() {
      if (autoAdvanceTimer) {
        clearInterval(autoAdvanceTimer);
        autoAdvanceTimer = null;
      }
    }

    function resetAutoAdvance() {
      stopAutoAdvance();
      startAutoAdvance();
    }

    // Hover & Touch pause/resume
    heroSection.addEventListener('mouseenter', () => {
      isPaused = true;
      if (timerStatus) timerStatus.textContent = 'AUTO-CYCLE: PAUSED';
    });
    heroSection.addEventListener('mouseleave', () => {
      isPaused = false;
      if (timerStatus) timerStatus.textContent = 'AUTO-CYCLE: 5S ACTIVE';
    });
    heroSection.addEventListener('touchstart', () => {
      isPaused = true;
    }, { passive: true });
    heroSection.addEventListener('touchend', () => {
      isPaused = false;
    }, { passive: true });

    // Keyboard support for accessibility
    heroSection.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        const nextIndex = (currentIndex + 1) % products.length;
        goToProduct(nextIndex, 'next');
        resetAutoAdvance();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        const prevIndex = (currentIndex - 1 + products.length) % products.length;
        goToProduct(prevIndex, 'prev');
        resetAutoAdvance();
      }
    });

    // Expose helpers for external triggers / tests
    (window as any).__heroGoToProduct = goToProduct;
    (window as any).__heroGetIndex = () => currentIndex;

    // Kickoff auto-advance
    startAutoAdvance();
  }

  // Initialize on page load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroStage);
  } else {
    initHeroStage();
  }
  document.addEventListener('astro:page-load', initHeroStage);
</script>
