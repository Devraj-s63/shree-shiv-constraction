---
// CookieConsent.astro - Rounded pill bottom-center consent chip with GA4 loader
const GA_MEASUREMENT_ID = (import.meta.env.PUBLIC_GA_ID || '').trim();
---

<div
  id="cookie-consent-pill"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 rounded-full bg-cream-card/95 backdrop-blur-md border border-cream-border px-5 sm:px-6 py-3 shadow-xl transition-all duration-300 hidden max-w-xl w-[92vw] sm:w-auto"
  role="region"
  aria-label="Cookie and Privacy Notice"
>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-6">
    <!-- Faint Blueprint Kicker & Notice Copy -->
    <div class="flex items-center gap-2.5 text-center sm:text-left">
      <span class="w-1.5 h-1.5 rounded-full bg-camel shrink-0"></span>
      <p class="font-body text-xs text-charcoal leading-snug">
        Essential cookies for catalog performance. No trackers sold. <a href="/privacy-policy" class="text-charcoal-muted underline hover:text-camel">Privacy</a>
      </p>
    </div>

    <!-- Action Pill Buttons -->
    <div class="flex items-center gap-2 shrink-0">
      <button
        id="cookie-decline-btn"
        type="button"
        class="rounded-full px-3.5 py-1.5 font-mono text-[10px] uppercase tracking-wider font-bold text-charcoal-muted hover:text-charcoal hover:bg-cream-warm transition-colors cursor-pointer"
        aria-label="Decline cookies"
      >
        Decline
      </button>

      <button
        id="cookie-accept-btn"
        type="button"
        class="rounded-full px-4 py-1.5 font-mono text-[10px] uppercase tracking-widest font-black bg-camel text-charcoal hover:bg-camel-dark transition-colors cursor-pointer"
        aria-label="Accept and continue with cookies"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script define:vars={{ GA_MEASUREMENT_ID }}>
  const STORAGE_KEY = 'sscs_cookie_consent_v1';
  const pill = document.getElementById('cookie-consent-pill');
  const acceptBtn = document.getElementById('cookie-accept-btn');
  const declineBtn = document.getElementById('cookie-decline-btn');

  function loadGA4() {
    if (!GA_MEASUREMENT_ID || !/^G-[A-Z0-9]+$/i.test(GA_MEASUREMENT_ID)) {
      return;
    }

    if (window._ga4Loaded) return;
    window._ga4Loaded = true;

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID, {
      anonymize_ip: true,
      cookie_flags: 'SameSite=None;Secure',
    });
  }

  function showPill() {
    if (!pill) return;
    pill.classList.remove('hidden');
  }

  function hidePill() {
    if (!pill) return;
    pill.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      pill.classList.add('hidden');
    }, 300);
  }

  const consent = localStorage.getItem(STORAGE_KEY);

  if (consent === 'accepted') {
    loadGA4();
  } else if (consent === 'declined') {
    // Consent declined
  } else {
    setTimeout(showPill, 800);
  }

  if (acceptBtn) {
    acceptBtn.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      hidePill();
      loadGA4();
    });
  }

  if (declineBtn) {
    declineBtn.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'declined');
      hidePill();
    });
  }
</script>
