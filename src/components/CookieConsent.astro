---
// CookieConsent component with GA4 consent-gated loader
// Set PUBLIC_GA_ID in environment variables (e.g. .env or Vercel dashboard) to activate GA4
const GA_MEASUREMENT_ID = (import.meta.env.PUBLIC_GA_ID || '').trim();
---

<div
  id="cookie-consent-banner"
  class="fixed bottom-0 inset-x-0 z-50 bg-charcoal text-cream border-t-2 border-camel p-4 md:p-6 shadow-2xl transform translate-y-full transition-transform duration-300 hidden"
  role="region"
  aria-label="Cookie and Privacy Preferences"
>
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <!-- Plain Human Notice Copy -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 bg-camel inline-block"></span>
        <span class="font-display text-xs uppercase tracking-wider font-bold text-camel">
          Cookie &amp; Privacy Notice
        </span>
      </div>
      <p class="font-body text-xs sm:text-sm text-cream/80 leading-relaxed">
        We use basic cookies to see how visitors browse our site and to improve our steel catalog. We never track banking details or sell your personal information. Read our <a href="/privacy-policy" class="text-camel underline hover:text-cream">Privacy Policy</a>.
      </p>
    </div>

    <!-- Action Buttons (Accept / Decline) -->
    <div class="flex items-center gap-3 shrink-0 w-full md:w-auto">
      <button
        id="cookie-decline-btn"
        type="button"
        class="flex-1 md:flex-none px-5 py-2.5 font-display text-xs uppercase tracking-wider font-bold text-cream bg-transparent border border-cream/30 hover:border-cream hover:bg-cream/10 focus:outline-none transition-colors cursor-pointer"
        aria-label="Decline cookies"
      >
        Decline
      </button>

      <button
        id="cookie-accept-btn"
        type="button"
        class="flex-1 md:flex-none px-5 py-2.5 font-display text-xs uppercase tracking-wider font-bold bg-camel text-charcoal hover:bg-camel-dark focus:outline-none transition-colors cursor-pointer font-black"
        aria-label="Accept and continue with cookies"
      >
        Accept &amp; Continue
      </button>
    </div>
  </div>
</div>

<script define:vars={{ GA_MEASUREMENT_ID }}>
  const STORAGE_KEY = 'sscs_cookie_consent_v1';
  const banner = document.getElementById('cookie-consent-banner');
  const acceptBtn = document.getElementById('cookie-accept-btn');
  const declineBtn = document.getElementById('cookie-decline-btn');

  function loadGA4() {
    // Only load if a valid measurement ID is set and not loaded already
    if (!GA_MEASUREMENT_ID || !/^G-[A-Z0-9]+$/i.test(GA_MEASUREMENT_ID)) {
      return;
    }

    if (window._ga4Loaded) return;
    window._ga4Loaded = true;

    // Dynamically inject GA4 script tags
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID, {
      anonymize_ip: true,
      cookie_flags: 'SameSite=None;Secure',
    });
  }

  function showBanner() {
    if (!banner) return;
    banner.classList.remove('hidden');
    requestAnimationFrame(() => {
      banner.classList.remove('translate-y-full');
      banner.classList.add('translate-y-0');
    });
  }

  function hideBanner() {
    if (!banner) return;
    banner.classList.remove('translate-y-0');
    banner.classList.add('translate-y-full');
    setTimeout(() => {
      banner.classList.add('hidden');
    }, 300);
  }

  const consent = localStorage.getItem(STORAGE_KEY);

  if (consent === 'accepted') {
    loadGA4();
  } else if (consent === 'declined') {
    // Consent declined
  } else {
    setTimeout(showBanner, 600);
  }

  if (acceptBtn) {
    acceptBtn.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      hideBanner();
      loadGA4();
    });
  }

  if (declineBtn) {
    declineBtn.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'declined');
      hideBanner();
    });
  }
</script>
