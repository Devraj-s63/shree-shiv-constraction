---
// AmberMarquee.astro - Editorial ticker ribbon in deep charcoal with cream text
interface Props {
  text?: string;
  speed?: string;
}

const {
  text = 'मजबूती की सही पहचान // BUILDING A STRONGER TOMORROW // AUTHORISED KAY2 XENOX TMT DEALER // BHILWARA YARD DISPATCH',
  speed = '35s'
} = Astro.props;

// Repeat 4 times for seamless continuous loop
const items = [1, 2, 3, 4];
---

<div class="relative bg-charcoal text-cream border-y border-camel/40 overflow-hidden py-3 select-none z-20">
  <div class="flex w-max animate-marquee font-display font-black text-sm md:text-base uppercase tracking-widest" style={`animation-duration: ${speed};`}>
    {items.map(() => (
      <div class="flex items-center shrink-0">
        <span lang="hi" class="mx-6 text-cream">मजबूती की सही पहचान</span>
        <span class="text-camel">&bull;</span>
        <span class="mx-6 text-cream">SHREE SHIV CONSTRUCTION &amp; STEEL</span>
        <span class="text-camel">&bull;</span>
        <span class="mx-6 text-cream">KAY2 XENOX Fe 550D</span>
        <span class="text-camel">&bull;</span>
        <span class="mx-6 text-cream">BHILWARA RAJASTHAN</span>
        <span class="text-camel">&bull;</span>
        <span class="mx-6 font-mono text-xs text-charcoal bg-camel px-2.5 py-0.5 font-bold">CALL: +91 8278643303</span>
        <span class="text-camel">&bull;</span>
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
