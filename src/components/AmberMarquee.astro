---
// AmberMarquee.astro - Endless industrial ticker strip carrying "मजबूती की सही पहचान"
interface Props {
  text?: string;
  speed?: string;
}

const {
  text = 'मजबूती की सही पहचान // BUILDING A STRONGER TOMORROW // AUTHORISED KAY2 XENOX TMT DEALER // BHILWARA YARD DISPATCH',
  speed = '35s'
} = Astro.props;

// Repeat 4 times for seamless continuous loop
const items = [1, 2, 3, 4];
---

<div class="relative bg-safety-amber text-steel-blue-dark border-y-2 border-steel-blue-dark overflow-hidden py-3 select-none z-20">
  <!-- Subtle metal texture over marquee -->
  <div class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#000000_1px,transparent_1px)] [background-size:12px_12px]" aria-hidden="true"></div>

  <div class="flex w-max animate-marquee font-display font-black text-sm md:text-base uppercase tracking-widest" style={`animation-duration: ${speed};`}>
    {items.map(() => (
      <div class="flex items-center shrink-0">
        <span class="mx-6 text-steel-blue-dark">मजबूती की सही पहचान</span>
        <span class="text-steel-blue-dark/50">&bull;</span>
        <span class="mx-6 text-steel-blue-dark">SHREE SHIV CONSTRUCTION &amp; STEEL</span>
        <span class="text-steel-blue-dark/50">&bull;</span>
        <span class="mx-6 text-steel-blue-dark">KAY2 XENOX Fe 550D</span>
        <span class="text-steel-blue-dark/50">&bull;</span>
        <span class="mx-6 text-steel-blue-dark">BHILWARA RAJASTHAN</span>
        <span class="text-steel-blue-dark/50">&bull;</span>
        <span class="mx-6 font-mono text-xs text-steel-blue-dark/80 bg-steel-blue-dark/15 px-2 py-0.5">CALL: 8278643303</span>
        <span class="text-steel-blue-dark/50">&bull;</span>
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
