---
// HorizontalGallery.astro - Premium horizontal-scroll product exhibition powered by GSAP ScrollTrigger
const exhibits = [
  {
    number: '01',
    name: 'Kay2 Xenox TMT Fe 550D',
    gauge: '8mm to 32mm Stock',
    summary: 'Original mill-certified Fe 550D sariya with advanced cross-rib pattern. Bends smoothly without micro-cracking and offers superior earthquake resistance.',
    tag: 'ORIGINAL FACTORY STOCK',
    image: '/images/steel-yard-stock.webp',
    specs: ['Fe 550D Mill Tested', 'High Elongation', 'Fire Resistant', 'Test Certificate']
  },
  {
    number: '02',
    name: 'Primary TMT Sariya',
    gauge: 'Complete Size Range',
    summary: 'Full inventory of 8mm, 10mm, 12mm, 16mm, 20mm, 25mm, and 32mm bars for residential slabs, columns, and foundations. Verified on computerized weighbridge.',
    tag: 'FULL YARD INVENTORY',
    image: '/images/hero-steel-poster.webp',
    specs: ['IS 1786 Standard', 'Rust-Protected Staging', 'Tough Bending Core', 'Computerized Kanta']
  },
  {
    number: '03',
    name: 'Annealed Binding Wire',
    gauge: '18 & 20 Gauge Bundles',
    summary: 'Soft, flexible black annealed tying wire that knots easily and securely around sariya cages without snapping in the mistri’s hand.',
    tag: 'PHOTO PENDING // YARD STOCK',
    image: '/images/placeholder-binding-wire.svg',
    specs: ['Dead-Soft Annealed', 'Smooth Knotting', 'Uniform Thickness', '25kg & 50kg Bundles']
  },
  {
    number: '04',
    name: 'Precast Concrete Cover Blocks',
    gauge: '20mm / 25mm / 40mm / 50mm',
    summary: 'Heavy-duty precast concrete spacers to keep sariya elevated inside roof slabs, beams, and columns, protecting steel from moisture and rusting.',
    tag: 'PHOTO PENDING // YARD STOCK',
    image: '/images/placeholder-cover-blocks.svg',
    specs: ['M-35 High Strength', 'Zero Porosity', 'Roof Slab & Beam Fit', 'Even Concrete Cover']
  },
  {
    number: '05',
    name: 'Building & Construction Supplies',
    gauge: 'Direct Yard Loading',
    summary: 'Direct sourcing of UltraTech cement, wire mesh, and essential civil construction accessories with prompt loading at our 200 Feet Road depot.',
    tag: '200 FT RD DEPOT',
    image: '/images/shop-front-depot.webp',
    specs: ['Mandi Wholesale Rates', 'Single-Point Sourcing', 'Trolley & Truck Loading', 'Prompt Site Delivery']
  }
];
---

<section id="horizontal-product-gallery" class="relative bg-canvas py-24 md:py-36 overflow-hidden hairline-b">
  
  <!-- Section Intro Header -->
  <div class="max-w-7xl mx-auto px-6 md:px-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-8">
    <div>
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 bg-safety-amber inline-block"></span>
        <span class="micro-label text-steel-gray">
          Curated Catalog Exhibition
        </span>
      </div>
      <h2 class="font-display text-[clamp(2.5rem,6vw,5rem)] font-black uppercase tracking-tight text-white leading-[1.02]">
        Horizontal Gallery &bull; <br class="hidden sm:inline" />
        <span class="text-steel-gray">Engineering Catalog</span>
      </h2>
    </div>

    <div class="font-mono text-xs text-steel-gray flex items-center gap-3">
      <span class="micro-label text-safety-amber">SCROLL DOWN TO EXPLORE</span>
      <span class="hidden sm:inline text-steel-gray/40">&bull; 05 PRODUCT TILES</span>
    </div>
  </div>

  <div class="gallery-pin-wrapper w-full overflow-hidden">
    <div class="gallery-track flex gap-4 sm:gap-6 md:gap-8 px-4 sm:px-6 md:px-12 w-max">
      {exhibits.map((item) => (
        <div class="gallery-card w-[290px] sm:w-[420px] md:w-[500px] shrink-0 hairline-all bg-canvasMuted text-white flex flex-col justify-between group overflow-hidden">
          
          <!-- Image Header with Hover Scale -->
          <div class="relative aspect-[16/10] overflow-hidden border-b border-steel-gray/30 bg-black">
            <img
              src={item.image}
              alt={item.name}
              width="800"
              height="500"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-[0.9] contrast-[1.05]"
            />
            <div class="absolute top-3 left-3 bg-steel-blue-dark/90 border border-safety-amber/60 px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-canvas backdrop-blur-sm">
              <span class="w-1.5 h-1.5 bg-safety-amber inline-block mr-1"></span>
              {item.tag}
            </div>
            <div class="absolute bottom-3 right-3 bg-steel-blue-dark/90 px-2 py-0.5 text-[11px] font-mono text-safety-amber">
              {item.number} / 05
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 md:p-8 flex flex-col justify-between flex-grow">
            <div>
              <span class="font-mono text-xs text-safety-amber font-bold tracking-wider block mb-2">
                {item.gauge}
              </span>
              <h3 class="font-display text-xl sm:text-2xl font-black uppercase tracking-tight text-white mb-3 group-hover:text-safety-amber transition-colors">
                {item.name}
              </h3>
              <p class="font-body text-xs sm:text-sm text-steel-gray-light leading-relaxed mb-6">
                {item.summary}
              </p>

              <!-- Spec Badges List -->
              <div class="grid grid-cols-2 gap-2 mb-6">
                {item.specs.map((spec) => (
                  <div class="bg-canvas border border-white/10 px-2.5 py-1.5 text-[11px] font-mono text-white flex items-center gap-1.5">
                    <span class="w-1 h-1 bg-safety-amber inline-block"></span>
                    <span>{spec}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Footer Action Link -->
            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <a
                href="/products"
                class="magnetic-btn font-display text-xs uppercase tracking-wider font-bold text-safety-amber hover:underline inline-flex items-center gap-1.5"
              >
                <span>Full Specifications</span>
                <span>&rarr;</span>
              </a>
              <span class="font-mono text-[10px] text-steel-gray">YARD READY</span>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>

</section>
