---
// HorizontalGallery.astro - Responsive product exhibition grid with real photography
const exhibits = [
  {
    number: '01',
    name: 'Kay2 Xenox TMT Fe 550D',
    gauge: '8mm to 32mm Stock',
    summary: 'Original mill-certified Fe 550D sariya with specialized cross-rib pattern. Bends smoothly without cracking and offers superior earthquake resistance.',
    tag: 'ORIGINAL FACTORY STOCK',
    image: '/images/yard-stock-clean.jpg',
    specs: ['Fe 550D Mill Tested', 'High Elongation', 'Fire Resistant', 'Mill Test Certificate']
  },
  {
    number: '02',
    name: 'Primary TMT Sariya',
    gauge: 'Complete Size Range',
    summary: 'Full inventory of 8mm, 10mm, 12mm, 16mm, 20mm, 25mm, and 32mm bars for residential slabs, columns, and foundations. Verified on computerized weighbridge.',
    tag: 'FULL YARD INVENTORY',
    image: '/images/shop-front-depot.webp',
    specs: ['IS 1786 Standard', 'Rust-Protected Staging', 'Tough Bending Core', 'Computerized Kanta']
  },
  {
    number: '03',
    name: 'Annealed Binding Wire',
    gauge: '18 & 20 Gauge Bundles',
    summary: 'Soft, pliable black annealed tying wire that knots easily and securely around sariya cages without snapping during site tying.',
    tag: 'ANNEALED COILS',
    image: '/images/binding-wire-real.jpg',
    specs: ['Smooth Manual Knotting', 'Uniform Diameter', 'High Tensile Strength', '25kg & 50kg Bundles']
  },
  {
    number: '04',
    name: 'Precast Concrete Cover Blocks',
    gauge: '20mm / 25mm / 40mm / 50mm',
    summary: 'Heavy-duty precast concrete spacers to keep sariya elevated inside roof slabs, beams, and columns, protecting steel from moisture and corrosion.',
    tag: 'PRECAST SPACERS',
    image: '/images/cover-blocks-real.jpg',
    specs: ['M-35 Grade Concrete', 'Integrated Tie-Wire', 'Roof Slab & Beam Fit', 'Even Concrete Cover']
  },
  {
    number: '05',
    name: 'Building & Construction Supplies',
    gauge: 'Direct Yard Loading',
    summary: 'Direct sourcing of UltraTech cement, wire mesh, and essential civil construction accessories with prompt loading at our 200 Feet Road depot.',
    tag: '200 FT RD DEPOT',
    image: '/images/shop-front-depot.webp',
    specs: ['Mandi Wholesale Rates', 'Single-Point Sourcing', 'Trolley & Truck Loading', 'Prompt Site Delivery']
  }
];
---

<section id="product-catalog-gallery" class="relative bg-cream py-24 md:py-32 overflow-hidden border-b border-cream-border snap-section-opener">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    
    <!-- Bold Oversized Section Opener -->
    <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <div class="snap-label flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-camel inline-block"></span>
          <span class="inline-block px-2.5 py-1 bg-eucalyptus text-cream font-mono text-[10px] tracking-[0.25em] uppercase font-bold border border-eucalyptus">
            Yard Inventory Catalog
          </span>
        </div>
        <h2 class="snap-title font-display text-[clamp(2.5rem,5.5vw,5rem)] font-black uppercase tracking-tight text-charcoal leading-[0.94]">
          Physical Inventory &bull; <br />
          <span class="text-charcoal-muted">Bhilwara Ready Stock</span>
        </h2>
      </div>

      <div class="font-mono text-xs text-charcoal-muted snap-item">
        <span class="tracking-widest uppercase">05 CORE STRUCTURAL CATEGORIES // IMMEDIATE DISPATCH</span>
      </div>
    </div>

    <!-- Responsive Editorial Grid (Natural Scrolling, Snappy Entrance) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {exhibits.map((item) => (
        <div class="snap-item border border-cream-border bg-white text-charcoal flex flex-col justify-between group overflow-hidden hover:border-camel transition-colors">
          
          <!-- Image Header with Clean Real Photography -->
          <div class="relative aspect-[16/10] overflow-hidden border-b border-cream-border bg-cream-warm">
            <img
              src={item.image}
              alt={item.name}
              width="800"
              height="500"
              loading="lazy"
              class="w-full h-full object-cover"
            />
            <div class="absolute top-3 left-3 bg-charcoal text-cream px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider font-bold">
              <span class="w-1.5 h-1.5 bg-camel inline-block mr-1"></span>
              {item.tag}
            </div>
            <div class="absolute bottom-3 right-3 bg-white text-charcoal border border-cream-border px-2 py-0.5 text-[11px] font-mono font-bold">
              {item.number} / 05
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 md:p-8 flex flex-col justify-between flex-grow">
            <div>
              <span class="font-mono text-xs text-camel font-bold tracking-wider block mb-2">
                {item.gauge}
              </span>
              <h3 class="font-display text-xl sm:text-2xl font-black uppercase tracking-tight text-charcoal mb-3 group-hover:text-camel transition-colors">
                {item.name}
              </h3>
              <p class="font-body text-xs sm:text-sm text-charcoal-muted leading-relaxed mb-6">
                {item.summary}
              </p>
            </div>

            <!-- Bulleted Trade Specifications -->
            <div class="space-y-2 border-t border-cream-border pt-4">
              <span class="font-mono text-[10px] uppercase tracking-widest text-charcoal font-bold block mb-1">Trade Specifications</span>
              <div class="grid grid-cols-2 gap-2 text-[11px] font-mono text-charcoal-muted">
                {item.specs.map((spec) => (
                  <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 bg-camel shrink-0"></span>
                    <span class="truncate">{spec}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Bottom Action Strip -->
          <div class="p-4 bg-cream-warm/60 border-t border-cream-border flex items-center justify-between">
            <a
              href="/products"
              class="font-mono text-xs uppercase tracking-wider text-charcoal hover:text-camel inline-flex items-center gap-1.5 font-bold"
            >
              <span>View Specs</span>
              <span>&rarr;</span>
            </a>
            <span class="font-mono text-[10px] text-charcoal-muted tracking-widest uppercase">READY IN YARD</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
