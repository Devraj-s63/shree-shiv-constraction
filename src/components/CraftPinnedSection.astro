---
// CraftPinnedSection.astro - Pinned editorial section where steel imagery cross-fades as text scrolls
const steps = [
  {
    step: '01',
    heading: 'Asli Factory-Tested Fe 550D Sariya',
    description: 'Every bar is genuine Kay2 Xenox Fe 550D rolled from primary billets, never secondary scrap. It bends cleanly on site without cracking and gives your roof and columns superior earthquake resistance.',
    spec: 'ISI Mark IS 1786 • High Bending Flexibility • Mill Test Report',
    image: '/images/hero-steel-poster.webp',
    imageAlt: 'Certified Fe 550D TMT sariya in Bhilwara yard',
    badge: '100% GENUINE STEEL'
  },
  {
    step: '02',
    heading: 'Deep Cross-Rib Grip for Cement Bonding',
    description: 'Sharp, pronounced X-ribs bite deep into the cement concrete mortar. In roof slabs (chhat), foundation footings, and load-bearing pillars, the steel and concrete hold tight with zero bar slippage.',
    spec: 'Advanced X-Rib Pattern • 200% Stronger Concrete Anchor',
    image: '/images/steel-yard-stock.webp',
    imageAlt: 'Organized bundles of ribbed TMT steel bars stacked in yard',
    badge: 'STRONG CONCRETE GRIP'
  },
  {
    step: '03',
    heading: 'Computerized Kanta & Pakka GST Bill',
    description: 'Every rod is weighed right in front of you on our computerized weighbridge. Exact quintals and kilos with zero shortage, accompanied by a verified GST invoice and transparent mandi rates.',
    spec: 'Computerized Weighbridge Slip • Official GST Invoice',
    image: '/images/shop-front-depot.webp',
    imageAlt: 'Retail order desk and dispatch depot in Bhilwara',
    badge: 'HONEST WEIGHMENT'
  }
];
---

<section id="craft-pinned-section" class="relative bg-canvasMuted text-white hairline-b overflow-hidden py-24 md:py-36">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    
    <!-- Section Eyebrow -->
    <div class="mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 bg-safety-amber inline-block"></span>
        <span class="micro-label text-steel-gray">
          Honest Yard Standards
        </span>
      </div>
      <h2 class="font-display text-[clamp(2.5rem,6vw,5rem)] font-black uppercase tracking-tight text-white leading-[1.02] max-w-4xl">
        Why Builders in Bhilwara <br />
        <span class="text-safety-amber">Trust Our Steel For Generations</span>
      </h2>
    </div>

    <!-- Pinned Content Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Scrolling Editorial Text Blocks (6 cols) -->
      <div class="lg:col-span-6 space-y-28 md:space-y-40 craft-text-container py-8">
        {steps.map((item, index) => (
          <div class="craft-text-step" data-step-index={index}>
            <div class="inline-flex items-center gap-3 hairline-b pb-4 mb-6 w-full">
              <span class="micro-label text-safety-amber font-bold">
                GUARANTEE 0{item.step}
              </span>
              <span class="text-white/40">&bull;</span>
              <span class="font-mono text-xs uppercase tracking-wider text-steel-gray-light">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-white mb-4 leading-snug">
              {item.heading}
            </h3>

            <p class="font-body text-base text-steel-gray-light leading-relaxed mb-6 font-normal">
              {item.description}
            </p>

            <div class="p-4 bg-canvas border border-white/10 text-xs font-mono text-safety-amber flex items-center gap-3">
              <span class="w-2 h-2 bg-safety-amber shrink-0"></span>
              <span class="text-white">{item.spec}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: Pinned Sticky Visual Screen with Cross-Fading Images (6 cols) -->
      <div class="lg:col-span-6 lg:sticky lg:top-28 craft-image-pin-wrapper">
        <div class="relative w-full aspect-[4/3] sm:aspect-[16/10] border-2 border-steel-blue overflow-hidden bg-black shadow-2xl">
          
          <!-- Image Layer Stack -->
          {steps.map((item, index) => (
            <div
              class={`craft-image-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
              data-image-index={index}
            >
              <img
                src={item.image}
                alt={item.imageAlt}
                width="1400"
                height="900"
                loading="lazy"
                class="w-full h-full object-cover filter contrast-[1.08] brightness-[0.9]"
              />
              <!-- Dark gradient vignette overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-steel-blue-dark/90 via-transparent to-transparent"></div>
              
              <!-- Bottom caption strip -->
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-[11px] font-mono text-canvas/80 bg-steel-blue-dark/85 backdrop-blur-sm p-3 border border-steel-gray/40">
                <span class="text-safety-amber font-bold uppercase">{item.badge}</span>
                <span>{item.step} / 03</span>
              </div>
            </div>
          ))}

          <!-- Industrial Framing HUD Crosshairs -->
          <div class="absolute top-3 left-3 w-3 h-3 border-t-2 border-l-2 border-safety-amber z-20 pointer-events-none"></div>
          <div class="absolute top-3 right-3 w-3 h-3 border-t-2 border-r-2 border-safety-amber z-20 pointer-events-none"></div>
          <div class="absolute bottom-3 left-3 w-3 h-3 border-b-2 border-l-2 border-safety-amber z-20 pointer-events-none"></div>
          <div class="absolute bottom-3 right-3 w-3 h-3 border-b-2 border-r-2 border-safety-amber z-20 pointer-events-none"></div>
        </div>
      </div>

    </div>

  </div>
</section>
