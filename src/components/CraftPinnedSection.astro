---
// CraftPinnedSection.astro - Clean editorial 3-step yard quality story in crisp white band
const steps = [
  {
    step: '01',
    heading: 'Asli Factory-Tested Fe 550D Sariya',
    description: 'Every bar is genuine Kay2 Xenox Fe 550D rolled from primary billets, never secondary scrap. It bends cleanly on site without cracking and gives your roof and columns dependable earthquake resistance.',
    spec: 'ISI Mark IS 1786 • Primary Billet Steel • Mill Test Report',
    image: '/images/yard-tmt-stock.webp',
    imageAlt: 'TMT sariya stock bundles at Shree Shiv yard, Bhilwara',
    badge: '100% GENUINE STEEL'
  },
  {
    step: '02',
    heading: 'Clear X-Ribs for Strong Concrete Grip',
    description: 'Prominent cross-ribs provide solid mechanical bonding with cement concrete. In roof slabs (chhat), foundation footings, and load-bearing pillars, the steel and concrete bond firmly together.',
    spec: 'IS 1786 Rib Standard • High Bond Strength',
    image: '/images/tmt-kay2xenox-closeup.webp',
    imageAlt: 'Kay2 Xenox Fe 550D TMT bars at Shree Shiv Construction & Steel, Bhilwara',
    badge: 'STRONG CONCRETE GRIP'
  },
  {
    step: '03',
    heading: 'Computerized Kanta & Pakka GST Bill',
    description: 'Every rod is weighed right in front of you on our computerized weighbridge. Exact quintals and kilos with zero shortage, accompanied by a verified GST invoice and transparent mandi rates.',
    spec: 'Computerized Weighbridge Slip • Official GST Invoice',
    image: '/images/shop-front.webp',
    imageAlt: 'Shree Shiv Construction & Steel shop front, 200 Feet Road, Bhilwara',
    badge: 'HONEST WEIGHMENT'
  }
];
---

<section id="yard-standards-section" class="relative bg-white text-charcoal border-b border-cream-border overflow-hidden py-24 md:py-32 snap-section-opener">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    
    <!-- Bold Oversized Section Opener -->
    <div class="mb-16 md:mb-20 max-w-4xl">
      <div class="snap-label flex items-center gap-2 mb-4">
        <span class="w-2 h-2 bg-camel inline-block"></span>
        <span class="inline-block px-2.5 py-1 bg-eucalyptus text-cream font-mono text-[10px] tracking-[0.25em] uppercase font-bold border border-eucalyptus">
          Honest Yard Standards
        </span>
      </div>
      <h2 class="snap-title font-display text-[clamp(2.5rem,5.5vw,5rem)] font-black uppercase tracking-tight text-charcoal leading-[0.94]">
        How We Handle Steel <br />
        <span class="text-charcoal-muted">At Our Bhilwara Depot</span>
      </h2>
    </div>

    <!-- 3-Column Editorial Grid (Natural Scrolling, Snappy Entrance) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      {steps.map((item) => (
        <div class="snap-item border border-cream-border bg-cream flex flex-col justify-between overflow-hidden group">
          <!-- Card Image Header -->
          <div class="relative aspect-[16/10] overflow-hidden bg-cream-warm border-b border-cream-border">
            <img
              src={item.image}
              alt={item.imageAlt}
              width="800"
              height="500"
              loading="lazy"
              class="w-full h-full object-cover"
            />
            <div class="absolute top-3 left-3 bg-charcoal text-cream px-2.5 py-1 font-mono text-[10px] tracking-wider uppercase font-bold">
              {item.badge}
            </div>
            <div class="absolute bottom-3 right-3 bg-white text-charcoal border border-cream-border px-2.5 py-0.5 font-mono text-xs font-bold">
              STEP {item.step}
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 md:p-8 flex flex-col justify-between flex-grow">
            <div>
              <h3 class="font-display text-xl md:text-2xl font-black uppercase tracking-tight text-charcoal mb-3">
                {item.heading}
              </h3>

              <p class="font-body text-sm text-charcoal-muted leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <div class="pt-4 border-t border-cream-border text-xs font-mono text-charcoal flex items-center gap-2 bg-cream-warm/40 -mx-6 -mb-6 md:-mx-8 md:-mb-8 p-4">
              <span class="w-2 h-2 bg-camel shrink-0"></span>
              <span class="font-semibold">{item.spec}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
