---
interface Props {
  eyebrow?: string;
  title: string;
  titleLang?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  titleLang,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`mb-12 md:mb-16 max-w-4xl ${alignClass} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 mb-3">
      <span class="inline-block px-2.5 py-1 bg-eucalyptus text-cream micro-label font-bold border border-eucalyptus">
        {eyebrow}
      </span>
    </div>
  )}
  <h2 lang={titleLang} class="font-display text-[clamp(2.2rem,4.5vw,4.2rem)] font-black uppercase tracking-tight text-charcoal leading-[1.02]">
    {title}
  </h2>
  {subtitle && (
    <p class="font-body text-sm md:text-base text-charcoal-muted mt-4 leading-relaxed max-w-2xl">
      {subtitle}
    </p>
  )}
</div>
