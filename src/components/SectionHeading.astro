---
interface Props {
  eyebrow?: string;
  title: string;
  titleLang?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  titleLang,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
const titleFont = titleLang === 'hi' ? 'font-hindi font-normal' : 'font-serif font-normal';
---

<div class={`mb-12 md:mb-16 max-w-5xl flex flex-col ${alignClass} ${className}`}>
  {eyebrow && (
    <div class="flex items-center gap-2.5 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-camel inline-block"></span>
      <span class="inline-block px-3 py-1 bg-eucalyptus text-cream font-mono text-[10px] tracking-[0.25em] uppercase font-bold rounded-full">
        {eyebrow}
      </span>
    </div>
  )}
  <h2 lang={titleLang} class={`${titleFont} text-[clamp(2.4rem,5.5vw,4.8rem)] text-charcoal leading-[0.96] tracking-tight`}>
    {title}
  </h2>
  {subtitle && (
    <p class="font-body text-sm md:text-base text-charcoal-muted mt-5 leading-relaxed max-w-2xl border-l-2 border-camel pl-4">
      {subtitle}
    </p>
  )}
</div>
