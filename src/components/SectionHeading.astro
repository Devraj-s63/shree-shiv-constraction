---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`mb-8 md:mb-12 max-w-3xl ${alignClass} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 mb-3">
      <span class="w-2 h-2 bg-safety-amber inline-block"></span>
      <span class="font-display text-[11px] md:text-xs font-bold uppercase tracking-widest text-steel-gray">
        {eyebrow}
      </span>
    </div>
  )}
  <h2 class="font-display text-2xl md:text-4xl lg:text-5xl font-black uppercase tracking-tight text-steel-blue leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="font-body text-sm md:text-base text-steel-gray mt-3 leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
