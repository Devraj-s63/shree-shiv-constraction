---
// BlueprintBackground.astro - Faint charcoal technical line art etched at the edges
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  <!-- Left Edge Blueprint Schematic: Rebar Cross-Section & Yard Coordinates -->
  <div class="blueprint-drift-left absolute -left-12 sm:left-0 top-16 md:top-24 w-72 sm:w-96 md:w-[440px] opacity-[0.09] transition-transform">
    <svg viewBox="0 0 400 650" class="w-full h-auto text-charcoal stroke-current fill-none stroke-[0.75]">
      <!-- Technical Grid Lines -->
      <line x1="20" y1="20" x2="380" y2="20" stroke-dasharray="4 4" />
      <line x1="20" y1="20" x2="20" y2="630" stroke-dasharray="4 4" />
      <line x1="20" y1="630" x2="380" y2="630" stroke-dasharray="4 4" />

      <!-- Rebar Cross Section Drawing (Concentric cores, rib projections) -->
      <g transform="translate(180, 220)">
        <!-- Outer Rib Envelope -->
        <circle cx="0" cy="0" r="110" stroke-dasharray="6 3" />
        <!-- Core Bar Circumference -->
        <circle cx="0" cy="0" r="95" stroke-width="1.2" />
        <!-- Ductile Ferrite-Pearlite Core -->
        <circle cx="0" cy="0" r="68" stroke-dasharray="2 2" />
        
        <!-- Transverse Deformation Ribs (Radial tick marks) -->
        <line x1="-108" y1="-30" x2="-95" y2="-26" stroke-width="1.5" />
        <line x1="-108" y1="0" x2="-95" y2="0" stroke-width="1.5" />
        <line x1="-108" y1="30" x2="-95" y2="26" stroke-width="1.5" />
        <line x1="108" y1="-30" x2="95" y2="-26" stroke-width="1.5" />
        <line x1="108" y1="0" x2="95" y2="0" stroke-width="1.5" />
        <line x1="108" y1="30" x2="95" y2="26" stroke-width="1.5" />

        <!-- Crosshair Center Mark -->
        <line x1="-12" y1="0" x2="12" y2="0" stroke-width="1" />
        <line x1="0" y1="-12" x2="0" y2="12" stroke-width="1" />
        <circle cx="0" cy="0" r="2" fill="currentColor" />

        <!-- Dimension Callout Leader Line -->
        <polyline points="70,-70 120,-110 170,-110" stroke-width="0.8" />
        <text x="125" y="-115" font-family="monospace" font-size="9" fill="currentColor" letter-spacing="1">Ø 16mm Fe 550D</text>
      </g>

      <!-- Dimension Arrows & Ticks -->
      <line x1="60" y1="370" x2="300" y2="370" stroke-width="0.8" />
      <line x1="60" y1="362" x2="60" y2="378" stroke-width="1" />
      <line x1="300" y1="362" x2="300" y2="378" stroke-width="1" />
      <text x="135" y="365" font-family="monospace" font-size="8" fill="currentColor" letter-spacing="1.5">NOMINAL BORE 16.0mm</text>

      <!-- Technical Drawing Notes in Small Caps -->
      <g transform="translate(35, 430)" font-family="monospace" font-size="8.5" fill="currentColor" letter-spacing="1.2">
        <text y="0">REF: IS:1786 REBAR COMPLIANCE</text>
        <text y="18">GRADE: KAY2 XENOX Fe 550D</text>
        <text y="36">MIN ELONGATION: 14.5%</text>
        <text y="54">YIELD STRESS: 550 N/mm²</text>
        <text y="80">COORD: 25.3622° N, 74.6028° E</text>
        <text y="98">DEPOT: 200 FEET RD, BHILWARA</text>
        <text y="124">LAYOUT: BAY-01 // COMMERCIAL GANTRY</text>
      </g>

      <!-- Corner Registration Marks -->
      <path d="M10,35 L10,10 L35,10" stroke-width="1" />
      <path d="M10,615 L10,640 L35,640" stroke-width="1" />
    </svg>
  </div>

  <!-- Right Edge Blueprint Schematic: Structural Beam Elevation & Shear Stirrup Schematics -->
  <div class="blueprint-drift-right absolute -right-12 sm:right-0 top-36 md:top-48 w-72 sm:w-96 md:w-[460px] opacity-[0.09] transition-transform">
    <svg viewBox="0 0 420 700" class="w-full h-auto text-charcoal stroke-current fill-none stroke-[0.75]">
      <!-- Coordinate Axis & Grid Lines -->
      <line x1="40" y1="40" x2="390" y2="40" stroke-dasharray="4 4" />
      <line x1="390" y1="40" x2="390" y2="660" stroke-dasharray="4 4" />
      <line x1="40" y1="660" x2="390" y2="660" stroke-dasharray="4 4" />

      <!-- Structural Beam Elevation Diagram -->
      <g transform="translate(60, 90)">
        <!-- Concrete Beam Boundary -->
        <rect x="0" y="0" width="310" height="150" stroke-width="1" />
        
        <!-- Top Hanger Bars with 90° hooks -->
        <polyline points="20,40 290,40 290,65" stroke-width="1.2" />
        
        <!-- Bottom Tensile Reinforcement with 90° hooks -->
        <polyline points="20,110 290,110 290,85" stroke-width="1.6" />
        <line x1="20" y1="122" x2="290" y2="122" stroke-width="1.6" />

        <!-- Shear Stirrup Ties (@ spacing intervals) -->
        <line x1="40" y1="25" x2="40" y2="135" stroke-width="1" />
        <line x1="75" y1="25" x2="75" y2="135" stroke-width="1" />
        <line x1="110" y1="25" x2="110" y2="135" stroke-width="1" />
        <line x1="155" y1="25" x2="155" y2="135" stroke-width="1" />
        <line x1="200" y1="25" x2="200" y2="135" stroke-width="1" />
        <line x1="245" y1="25" x2="245" y2="135" stroke-width="1" />
        <line x1="280" y1="25" x2="280" y2="135" stroke-width="1" />

        <!-- Neutral Axis Line -->
        <line x1="0" y1="75" x2="310" y2="75" stroke-dasharray="6 3" stroke-width="0.8" />
        <text x="315" y="78" font-family="monospace" font-size="7.5" fill="currentColor">N.A.</text>

        <!-- Dimension Leader for Stirrup Spacing -->
        <line x1="40" y1="165" x2="110" y2="165" stroke-width="0.8" />
        <line x1="40" y1="158" x2="40" y2="172" stroke-width="1" />
        <line x1="110" y1="158" x2="110" y2="172" stroke-width="1" />
        <text x="45" y="177" font-family="monospace" font-size="7" fill="currentColor">STIRRUPS @ 100 c/c</text>
      </g>

      <!-- Technical Crosshairs & Survey Marks -->
      <g transform="translate(200, 340)">
        <circle cx="0" cy="0" r="45" stroke-dasharray="2 2" />
        <line x1="-60" y1="0" x2="60" y2="0" stroke-width="0.8" />
        <line x1="0" y1="-60" x2="0" y2="60" stroke-width="0.8" />
        <text x="10" y="-10" font-family="monospace" font-size="8" fill="currentColor">SEC B-B</text>
      </g>

      <!-- Blueprints Engineering Annotations -->
      <g transform="translate(60, 440)" font-family="monospace" font-size="8.5" fill="currentColor" letter-spacing="1.2">
        <text y="0">ELEVATION: RC BEAM CONTINUITY</text>
        <text y="18">LAP LENGTH: 50d STAGGERED</text>
        <text y="36">CONCRETE COVER: 25mm PRECAST BLOCKS</text>
        <text y="54">TYING SPEC: 18G ANNEALED WIRE</text>
        <text y="80">SHREE SHIV TECHNICAL DIVISION</text>
        <text y="98">DRAWING NO: SSCS-BHIL-2026</text>
        <text y="124">SCALE: 1:20 // VERIFIED ON SITE</text>
      </g>

      <!-- Corner Registration Marks -->
      <path d="M375,15 L400,15 L400,40" stroke-width="1" />
      <path d="M375,670 L400,670 L400,645" stroke-width="1" />
    </svg>
  </div>
</div>
