---
interface Props {
  variant?: 'amber' | 'steel' | 'neutral' | 'success';
  class?: string;
}

const {
  variant = 'steel',
  class: className = '',
} = Astro.props;

const baseStyles = 'inline-flex items-center text-[10px] md:text-xs font-display uppercase tracking-widest font-bold px-2.5 py-1 border select-none';

const variantStyles: Record<string, string> = {
  amber: 'bg-safety-amber/10 text-safety-amber-dark border-safety-amber/40',
  steel: 'bg-steel-blue/10 text-steel-blue border-steel-blue/30',
  neutral: 'bg-steel-gray/10 text-steel-gray border-steel-gray/30',
  success: 'bg-emerald-900/10 text-emerald-800 border-emerald-700/30',
};

const computedClass = `${baseStyles} ${variantStyles[variant] || variantStyles.steel} ${className}`;
---

<span class={computedClass}>
  <slot />
</span>
