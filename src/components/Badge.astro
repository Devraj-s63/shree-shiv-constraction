---
interface Props {
  variant?: 'eucalyptus' | 'camel' | 'neutral' | 'steel' | 'amber';
  class?: string;
}

const {
  variant = 'eucalyptus',
  class: className = '',
} = Astro.props;

const baseStyles = 'inline-flex items-center text-[10px] md:text-xs font-display uppercase tracking-widest font-bold px-2.5 py-1 border select-none';

const variantStyles: Record<string, string> = {
  // Primary default: Eucalyptus Green with Cream text (WCAG AA compliant 6.9:1)
  eucalyptus: 'bg-eucalyptus text-cream border-eucalyptus',
  steel: 'bg-eucalyptus text-cream border-eucalyptus',
  amber: 'bg-camel/20 text-charcoal border-camel',
  camel: 'bg-camel text-charcoal border-camel',
  neutral: 'bg-cream-warm text-charcoal-muted border-cream-border',
};

const computedClass = `${baseStyles} ${variantStyles[variant] || variantStyles.eucalyptus} ${className}`;
---

<span class={computedClass}>
  <slot />
</span>
